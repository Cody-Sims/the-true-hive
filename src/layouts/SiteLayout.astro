---
import "../styles/site.css";
import BrandMark from "../components/BrandMark.astro";
import favicon from "../assets/favicon.svg?url";
import shareImage from "../assets/social-card.png?url";
import { readConfig } from "../server/config.ts";
import { getCheckoutPresentation } from "../server/commerce/config.ts";

interface Props {
  title: string;
  description: string;
  path?: string;
  notFound?: boolean;
}
const {
  title,
  description,
  path = Astro.url.pathname,
  notFound = false,
} = Astro.props;
const config = readConfig();
const testCheckoutEnabled = getCheckoutPresentation().enabled;
const cartPage = path === "/cart" || path === "/cart/";
const shoppingPage =
  path === "/" ||
  path === "/goods" ||
  path.startsWith("/goods/") ||
  cartPage ||
  path.startsWith("/checkout/");
const isErrorDocument = notFound || (Astro.response.status ?? 200) >= 400;
const isSearchResults =
  (Astro.url.pathname === "/goods" || Astro.url.pathname === "/goods/") &&
  Astro.url.searchParams.has("q");
const omitCanonical = isErrorDocument || isSearchResults || cartPage;
const canonicalUrl = new URL(config.siteOrigin);
canonicalUrl.pathname = new URL(path, config.siteOrigin).pathname;
const canonical = canonicalUrl.href;
const shareImageUrl = new URL(shareImage, config.siteOrigin).href;
const shareImageAlt =
  "The True Hive - original illustrated brand card for Madisonville, Tennessee.";
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "The True Hive",
  url: config.siteOrigin,
  ...(config.contact.phone ? { telephone: config.contact.phone } : {}),
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | The True Hive</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        config.indexable && !omitCanonical ? "index, follow" : "noindex, follow"
      }
    />
    {!omitCanonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:title" content={`${title} | The True Hive`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The True Hive" />
    {!omitCanonical && <meta property="og:url" content={canonical} />}
    {!omitCanonical && (
      <>
        <meta property="og:image" content={shareImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`${title} | The True Hive`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImageUrl} />
        <meta name="twitter:image:alt" content={shareImageAlt} />
      </>
    )}
    <script
      is:inline
      type="application/ld+json"
      nonce={Astro.locals.nonce}
      set:html={schema}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {shoppingPage && (
      <aside class="opening-note" aria-label="Shopping information">
        <div class="wrap">
          <span>Beekeeping in East Tennessee.</span>
          <span>
            {testCheckoutEnabled
              ? "TEST MODE — no real charge. Online ordering isn't open yet."
              : "Online ordering isn't open yet."}
          </span>
        </div>
      </aside>
    )}
    <div class="site-header-frame">
      <header class="site-header wrap">
        <a class="brand" href="/">
          <span class="market-mark">
            <BrandMark />
          </span>
          <span class="brand-name">
            THE TRUE HIVE<small>Madisonville, Tennessee</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a
            href="/goods"
            aria-current={
              path === "/goods" || path.startsWith("/goods/")
                ? "page"
                : undefined
            }
          >
            The goods
          </a>
          <a href="/#pickup">Local pickup</a>
          <a
            href="/services"
            aria-current={path === "/services" ? "page" : undefined}
          >
            Beekeeping
          </a>
          <a
            href="/about"
            aria-current={path === "/about" ? "page" : undefined}
          >
            About us
          </a>
          <a href="/cart" aria-current={cartPage ? "page" : undefined}>
            Cart<span data-cart-count></span>
          </a>
          <a class="nav-connect" href="/#connect">
            Connect <span aria-hidden="true">&nearr;</span>
          </a>
        </nav>
      </header>
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <p class="eyebrow">The True Hive</p>
          <strong>
            A slower rhythm.
            <br />A local beginning.
          </strong>
          <p class="fine-print">Madisonville, Tennessee</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/">Home</a>
          <a href="/goods">The collection</a>
          <a href="/#pickup">Local pickup</a>
          <a href="/about">About us</a>
          <a href="/services">Beekeeping</a>
          <a href="/#connect">Contact channels</a>
          <a href="/privacy">Privacy</a>
          <a href="/accessibility">Accessibility</a>
        </nav>
      </div>
      <div class="wrap footer-colophon">
        <span>Local care. A lasting connection.</span>
        {shoppingPage && <span>Online ordering is not open yet.</span>}
      </div>
    </footer>
    <script>
      import "../client/cart.ts";
    </script>
  </body>
</html>
