---
import "../styles/site.css";
import "../styles/golden.css";
import favicon from "../assets/favicon.svg?url";
import shareImage from "../assets/social-card.png?url";
import { readConfig } from "../server/config.ts";
import { getCheckoutPresentation } from "../server/commerce/config.ts";
import { pickupLocations } from "../content/pickup.ts";

interface Props {
  title: string;
  description: string;
  path?: string;
  notFound?: boolean;
  noIndex?: boolean;
}
const {
  title,
  description,
  path = Astro.url.pathname,
  notFound = false,
  noIndex = false,
} = Astro.props;
const config = readConfig();
const admin = Astro.locals.admin;
if (admin) {
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("Vary", "Cookie");
}
const cartPage = path === "/cart" || path === "/cart/";
const storePage =
  path === "/goods" ||
  path.startsWith("/goods/") ||
  cartPage ||
  path.startsWith("/checkout/");
const shoppingPage = path === "/" || storePage;
const testCheckout = getCheckoutPresentation().enabled;
const isErrorDocument = notFound || (Astro.response.status ?? 200) >= 400;
const isSearchResults =
  (Astro.url.pathname === "/goods" || Astro.url.pathname === "/goods/") &&
  Astro.url.searchParams.has("q");
const omitCanonical = isErrorDocument || isSearchResults || cartPage || noIndex;
const canonicalUrl = new URL(config.siteOrigin);
canonicalUrl.pathname = new URL(path, config.siteOrigin).pathname;
const canonical = canonicalUrl.href;
const shareImageUrl = new URL(shareImage, config.siteOrigin).href;
const shareImageAlt =
  "The True Hive - original illustrated brand card for Madisonville, Tennessee.";
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "The True Hive",
  url: config.siteOrigin,
  ...(config.contact.phone ? { telephone: config.contact.phone } : {}),
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en" data-site-design="golden-apothecary" data-color-mode="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | The True Hive</title>
    <meta name="description" content={description} />
    <script is:inline nonce={Astro.locals.nonce}>
      try {
        const appearance = localStorage.getItem("true-hive-appearance");
        if (appearance && ["system", "light", "dark"].includes(appearance))
          document.documentElement.dataset.colorMode = appearance;
      } catch {}
    </script>
    <meta
      name="robots"
      content={
        noIndex
          ? "noindex, nofollow"
          : config.indexable && !omitCanonical
            ? "index, follow"
            : "noindex, follow"
      }
    />
    {!omitCanonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:title" content={`${title} | The True Hive`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The True Hive" />
    {!omitCanonical && <meta property="og:url" content={canonical} />}
    {!omitCanonical && (
      <>
        <meta property="og:image" content={shareImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`${title} | The True Hive`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImageUrl} />
        <meta name="twitter:image:alt" content={shareImageAlt} />
      </>
    )}
    <script
      is:inline
      type="application/ld+json"
      nonce={Astro.locals.nonce}
      set:html={schema}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {shoppingPage && testCheckout && (
      <aside class="opening-note" aria-label="Shopping information">
        <div class="wrap">
          <span>Stripe test checkout</span>
          <span>Test store — no real payments or pickups.</span>
        </div>
      </aside>
    )}
    <aside class="fulfillment-bar" aria-label="Local fulfillment">
      <div class="wrap">
        <strong>Local Pickup Only</strong>
        <span>Madisonville &amp; Vonore, Tennessee</span>
      </div>
    </aside>
    <div class="site-header-frame golden-shell" data-public-header>
      <header class="site-header wrap">
        <a class="brand" href="/">
          <span class="market-mark" aria-hidden="true">
            TH
          </span>
          <span class="brand-name">
            THE TRUE HIVE<small>Madisonville, Tennessee</small>
          </span>
        </a>
        <button
          type="button"
          class="site-menu-toggle"
          data-site-menu
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="site-header-panel"
          hidden
        >
          <span class="site-menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
        <div id="site-header-panel" class="site-header-panel">
          <nav class="site-nav" aria-label="Main navigation">
            <a href="/" aria-current={path === "/" ? "page" : undefined}>
              Home
            </a>
            <a href="/goods" aria-current={storePage ? "page" : undefined}>
              Shop Soaps
            </a>
            <a
              href="/services"
              aria-current={path === "/services" ? "page" : undefined}
            >
              Bee Services
            </a>
            <a
              href="/about"
              aria-current={path === "/about" ? "page" : undefined}
            >
              Our Story
            </a>
            <a
              href="/contact"
              aria-current={path === "/contact" ? "page" : undefined}
            >
              Contact
            </a>
          </nav>
          <div class="site-header-controls">
            <button
              type="button"
              class="site-appearance"
              data-site-appearance
              title="Change color appearance"
              hidden
            >
              <svg
                class="appearance-icon"
                data-appearance-icon="sun"
                viewBox="0 0 20 20"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                aria-hidden="true"
                focusable="false"
              >
                <circle cx="10" cy="10" r="3.5" />
                <path d="M10 1v2m0 14v2M1 10h2m14 0h2M3.6 3.6 5 5m10 10 1.4 1.4M3.6 16.4 5 15M15 5l1.4-1.4" />
              </svg>
              <svg
                class="appearance-icon"
                data-appearance-icon="moon"
                viewBox="0 0 20 20"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M17.2 11.4A7.5 7.5 0 0 1 8.6 2.8a7.5 7.5 0 1 0 8.6 8.6Z" />
              </svg>
              <span data-appearance-label>Appearance: Auto</span>
            </button>
            {config.contact.phoneHref && (
              <a class="header-call" href={config.contact.phoneHref}>
                Call {config.contact.phone}
              </a>
            )}
          </div>
        </div>
        <a class="header-cart" href="/cart">
          Cart<span data-cart-count></span>
        </a>
      </header>
      {admin && (
        <nav class="workspace-nav wrap" aria-label="Administrator navigation">
          <span class="workspace-nav-label">Private workspace</span>
          <div class="workspace-nav-links">
            <a class="workspace-nav-primary" href="/inventory/products">
              Inventory
            </a>
            <a href="/team-sprint">Team board</a>
            <a href="/prototypes/">Studio</a>
            <a href="/prototypes/plan.html">Planning</a>
          </div>
        </nav>
      )}
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <strong>The True Hive</strong>
          <p>
            Small-batch soaps, $0 honeybee colony rescue, and farm pollination
            in Madisonville, Tennessee.
          </p>
          <a href={config.contact.phoneHref}>{config.contact.phone}</a>
        </div>
        <div class="footer-group">
          <h2>Shop</h2>
          <a href="/goods">All Goods</a>
          <a href="/goods/coconut-milk-delight">Coconut Milk Delight</a>
          <a href="/goods/the-true-soap">The True Soap</a>
          <a href="/cart#pickup">Cart &amp; Pickup</a>
        </div>
        <div class="footer-group">
          <h2>Beekeeping</h2>
          <a href="/services#colony-removal">No-Cost Colony Rescue</a>
          <a href="/services#farm-pollination">Farm Pollination</a>
          <a href="/about">Our Story</a>
          <a href="/contact">Contact</a>
        </div>
        <div class="footer-group">
          <h2>US-411 Pickup Spots</h2>
          {pickupLocations.map((location) => (
            <p>
              <strong>{location.name}</strong>
              <small>
                {location.street}, {location.city}
              </small>
            </p>
          ))}
        </div>
      </div>
      <div class="wrap footer-colophon">
        <span>The True Hive &middot; Madisonville, Tennessee</span>
        <nav aria-label="Footer navigation">
          <a
            href="/contact"
            aria-current={path === "/contact" ? "page" : undefined}
          >
            Contact us
          </a>
          <a
            href="/privacy"
            aria-current={path === "/privacy" ? "page" : undefined}
          >
            Privacy
          </a>
          <a
            href="/accessibility"
            aria-current={path === "/accessibility" ? "page" : undefined}
          >
            Accessibility
          </a>
        </nav>
      </div>
    </footer>
    <script>
      import "../client/cart.ts";
      import "../client/inquiry.ts";
      import "../client/product-gallery.ts";
      import "../client/site-header.ts";
      import "../client/product-card.ts";
      import "../client/bee-helper.ts";
    </script>
  </body>
</html>
