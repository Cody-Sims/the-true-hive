---
import "../styles/admin.css";
import InventoryNavbar from "../components/admin/InventoryNavbar.astro";
import AdminPageHeader from "../components/admin/AdminPageHeader.astro";
interface Props {
  title: string;
  publicShell?: boolean;
  compact?: boolean;
}
const { title, publicShell = false, compact = false } = Astro.props;
const admin = Astro.locals.admin;
if (!publicShell && (!admin || !Astro.locals.csrfToken)) {
  throw new Error("Verified inventory session required.");
}
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content={Astro.locals.csrfToken} />
    <title>{title} | True Hive inventory</title>
  </head>
  <body class:list={{ "admin-inventory": compact }}>
    <a class="admin-skip" href="#main">
      Skip to inventory
    </a>
    <InventoryNavbar path={path} admin={admin} publicShell={publicShell} />
    <main id="main" class="admin-wrap" tabindex="-1">
      <AdminPageHeader title={title} />
      <slot />
    </main>
    <footer class="admin-wrap admin-footer">
      Private operational records. Quantities change only after a verified
      server receipt.
    </footer>
    <script>
      import "../client/admin.ts";
      import "../client/ingredients.ts";
      import "../client/stock-controls.ts";
    </script>
  </body>
</html>
