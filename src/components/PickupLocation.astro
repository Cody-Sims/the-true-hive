---
import { pickupLocations, pickupInstructions } from "../content/pickup.ts";
---

<aside class="pickup-location" aria-label="Pickup locations">
  <p class="eyebrow">Pickup meetup points</p>
  <ul class="pickup-meetup-list" role="list">
    {pickupLocations.map((location) => (
      <li>
        <strong>{location.name}</strong>
        <address>
          {location.street}
          <br />
          {`${location.city}, ${location.region} ${location.postalCode}`}
        </address>
      </li>
    ))}
  </ul>
  <p>{pickupInstructions}</p>
</aside>

<style>
  .pickup-location {
    padding: 1.25rem;
    margin-block: 1.5rem;
    border: 1px solid currentColor;
    overflow-wrap: anywhere;
  }
  address {
    margin-block: 0.75rem;
    font-size: 1.1rem;
    font-style: normal;
    line-height: 1.7;
  }
  .pickup-meetup-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .pickup-location > p:last-child {
    max-width: 40rem;
    margin-bottom: 0;
    font-size: 0.85rem;
    line-height: 1.7;
  }
</style>
