---
import { pickupLocations, pickupInstructions } from "../content/pickup.ts";
---

<aside class="pickup-location" aria-label="Pickup locations">
  <h2>US-411 Pickup Meetup Points</h2>
  <ul class="pickup-meetup-list" role="list">
    {pickupLocations.map((location) => (
      <li>
        <strong>{location.name}</strong>
        <address>
          {location.street},{" "}
          {`${location.city}, ${location.region} ${location.postalCode}`}
        </address>
      </li>
    ))}
  </ul>
  <p>{pickupInstructions}</p>
</aside>

<style>
  .pickup-location {
    padding: 0;
    margin-block: 1.5rem;
    border: 0;
    overflow-wrap: anywhere;
  }
  address {
    margin-block: 0.2rem 0;
    font-size: 0.8rem;
    color: var(--muted);
    font-style: normal;
    line-height: 1.7;
  }
  .pickup-meetup-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .pickup-meetup-list li {
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--paper);
  }
  .pickup-location > p:last-child {
    max-width: 40rem;
    margin-bottom: 0;
    font-size: 0.8rem;
    line-height: 1.7;
  }
</style>
