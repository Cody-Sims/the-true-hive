---
import type { Product } from "../domain/catalog.ts";
import { money, pricedVariants, projectedStock } from "../domain/cart.ts";
import { getSoapReference } from "../content/soap-references.ts";
import ProductArt from "./ProductArt.astro";
interface Props {
  product: Product;
  preferredVariantKey?: string | undefined;
}
const { product, preferredVariantKey } = Astro.props;
const offered = pricedVariants(product).filter(
  (variant) =>
    !["out_of_stock", "not_offered"].includes(
      projectedStock(variant)?.state ?? "",
    ),
);
const selected =
  offered.find((variant) => variant.key === preferredVariantKey) ??
  offered[0] ??
  product.variants[0];
const reference = !product.photo
  ? getSoapReference(product.key, selected?.key)
  : null;
---

<figure data-product-gallery class="product-gallery">
  <div data-gallery-art class="gallery-art">
    <ProductArt
      image={product.imageKey}
      photo={product.photo ?? null}
      referenceKey={product.key}
      referenceVariantKey={selected?.key}
      alt={`Illustration for ${product.title}.`}
      eager
    />
  </div>
  <div class="gallery-choices" aria-label="Product images">
    {product.variants.map((variant) => (
      <>
        <button
          type="button"
          data-variant-image={variant.key}
          data-variant-note={
            !product.photo
              ? getSoapReference(product.key, variant.key)?.alt
              : undefined
          }
          aria-label={`View ${variant.label}`}
          aria-pressed={variant.key === selected?.key}
          disabled={!offered.some((entry) => entry.key === variant.key)}
        >
          <ProductArt
            image={product.imageKey}
            photo={product.photo ?? null}
            referenceKey={product.key}
            referenceVariantKey={variant.key}
            sizes="5rem"
          />
          <span>
            {variant.label}
            {variant.priceMinor !== null
              ? ` · ${money(variant.priceMinor)}`
              : ""}
          </span>
        </button>
        <template data-gallery-template={variant.key}>
          <ProductArt
            image={product.imageKey}
            photo={product.photo ?? null}
            referenceKey={product.key}
            referenceVariantKey={variant.key}
            alt={`Illustration for ${variant.label}.`}
            eager
          />
        </template>
      </>
    ))}
  </div>
  {reference && (
    <figcaption>
      <strong>Transparent Visual Note:</strong>{" "}
      <span data-gallery-note>{reference.alt}</span>
    </figcaption>
  )}
</figure>

<style>
  .product-gallery {
    position: relative;
    min-width: 0;
    margin: 0;
    align-self: start;
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--white);
  }
  .gallery-art {
    aspect-ratio: 4 / 3;
    background: var(--surface);
    overflow: hidden;
  }
  .gallery-art :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  figcaption {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
  }
  .gallery-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 1rem;
  }
  button {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    padding: 0.3rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--forest);
    cursor: pointer;
    font: inherit;
    font-size: 0.75rem;
    text-align: left;
    border-radius: 0.65rem;
  }
  button[aria-pressed="true"] {
    border-color: var(--forest);
    background: var(--surface);
  }
  button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }
  button :global(img) {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: cover;
  }
</style>
