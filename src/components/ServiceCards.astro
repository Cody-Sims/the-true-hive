---
import { readConfig } from "../server/config.ts";

interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
const { contact } = readConfig();
---

<div class="service-path-grid">
  <article id="colony-removal" class="service-path-card">
    <div class="service-path-topline">
      <p class="eyebrow">No-Cost Service / Homes &amp; properties</p>
      <span aria-hidden="true">01</span>
    </div>
    <h3>Colony Rescue</h3>
    <p>
      Do your bees need a new home? We'd love to rescue your bees and help them
      thrive. We come to you for honeybee relocation at no cost in Monroe,
      Blount, and Knox counties.
    </p>
    {detailed ? (
      <>
        <details class="service-path-details" open>
          <summary>For a colony rescue</summary>
          <ul>
            <li>
              <strong>Address:</strong> Where the hive is located.
            </li>
            <li>
              <strong>Location of hive:</strong> Where it is on the property.
            </li>
            <li>
              <strong>A good time to come:</strong> Your preferred time for a
              visit.
            </li>
          </ul>
        </details>
        <a class="text-link service-path-link" href={contact.phoneHref}>
          Call {contact.phone} <span aria-hidden="true">&rarr;</span>
        </a>
      </>
    ) : (
      <a class="text-link service-path-link" href="/services#colony-removal">
        Explore colony rescue <span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </article>
  <article id="farm-pollination" class="service-path-card">
    <div class="service-path-topline">
      <p class="eyebrow">Farms &amp; growers</p>
      <span aria-hidden="true">02</span>
    </div>
    <h3>Farm Pollination</h3>
    <p>
      Would you like to increase your crop yield? We bring our bees to you,
      helping your crops thrive as you work toward your <em>best</em> harvest
      yet.
    </p>
    <div class="pollination-evidence">
      <strong class="evidence-stat">24%</strong>
      <p>
        A{" "}
        <a href="https://doi.org/10.1126/science.aac7287">
          2016 study in <cite>Science</cite>
        </a>{" "}
        across 33 pollinator-dependent crop systems found that more visits could
        close yield gaps by a median of 24% in fields smaller than 2 hectares
        (about 5 acres). This is study evidence, not a guaranteed result for
        your farm.
      </p>
    </div>
    {detailed ? (
      <>
        <details class="service-path-details" open>
          <summary>For a pollination assessment</summary>
          <ul>
            <li>
              <strong>Farm location:</strong> Where the land is located.
            </li>
            <li>
              <strong>Crops grown on the land.</strong>
            </li>
            <li>
              <strong>Number of hives:</strong> How many you'd like to rent.
            </li>
            <li>
              <strong>Preferred inspection day:</strong> A day of the week that
              works for an on-site visit.
            </li>
          </ul>
        </details>
        <a class="text-link service-path-link" href={contact.phoneHref}>
          Discuss pollination <span aria-hidden="true">&rarr;</span>
        </a>
      </>
    ) : (
      <a class="text-link service-path-link" href="/services#farm-pollination">
        Explore farm pollination <span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </article>
</div>
<p class="fine-print service-path-safety">
  <strong>Give bees space.</strong> Do not disturb a colony or approach it for a
  photograph.
</p>

<style>
  .service-path-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .service-path-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--forest);
    background: var(--paper);
    scroll-margin-top: 2rem;
  }
  .service-path-topline {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .service-path-topline > span {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1;
  }
  .service-path-card h3 {
    margin-block: 0.75rem 1.15rem;
    font-size: 1.65rem;
    line-height: 1.1;
  }
  .service-path-card > p {
    max-width: 31rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .service-path-link {
    margin-top: auto;
  }
  .service-path-details {
    width: 100%;
    margin-bottom: 1.25rem;
    border-block: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .service-path-details summary {
    min-height: 3rem;
    padding-block: 0.85rem;
    font-weight: 700;
    line-height: 1.6;
    cursor: pointer;
  }
  .service-path-details summary:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .service-path-details summary:focus-visible {
    outline: 3px solid var(--forest);
    outline-offset: 4px;
  }
  .service-path-details ul {
    display: grid;
    gap: 0.65rem;
    padding: 0 0 1.25rem 1.25rem;
    margin: 0;
    line-height: 1.8;
  }
  .service-path-safety {
    max-width: 57rem;
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 2px solid var(--tomato);
    font-size: 0.8rem;
  }
  .pollination-evidence {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--surface);
    margin-bottom: 1.25rem;
  }
  .evidence-stat {
    font-size: 2rem;
    color: var(--tomato);
  }
  .pollination-evidence p {
    margin: 0;
    font-size: 0.82rem;
  }
  @media (max-width: 46rem) {
    .service-path-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .service-path-card {
      padding: 1.5rem;
    }
  }
</style>
