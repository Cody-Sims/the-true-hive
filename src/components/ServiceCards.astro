---
import { readConfig } from "../server/config.ts";
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
const { contact } = readConfig();
---

<div class="service-path-grid">
  <article id="colony-removal" class="service-path-card rescue-panel">
    <div class="service-path-topline">
      <span class="service-badge service-free">$0 NO-COST SERVICE</span>
      <span class="service-area">
        Monroe &middot; Blount &middot; Knox Counties
      </span>
    </div>
    <h3>Live Honeybee Colony Rescue</h3>
    <p>
      Found honeybees swarming a branch, porch, or wall? Don't call an
      exterminator. We come to you and relocate honeybee colonies alive at{" "}
      <strong>zero cost</strong> so they can keep thriving.
    </p>
    {detailed && (
      <div class="service-path-details">
        <ul aria-label="For a colony rescue">
          <li>
            <strong>Address:</strong> Where the hive is located.
          </li>
          <li>
            <strong>Location of hive:</strong> Where it is on the property.
          </li>
          <li>
            <strong>A good time to come:</strong> Your preferred time for a
            visit.
          </li>
        </ul>
      </div>
    )}
    <div class="service-actions">
      <a class="button button-primary" href={contact.phoneHref}>
        Call {contact.phone} &mdash; Free Rescue
      </a>
      {detailed ? (
        <a class="button service-secondary" href="/contact#inquiry">
          Email Draft
        </a>
      ) : (
        <a class="button service-secondary" href="/services#bee-helper">
          Bee vs. Wasp Helper &rarr;
        </a>
      )}
    </div>
  </article>
  <article id="farm-pollination" class="service-path-card">
    <div class="service-path-topline">
      <span class="service-badge">FARMS &amp; GROWERS</span>
      <span class="service-area">Peer-Reviewed Evidence</span>
    </div>
    <h3>East Tennessee Farm Pollination</h3>
    <p>
      We bring active honeybee colonies to your farm to support peak bloom
      pollination and stronger harvests.
    </p>
    <div class="pollination-evidence">
      <strong class="evidence-stat">+24%</strong>
      <p>
        <strong>Median crop yield-gap closure</strong> on fields under 5 acres
        across 33 crop systems &mdash;{" "}
        <a href="https://doi.org/10.1126/science.aac7287">
          2016 study in <cite>Science</cite>
        </a>
        .
      </p>
    </div>
    {detailed && (
      <div class="service-path-details">
        <ul aria-label="For a pollination assessment">
          <li>
            <strong>Farm location:</strong> Where the land is located.
          </li>
          <li>
            <strong>Crops grown on the land.</strong>
          </li>
          <li>
            <strong>Number of hives:</strong> How many you'd like to rent.
          </li>
          <li>
            <strong>Preferred inspection day:</strong> A day of the week that
            works for an on-site visit.
          </li>
        </ul>
      </div>
    )}
    <div class="service-actions">
      <a class="button service-farm-action" href={contact.phoneHref}>
        Discuss Farm Pollination
      </a>
      {detailed ? (
        <a class="button service-secondary" href="/contact#inquiry">
          Send Farm Details
        </a>
      ) : (
        <a class="button service-secondary" href="/services#farm-pollination">
          Assessment Checklist &rarr;
        </a>
      )}
    </div>
  </article>
</div>
<p class="service-path-safety">
  <strong>Safety First:</strong> Give bees space. Do not disturb a colony or
  approach it for a photograph.
</p>

<style>
  .service-path-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .service-path-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.65rem;
    border: 1.5px solid var(--line);
    border-radius: 1rem;
    background: var(--white);
    box-shadow: var(--golden-shadow);
    scroll-margin-top: 2rem;
  }
  .rescue-panel {
    border-color: var(--service-alert);
  }
  .service-path-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .service-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--forest);
    font-size: 0.73rem;
    font-weight: 700;
  }
  .service-free {
    background: var(--service-alert);
    color: var(--service-alert-ink);
    border-color: transparent;
  }
  .service-area {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 1.65rem;
    line-height: 1.6;
  }
  .service-path-card > p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }
  .service-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
  }
  .service-actions :global(.button) {
    padding: 0.7rem 1.1rem;
    min-height: 44px;
    font-size: 0.88rem;
    font-weight: 700;
    text-align: center;
  }
  .service-secondary {
    background: transparent;
    color: var(--forest);
    border: 1.5px solid var(--service-border-strong);
  }
  .service-farm-action {
    background: var(--service-action);
    color: var(--service-action-ink);
    border-color: var(--service-action);
  }
  .pollination-evidence {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    border-radius: 0.65rem;
    background: var(--surface);
    border-left: 4px solid var(--tomato);
  }
  .evidence-stat {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--tomato);
    flex-shrink: 0;
  }
  .pollination-evidence p {
    margin: 0;
    color: var(--forest);
    font-size: 0.84rem;
    line-height: 1.6;
  }
  .service-path-safety {
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    border-left: 4px solid var(--service-alert);
    background: var(--white);
    border-radius: 0.65rem;
    font-size: 0.86rem;
  }
  .service-path-details {
    font-size: 0.85rem;
  }
  .service-path-details ul {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.2rem;
    margin-block: 0.5rem;
  }
  @media (max-width: 940px) {
    .service-path-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
