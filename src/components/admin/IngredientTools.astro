---
import {
  extractIngredientsFromDetails,
  formatIngredientLabel,
} from "../../domain/ingredients.ts";

interface Props {
  ingredients?: readonly string[];
  details?: readonly string[];
  fieldKey?: string;
}
const { ingredients = [], details = [], fieldKey = "new" } = Astro.props;
let label = "";
let note = "";
let importable = false;
try {
  label = formatIngredientLabel(ingredients);
  if (ingredients.length) {
    note =
      "Existing ingredients will not be overwritten. Clear them intentionally before importing.";
  } else {
    extractIngredientsFromDetails(details);
    importable = true;
    note =
      "An explicit ingredient block is available to move. Size and other notes will be kept.";
  }
} catch (error) {
  note = error instanceof Error ? error.message : "Review the ingredient text.";
}
const previewId = `ingredient-label-${fieldKey}`;
const helpId = `ingredient-import-help-${fieldKey}`;
---

<section
  data-ingredient-tools
  class="ingredient-tools"
  aria-label="Ingredient text tools"
>
  <button
    type="button"
    data-import-ingredients
    aria-describedby={helpId}
    disabled={!importable}
  >
    Move ingredients from Details
  </button>
  <p id={helpId} data-ingredient-help class="admin-muted">
    {note}
  </p>
  <label for={previewId}>Generated ingredient text</label>
  <textarea
    id={previewId}
    data-ingredient-label
    readonly
    rows="3"
    placeholder="Enter confirmed ingredients to preview their label text."
  >{label}</textarea>
  <button type="button" data-copy-ingredients disabled={!label}>
    Copy ingredient text
  </button>
  <p class="admin-muted">
    Uses only your saved names and order. Review against your formula and
    approved label before printing; this is not a compliance or allergen
    certification. Importing and copying do not save changes.
  </p>
  <p data-ingredient-status role="status" tabindex="-1"></p>
</section>

<style>
  .ingredient-tools {
    padding: 1rem;
    margin-top: 1rem;
    border: 1px solid currentColor;
    overflow-wrap: anywhere;
  }
  textarea {
    width: 100%;
    min-width: 0;
  }
  button {
    min-height: 2.75rem;
    max-width: 100%;
    white-space: normal;
  }
</style>
