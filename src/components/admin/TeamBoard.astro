---
import {
  checklistProgress,
  dueDateStatus,
  formatTaskDisplayId,
  isTaskBlocked,
  taskAssignees,
  taskSizes,
  taskStatuses,
  type TeamTask,
} from "../../domain/team-board.ts";
import "../../styles/inventory-pages.css";

interface Props {
  tasks: TeamTask[];
}
const { tasks } = Astro.props;
const assigneeLabels = Object.fromEntries(taskAssignees);
const activeTasks = tasks.filter((task) => !task.archived);
const sprintActiveCount = activeTasks.filter(
  (task) => task.status !== "backlog" && task.status !== "done",
).length;
const doingCount = activeTasks.filter((task) => task.status === "doing").length;
const urgentCount = activeTasks.filter((task) => task.priority === "P0").length;
const blockedCount = activeTasks.filter((task) => isTaskBlocked(task)).length;
const doneCount = activeTasks.filter((task) => task.status === "done").length;
const sprintDenominator = sprintActiveCount + doneCount;
const sprintPercent = sprintDenominator
  ? Math.round((doneCount / sprintDenominator) * 100)
  : 0;
const uniqueEpics = [
  ...new Set(tasks.map((task) => task.epic).filter(Boolean)),
].sort((a, b) => a.localeCompare(b));
const todayIso = new Date().toISOString().slice(0, 10);

function ownerInitial(assignee: TeamTask["assignee"]) {
  if (!assignee) return "–";
  return (assigneeLabels[assignee] ?? assignee).slice(0, 1).toUpperCase();
}
function formatShortDate(iso?: string) {
  if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return "";
  const [y, m, d] = iso.split("-").map(Number);
  return new Date(Date.UTC(y!, m! - 1, d!)).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
}
---

<div data-team-board class="inventory-pages inventory-team-workspace">
  <section
    class="inventory-page-card team-control-deck"
    aria-label="Task filters"
  >
    <header class="inventory-card-heading team-deck-head">
      <div>
        <p class="admin-eyebrow">Shared work / Team sprint</p>
        <h2>Make room for the next good thing.</h2>
        <p class="team-intro">
          Focus active work from Ready to Done, keep future ideas tidy in
          Backlog, and tap any card for checklists, handoffs, and details.
        </p>
      </div>
      <div class="team-actions">
        <button type="button" class="team-btn-primary" data-team-new>
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M8 3v10M3 8h10"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
          New task
        </button>
        <button type="button" class="team-btn-secondary" data-team-refresh>
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M13.5 8a5.5 5.5 0 1 1-1.4-3.65M13.5 2.5v2.6h-2.6"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Refresh board
        </button>
      </div>
    </header>

    <div class="team-pulse" data-team-pulse aria-label="Sprint pulse">
      <button
        type="button"
        class="team-pulse-card"
        data-team-pulse-filter="sprint"
        aria-pressed="false"
      >
        <span class="team-pulse-label">In flight</span>
        <strong class="team-pulse-value" data-pulse-active>
          {sprintActiveCount}
        </strong>
        <span class="team-pulse-sub">Ready → Review</span>
      </button>
      <button
        type="button"
        class:list={["team-pulse-card", { "is-wip-high": doingCount > 4 }]}
        data-team-pulse-filter="doing"
        aria-pressed="false"
      >
        <span class="team-pulse-label">Doing now</span>
        <strong class="team-pulse-value" data-pulse-doing>
          {doingCount}
        </strong>
        <span class="team-pulse-sub" data-pulse-wip>
          {doingCount > 4 ? "Above 4-card WIP target" : "Target ≤ 4 active"}
        </span>
      </button>
      <button
        type="button"
        class="team-pulse-card"
        data-team-pulse-filter="urgent"
        aria-pressed="false"
      >
        <span class="team-pulse-label">Urgent P0</span>
        <strong class="team-pulse-value is-urgent" data-pulse-urgent>
          {urgentCount}
        </strong>
        <span class="team-pulse-sub">Top priority</span>
      </button>
      <button
        type="button"
        class="team-pulse-card"
        data-team-pulse-filter="blocked"
        aria-pressed="false"
      >
        <span class="team-pulse-label">Waiting / Blocked</span>
        <strong class="team-pulse-value is-blocked" data-pulse-blocked>
          {blockedCount}
        </strong>
        <span class="team-pulse-sub">Needs handoff</span>
      </button>
      <div class="team-pulse-card team-pulse-progress">
        <div class="team-pulse-progress-top">
          <span class="team-pulse-label">Sprint done</span>
          <strong class="team-pulse-value" data-pulse-done>
            {doneCount} <small>({sprintPercent}%)</small>
          </strong>
        </div>
        <div class="team-progress-track" aria-hidden="true">
          <span
            class="team-progress-fill"
            data-pulse-bar
            style={`width: ${sprintPercent}%`}
          ></span>
        </div>
        <span class="team-pulse-sub" data-pulse-summary>
          {doneCount} done of {sprintDenominator} sprint tasks
        </span>
      </div>
    </div>

    <div class="team-quick-bar">
      <div
        class="team-owner-pills"
        data-team-owner-pills
        role="group"
        aria-label="Quick filter by person"
      >
        <button
          type="button"
          class="team-pill-btn"
          data-owner-pill=""
          aria-pressed="true"
        >
          Everyone
        </button>
        {taskAssignees.map(([key, name]) => (
          <button
            type="button"
            class="team-pill-btn"
            data-owner-pill={key}
            aria-pressed="false"
          >
            <span class="team-avatar" data-owner={key} aria-hidden="true">
              {name.slice(0, 1)}
            </span>
            {name}
          </button>
        ))}
        <button
          type="button"
          class="team-pill-btn"
          data-owner-pill="unassigned"
          aria-pressed="false"
        >
          <span class="team-avatar" data-owner="unassigned" aria-hidden="true">
            –
          </span>
          Unassigned
        </button>
      </div>

      <div
        class="team-layout-switch"
        role="group"
        aria-label="Workspace layout"
      >
        <button
          type="button"
          class="team-pill-btn"
          data-team-layout="board"
          aria-pressed="true"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <rect
              x="2"
              y="2.5"
              width="3.3"
              height="11"
              rx="0.8"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <rect
              x="6.35"
              y="2.5"
              width="3.3"
              height="7.5"
              rx="0.8"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <rect
              x="10.7"
              y="2.5"
              width="3.3"
              height="9.5"
              rx="0.8"
              stroke="currentColor"
              stroke-width="1.4"
            />
          </svg>
          Board
        </button>
        <button
          type="button"
          class="team-pill-btn"
          data-team-layout="list"
          aria-pressed="false"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2.5 4h11M2.5 8h11M2.5 12h11"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
          List
        </button>
        <button
          type="button"
          class="team-pill-btn team-collapse-backlog-pill"
          data-team-lane-collapse="backlog"
          aria-expanded="true"
          aria-pressed="false"
          title="Collapse Backlog rail to give active sprint columns more room"
        >
          Collapse Backlog
        </button>
      </div>
    </div>

    <div class="team-toolbar">
      <label class="team-field team-search-field">
        <span class="team-field-label">Find a task</span>
        <span class="team-search-wrap">
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="7"
              cy="7"
              r="4.5"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path
              d="m10.5 10.5 3 3"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
          <input
            data-team-search
            type="search"
            placeholder="Title, ID, epic, or note"
            maxlength="160"
          />
        </span>
      </label>
      <label class="team-field">
        <span class="team-field-label">Assignee</span>
        <span class="team-select">
          <select data-team-owner>
            <option value="">Everyone</option>
            {taskAssignees.map(([key, name]) => (
              <option value={key}>{name}</option>
            ))}
            <option value="unassigned">Unassigned</option>
          </select>
          <svg
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 6 4 4 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </label>
      <label class="team-field">
        <span class="team-field-label">Epic</span>
        <span class="team-select">
          <select data-team-epic>
            <option value="">All epics</option>
            {uniqueEpics.map((epic) => (
              <option value={epic}>{epic}</option>
            ))}
          </select>
          <svg
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 6 4 4 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </label>
      <label class="team-field">
        <span class="team-field-label">Priority</span>
        <span class="team-select">
          <select data-team-priority>
            <option value="">All priorities</option>
            <option value="P0">P0 · Urgent</option>
            <option value="P1">P1 · Next</option>
            <option value="P2">P2 · Later</option>
          </select>
          <svg
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 6 4 4 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </label>
      <label class="team-field">
        <span class="team-field-label">Status</span>
        <span class="team-select">
          <select data-team-status>
            <option value="">All statuses</option>
            {taskStatuses.map(([key, name]) => (
              <option value={key}>{name}</option>
            ))}
          </select>
          <svg
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 6 4 4 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </label>
      <label class="team-field">
        <span class="team-field-label">Sort</span>
        <span class="team-select">
          <select data-team-sort>
            <option value="rank">Board order</option>
            <option value="priority">Priority (P0 first)</option>
            <option value="due">Target date</option>
            <option value="title">Title (A–Z)</option>
          </select>
          <svg
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 6 4 4 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </label>
      <label class="team-field">
        <span class="team-field-label">View</span>
        <span class="team-select">
          <select data-team-view>
            <option value="active">Active tasks</option>
            <option value="archived">Archived</option>
          </select>
          <svg
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 6 4 4 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </label>
    </div>

    <div class="team-status-bar">
      <p class="team-feedback" role="status" data-team-feedback tabindex="-1">
        {tasks.length
          ? `${activeTasks.length} ${activeTasks.length === 1 ? "task" : "tasks"} on the board.`
          : "No tasks yet. Create your first task."}
      </p>
      <button type="button" class="team-btn-ghost" data-team-reset>
        Clear filters
      </button>
    </div>
    <p class="team-empty-banner" data-team-empty hidden>
      No tasks match these filters.
    </p>
  </section>

  <nav
    class="team-mobile-tabs"
    data-team-mobile-tabs
    aria-label="Mobile stage switcher"
  >
    <button
      type="button"
      class="team-mobile-tab"
      data-team-mobile-tab="all"
      aria-pressed="true"
    >
      All stages
    </button>
    {taskStatuses.map(([status, name]) => (
      <button
        type="button"
        class="team-mobile-tab"
        data-team-mobile-tab={status}
        aria-pressed="false"
      >
        <span>{name}</span>
        <small data-mobile-count={status}>
          {
            tasks.filter((task) => task.status === status && !task.archived)
              .length
          }
        </small>
      </button>
    ))}
  </nav>

  <div class="team-lanes" data-team-lanes>
    {taskStatuses.map(([status, name]) => {
      const laneTasks = tasks.filter((task) => task.status === status);
      const activeLaneCount = laneTasks.filter((task) => !task.archived).length;
      return (
        <section
          class="team-lane"
          data-team-lane={status}
          aria-labelledby={`team-${status}`}
        >
          <header class="team-lane-head">
            <h2 id={`team-${status}`}>
              <span class="team-lane-dot" aria-hidden="true"></span>
              <span class="team-lane-title">{name}</span>
              <span class="team-lane-count" data-team-count>
                {activeLaneCount}
              </span>
            </h2>
            <div class="team-lane-tools">
              <button
                type="button"
                class="team-lane-icon-btn"
                data-team-lane-add={status}
                aria-label={`Add task to ${name}`}
                title={`Add task to ${name}`}
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M8 3.5v9M3.5 8h9"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
            </div>
          </header>

          <ul class="team-card-list" data-team-list role="list">
            {laneTasks.map((task) => {
              const check = checklistProgress(task.detail.checklist);
              const dueState = dueDateStatus(
                task.detail.dueDate,
                task.status,
                todayIso,
              );
              const blocked = isTaskBlocked(task);
              const ownerLabel = task.assignee
                ? assigneeLabels[task.assignee]
                : "Unassigned";
              return (
                <li
                  class="team-card"
                  draggable="true"
                  data-team-card={task.id}
                  data-status={task.status}
                  data-priority={task.priority}
                  data-assignee={task.assignee ?? ""}
                  data-revision={task.revision}
                  data-rank={task.rank}
                  data-search={`${task.id} ${task.title} ${task.epic}`.toLowerCase()}
                  data-task={JSON.stringify(task)}
                  hidden={task.archived}
                >
                  <button
                    type="button"
                    class="team-card-button"
                    data-team-open
                    aria-haspopup="dialog"
                  >
                    <span class="team-card-top">
                      <span class="team-id-pill" data-team-id title={task.id}>
                        {formatTaskDisplayId(task.id)}
                      </span>
                      <span
                        class="team-priority-badge"
                        data-priority={task.priority}
                        data-team-priority-badge
                      >
                        {task.priority}
                      </span>
                      {task.detail.size && (
                        <span class="team-size-badge" data-team-size>
                          {task.detail.size}
                        </span>
                      )}
                    </span>
                    <strong class="team-card-title" data-team-title>
                      {task.title}
                    </strong>
                    <span class="team-card-signals" data-team-signals>
                      <span class="team-epic-pill" data-team-epic-pill>
                        {task.epic}
                      </span>
                      {blocked && (
                        <span class="team-signal-badge is-blocked">
                          {task.detail.blocker?.trim() ? "Blocked" : "Waiting"}
                        </span>
                      )}
                      {dueState && (
                        <span
                          class="team-signal-badge"
                          data-due-state={dueState}
                        >
                          {dueState === "overdue"
                            ? `Overdue · ${formatShortDate(task.detail.dueDate)}`
                            : `Due ${formatShortDate(task.detail.dueDate)}`}
                        </span>
                      )}
                      {check.total > 0 && (
                        <span
                          class="team-signal-badge team-check-pill"
                          data-team-check-progress
                        >
                          {check.done}/{check.total}
                        </span>
                      )}
                    </span>
                    <span class="team-card-owner-row">
                      <span
                        class="team-owner-chip"
                        data-owner={task.assignee ?? "unassigned"}
                      >
                        <span class="team-avatar" aria-hidden="true">
                          {ownerInitial(task.assignee)}
                        </span>
                        <span data-team-assignee>{ownerLabel}</span>
                      </span>
                      <span class="team-open-hint" aria-hidden="true">
                        Details
                      </span>
                    </span>
                  </button>
                  <div class="team-card-actions">
                    <span class="team-select team-select-compact">
                      <select
                        data-team-move
                        aria-label={`Move ${task.id}`}
                        disabled={task.archived}
                      >
                        {taskStatuses.map(([key, label]) => (
                          <option value={key} selected={key === task.status}>
                            {label}
                          </option>
                        ))}
                      </select>
                      <svg
                        viewBox="0 0 16 16"
                        width="14"
                        height="14"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="m4 6 4 4 4-4"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    <button
                      type="button"
                      class="team-card-discard"
                      data-team-discard
                    >
                      {task.archived ? "Restore" : "Discard"}
                    </button>
                  </div>
                  <template>
                    <div class="team-details">
                      <p class="team-card-meta">
                        {task.id} · {task.priority} · {task.epic}{" "}
                        {task.detail.size && `· Size ${task.detail.size}`}
                      </p>
                      {task.detail.scope && <p>{task.detail.scope}</p>}
                      {task.detail.acceptance && (
                        <section>
                          <h3>Done when</h3>
                          <p>{task.detail.acceptance}</p>
                        </section>
                      )}
                      {task.detail.prerequisites && (
                        <section>
                          <h3>Prerequisites</h3>
                          <p>{task.detail.prerequisites}</p>
                        </section>
                      )}
                      {task.detail.iteration && (
                        <section>
                          <h3>{task.detail.iteration}</h3>
                          {task.detail.pilot && <p>{task.detail.pilot}</p>}
                          {task.detail.timebox && <p>{task.detail.timebox}</p>}
                          {task.detail.checklist && (
                            <p>{task.detail.checklist}</p>
                          )}
                        </section>
                      )}
                    </div>
                  </template>
                </li>
              );
            })}
          </ul>

          {status === "backlog" && (
            <button
              type="button"
              class="team-backlog-more"
              data-team-backlog-more
              hidden
            >
              Show all backlog tasks
            </button>
          )}
          <p class="team-drop-note">Drop here to move to {name}.</p>
        </section>
      );
    })}
  </div>

  <section
    class="inventory-page-card team-list-section"
    data-team-list-view
    aria-label="Task list view"
    hidden
  >
    <header class="team-list-toolbar">
      <div>
        <p class="admin-eyebrow">Triage &amp; batch review</p>
        <h3>Task list</h3>
      </div>
      <label class="team-field team-group-field">
        <span class="team-field-label">Group by</span>
        <span class="team-select">
          <select data-team-group>
            <option value="status">Status stage</option>
            <option value="epic">Epic / workstream</option>
            <option value="priority">Priority</option>
            <option value="assignee">Assignee</option>
          </select>
          <svg
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 6 4 4 4-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </label>
    </header>
    <div class="team-list-groups" data-team-list-groups></div>
  </section>

  <dialog class="team-modal" aria-labelledby="team-task-title">
    <div class="team-modal-head">
      <div class="team-modal-title-group">
        <div class="team-modal-kicker" data-team-modal-kicker hidden></div>
        <h2 id="team-task-title" data-team-modal-title></h2>
      </div>
      <form method="dialog">
        <button class="team-close" autofocus>
          Close
        </button>
      </form>
    </div>
    <form class="team-edit" method="dialog" data-team-edit>
      <label class="team-wide">
        <span class="team-field-label">Title</span>
        <input
          name="title"
          required
          maxlength="160"
          placeholder="Clear, actionable task summary"
        />
      </label>
      <label>
        <span class="team-field-label">Epic</span>
        <input
          name="epic"
          list="team-epics-datalist"
          required
          maxlength="120"
          placeholder="e.g. Soap shelf"
        />
      </label>
      <label>
        <span class="team-field-label">Priority</span>
        <span class="team-select">
          <select name="priority">
