---
import {
  taskAssignees,
  taskStatuses,
  type TeamTask,
} from "../../domain/team-board.ts";
import "../../styles/inventory-pages.css";

interface Props {
  tasks: TeamTask[];
}
const { tasks } = Astro.props;
const assigneeLabels = Object.fromEntries(taskAssignees);
---

<div data-team-board class="inventory-pages inventory-team-workspace">
  <section class="inventory-page-card" aria-label="Task filters">
    <header class="inventory-card-heading">
      <div>
        <p class="admin-eyebrow">Shared work / Team sprint</p>
        <h2>Make room for the next good thing.</h2>
      </div>
      <div class="team-actions">
        <button type="button" data-team-new>
          New task
        </button>
        <button type="button" data-team-refresh>
          Refresh board
        </button>
      </div>
    </header>
    <p class="team-intro">
      Drag a card to move it. On a phone or with a keyboard, open the card and
      choose its status. Create and edit your own tasks. Discarded tasks can
      always be restored from Archived. Saved changes are shared.
    </p>
    <div class="team-toolbar">
      <label>
        Find a task
        <input
          data-team-search
          type="search"
          placeholder="Title, ID, or epic"
          maxlength="160"
        />
      </label>
      <label>
        Assignee
        <select data-team-owner>
          <option value="">Everyone</option>
          {taskAssignees.map(([key, name]) => (
            <option value={key}>{name}</option>
          ))}
          <option value="unassigned">Unassigned</option>
        </select>
      </label>
      <label>
        View
        <select data-team-view>
          <option value="active">Active tasks</option>
          <option value="archived">Archived</option>
        </select>
      </label>
      <label>
        Priority
        <select data-team-priority>
          <option value="">All priorities</option>
          <option value="P0">P0 / Urgent</option>
          <option value="P1">P1 / Next</option>
          <option value="P2">P2 / Later</option>
        </select>
      </label>
      <label>
        Status
        <select data-team-status>
          <option value="">All statuses</option>
          {taskStatuses.map(([key, name]) => (
            <option value={key}>{name}</option>
          ))}
        </select>
      </label>
    </div>
    <button type="button" data-team-reset>
      Clear filters
    </button>
    <p class="team-feedback" role="status" data-team-feedback tabindex="-1">
      {tasks.length
        ? `${tasks.length} ${tasks.length === 1 ? "task" : "tasks"} on the board.`
        : "No tasks yet. Create your first task."}
    </p>
    <p data-team-empty hidden>
      No tasks match these filters.
    </p>
  </section>
  <div class="team-lanes">
    {taskStatuses.map(([status, name]) => (
      <section
        class="team-lane"
        data-team-lane={status}
        aria-labelledby={`team-${status}`}
      >
        <h2 id={`team-${status}`}>
          {name}{" "}
          <span data-team-count>
            {
              tasks.filter((task) => task.status === status && !task.archived)
                .length
            }
          </span>
        </h2>
        <ul data-team-list role="list">
          {tasks
            .filter((task) => task.status === status)
            .map((task) => (
              <li
                draggable="true"
                data-team-card={task.id}
                data-status={task.status}
                data-assignee={task.assignee ?? ""}
                data-revision={task.revision}
                data-rank={task.rank}
                data-search={`${task.id} ${task.title} ${task.epic}`.toLowerCase()}
                data-task={JSON.stringify(task)}
                hidden={task.archived}
              >
                <button
                  type="button"
                  class="team-card-button"
                  data-team-open
                  aria-haspopup="dialog"
                >
                  <span class="team-card-meta">
                    {task.id} · {task.priority}
                  </span>
                  <strong data-team-title>{task.title}</strong>
                  <span class="team-card-meta" data-team-assignee>
                    {task.assignee
                      ? assigneeLabels[task.assignee]
                      : "Unassigned"}
                  </span>
                </button>
                <div class="team-card-actions">
                  <label>
                    <span class="team-card-meta">Move</span>
                    <select
                      data-team-move
                      aria-label={`Move ${task.id}`}
                      disabled={task.archived}
                    >
                      {taskStatuses.map(([key, label]) => (
                        <option value={key} selected={key === task.status}>
                          {label}
                        </option>
                      ))}
                    </select>
                  </label>
                  <button type="button" data-team-discard>
                    {task.archived ? "Restore" : "Discard"}
                  </button>
                </div>
                <template>
                  <div class="team-details">
                    <p class="team-card-meta">
                      {task.id} · {task.priority} · {task.epic}{" "}
                      {task.detail.size && `· Size ${task.detail.size}`}
                    </p>
                    {task.detail.scope && <p>{task.detail.scope}</p>}
                    {task.detail.acceptance && (
                      <section>
                        <h3>Done when</h3>
                        <p>{task.detail.acceptance}</p>
                      </section>
                    )}
                    {task.detail.prerequisites && (
                      <section>
                        <h3>Prerequisites</h3>
                        <p>{task.detail.prerequisites}</p>
                      </section>
                    )}
                    {task.detail.iteration && (
                      <section>
                        <h3>{task.detail.iteration}</h3>
                        {task.detail.pilot && <p>{task.detail.pilot}</p>}
                        {task.detail.timebox && <p>{task.detail.timebox}</p>}
                        {task.detail.checklist && (
                          <p>{task.detail.checklist}</p>
                        )}
                      </section>
                    )}
                  </div>
                </template>
              </li>
            ))}
        </ul>
        <p class="team-drop-note">Drop a card here to move it to {name}.</p>
      </section>
    ))}
  </div>

  <dialog class="team-modal" aria-labelledby="team-task-title">
    <div class="team-modal-head">
      <h2 id="team-task-title" data-team-modal-title></h2>
      <form method="dialog">
        <button class="team-close" autofocus>
          Close
        </button>
      </form>
    </div>
    <div data-team-detail></div>
    <form class="team-edit" method="dialog" data-team-edit>
      <label class="team-wide">
        Title
        <input name="title" required maxlength="160" />
      </label>
      <label>
        Priority
        <select name="priority">
          <option value="P0">P0 / Urgent</option>
          <option value="P1">P1 / Next</option>
          <option value="P2">P2 / Later</option>
        </select>
      </label>
      <label>
        Epic
        <input name="epic" required maxlength="120" />
      </label>
      <label>
        Assignee
        <select name="assignee">
          <option value="">Unassigned</option>
          {taskAssignees.map(([key, name]) => (
            <option value={key}>{name}</option>
          ))}
        </select>
      </label>
      <label>
        Status
        <select name="status">
          {taskStatuses.map(([key, name]) => (
            <option value={key}>{name}</option>
          ))}
        </select>
      </label>
      <label class="team-wide">
        Description
        <textarea name="scope" rows="3" maxlength="2000"></textarea>
      </label>
      <label class="team-wide">
        Checklist
        <textarea name="checklist" rows="3" maxlength="2000"></textarea>
      </label>
      <label class="team-wide">
        Done when
        <textarea name="acceptance" rows="3" maxlength="2000"></textarea>
      </label>
      <label class="team-wide">
        Prerequisites
        <textarea name="prerequisites" rows="2" maxlength="2000"></textarea>
      </label>
      <button type="submit" data-team-submit>
        Save changes
      </button>
      <button type="button" data-team-archive>
        Discard task
      </button>
      <p class="team-wide" data-team-confirm hidden>
        Discard removes this task from the active board, not the database. You
        can restore it from Archived.
        <button type="button" data-team-confirm-discard>
          Confirm discard
        </button>
        <button type="button" data-team-cancel-discard>
          Keep task
        </button>
      </p>
      <p role="status" data-team-edit-feedback></p>
    </form>
  </dialog>
  <noscript>
    <p>JavaScript is required to open task details and save changes.</p>
  </noscript>
</div>

<script>
  import { mountTeamBoard } from "../../client/team-board.ts";
  const board = document.querySelector<HTMLElement>("[data-team-board]");
  const token = document.querySelector<HTMLMetaElement>(
    'meta[name="csrf-token"]',
  )?.content;
  if (board && token) mountTeamBoard(board, token);
</script>
