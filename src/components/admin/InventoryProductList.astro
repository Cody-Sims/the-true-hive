---
import type { AdminLocation, AdminProduct } from "../../domain/admin.ts";
import CountForm from "./CountForm.astro";
import { money } from "./presentation.ts";

interface Props {
  products: AdminProduct[];
  locations: AdminLocation[];
}
const { products, locations } = Astro.props;
---

<section class="inventory-products" aria-label="Products and location stock">
  <p>
    On hand is the physical count. Available / Sellable excludes held, committed
    and unavailable units at that location. Balances are not a pickup promise.
  </p>
  {products.map((product) => (
    <article class="inventory-product admin-panel">
      <header>
        <div class="inventory-product-heading">
          <h2>
            <a href={`/inventory/products/${encodeURIComponent(product.key)}`}>
              {product.title}
            </a>
          </h2>
          <span class="inventory-status">{product.status}</span>
        </div>
        <a
          href={`/inventory/products/${encodeURIComponent(product.key)}/labels`}
        >
          Print internal labels
        </a>
      </header>
      <details class="inventory-identifiers">
        <summary>Product details</summary>
        <p>
          Product key: <code>{product.key}</code> · {product.kind} · Revision{" "}
          {product.revision}
        </p>
        <ul>
          {product.variants.map((variant) => (
            <li>
              {variant.label} · SKU: <code>{variant.sku}</code> · Variant key:{" "}
              <code>{variant.key}</code>
            </li>
          ))}
        </ul>
      </details>
      {product.variants.length === 0 && (
        <p class="admin-notice">
          No variants or verified stock balances are available.
        </p>
      )}
      {product.variants.map((variant) => {
        const missing = locations.filter(
          (location) =>
            !variant.levels.some((level) => level.locationKey === location.key),
        );
        return (
          <section class="inventory-variant">
            <div class="inventory-variant-heading">
              <h3>{variant.label}</h3>
              <span>
                {money(variant.priceMinor)} ·{" "}
                {variant.active ? "active" : "inactive"}
              </span>
            </div>
            <div class="inventory-levels">
              {variant.levels.map((level) => (
                <CountForm
                  variant={variant}
                  level={level}
                  location={locations.find(
                    (location) => location.key === level.locationKey,
                  )}
                  productKey={product.key}
                  inline
                />
              ))}
            </div>
            {(missing.length > 0 || variant.levels.length === 0) && (
              <p class="admin-notice">
                No verified location balance
                {missing.length > 0
                  ? ` for ${missing.map((location) => location.name).join(", ")}`
                  : ""}
                . Missing records are not proof of zero stock; no adjustment is
                offered for them.
              </p>
            )}
          </section>
        );
      })}
    </article>
  ))}
</section>

<style>
  .inventory-products,
  .inventory-product,
  .inventory-variant {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .inventory-product h2 {
    margin: 0;
  }
  .inventory-product > header,
  .inventory-product-heading,
  .inventory-variant-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .inventory-product-heading {
    justify-content: start;
    min-width: 0;
  }
  .inventory-product > header > a,
  .inventory-variant-heading > span {
    font-size: 0.85rem;
  }
  .inventory-status {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    font-size: 0.8rem;
    text-transform: capitalize;
  }
  .inventory-identifiers {
    margin-block: 0.25rem;
    font-size: 0.8rem;
  }
  .inventory-identifiers summary {
    width: fit-content;
    min-height: 2rem;
    padding-block: 0.4rem;
    cursor: pointer;
  }
  .inventory-identifiers p,
  .inventory-identifiers ul {
    margin-block: 0.5rem;
  }
  .inventory-variant {
    margin-top: 0.75rem;
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }
  .inventory-variant h3 {
    margin: 0;
  }
  .inventory-levels {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
  }
  .inventory-levels :global(.stock-count) {
    margin-block: 0.25rem;
  }
</style>
