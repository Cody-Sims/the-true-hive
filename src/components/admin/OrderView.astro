---
import type { AdminOrder } from "../../domain/admin.ts";
import FormFeedback from "./FormFeedback.astro";
import { money } from "./presentation.ts";
import "../../styles/inventory-pages.css";
interface Props {
  order: AdminOrder;
}
const { order } = Astro.props;
---

<div class="inventory-pages inventory-order-workspace">
  <section class="inventory-page-card" aria-label="Order record">
    <header class="inventory-card-heading">
      <div>
        <p class="admin-eyebrow">Immutable merchandise / operational record</p>
        <h2>Order {order.id}</h2>
      </div>
    </header>
    <dl class="inventory-record-facts">
      <div>
        <dt>State</dt>
        <dd>
          <strong data-order-state>{order.state}</strong>
        </dd>
      </div>
      <div>
        <dt>Revision</dt>
        <dd data-order-revision>{order.revision}</dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>{order.locationKey}</dd>
      </div>
      <div>
        <dt>Immutable total</dt>
        <dd>{money(order.totalMinor)}</dd>
      </div>
    </dl>
    <dl class="inventory-record-times">
      <div>
        <dt>Created</dt>
        <dd>
          <time datetime={order.createdAt}>{order.createdAt}</time>
        </dd>
      </div>
      <div>
        <dt>Paid</dt>
        <dd>{order.paidAt ?? "Not confirmed"}</dd>
      </div>
      <div>
        <dt>Picked up</dt>
        <dd>{order.pickedUpAt ?? "Not recorded"}</dd>
      </div>
    </dl>
    {order.reconciliationReason && (
      <p class="admin-notice">
        Reconciliation required: {order.reconciliationReason}
      </p>
    )}
  </section>
  <div class="inventory-order-body">
    <section class="inventory-page-card" aria-labelledby="order-merchandise">
      <header class="inventory-card-heading">
        <div>
          <p class="admin-eyebrow">Saved at checkout</p>
          <h2 id="order-merchandise">Merchandise to hand over</h2>
        </div>
      </header>
      <table class="admin-table inventory-record-table" role="table">
        <caption>Immutable merchandise snapshots</caption>
        <thead>
          <tr>
            <th scope="col">Merchandise</th>
            <th scope="col">Variant</th>
            <th scope="col">Quantity</th>
            <th scope="col">Unit price</th>
          </tr>
        </thead>
        <tbody>
          {order.lines.map((line) => (
            <tr>
              <td data-label="Merchandise">
                {line.title} · {line.label}
              </td>
              <td data-label="Variant">{line.variantKey}</td>
              <td data-label="Quantity">{line.quantity}</td>
              <td data-label="Unit price">{money(line.priceMinor)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <section class="inventory-page-card" aria-label="Physical collection">
      <header class="inventory-card-heading">
        <div>
          <p class="admin-eyebrow">Physical collection</p>
          <h2>Record the handover</h2>
        </div>
      </header>
      {order.state === "paid" ? (
        <form
          data-admin-form="pickup"
          data-endpoint={`/api/admin/orders/${order.id}/pickup`}
          data-method="POST"
          data-refresh={`/api/admin/orders/${order.id}`}
          class="admin-form inventory-pickup-form"
        >
          <input name="expectedRevision" type="hidden" value={order.revision} />
          <fieldset data-intent-fields>
            <legend>Record physical departure</legend>
            <label class="admin-check">
              <input name="confirmedPickup" type="checkbox" required /> I
              confirm all listed merchandise has physically been picked up.
            </label>
            <p>
              This decreases physical on-hand and paid commitments together,
              once. It does not refund or automatically restock anything.
            </p>
          </fieldset>
          <button type="submit">Record pickup</button>
          <FormFeedback />
        </form>
      ) : (
        <p class="admin-notice">
          Pickup can be recorded only after the server confirms payment. Browser
          callbacks do not prove payment or release.
        </p>
      )}
      <p class="inventory-collection-note">
        Appointments do not record collection.{" "}
        <a href="/inventory/pickups">Review pickup scheduling</a>.
      </p>
    </section>
  </div>
</div>
