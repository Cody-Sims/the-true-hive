---
import type { AdminVariant } from "../../domain/admin.ts";
import FieldHelp from "./FieldHelp.astro";
interface Props {
  variant?: AdminVariant;
  baselineIndex?: number;
}
const { variant, baselineIndex } = Astro.props;
---

<fieldset
  data-admin-variant
  data-baseline-index={baselineIndex}
  class="admin-panel workbench-variant"
>
  <legend>Variant</legend>
  <div class="admin-field">
    <FieldHelp label="Variant key">
      A permanent ID for this particular size, scent or format, such as
      <code>lavender-soap-4oz-single</code>. Use unique lowercase letters,
      numbers and hyphens. It cannot change after saving; retire a variant
      rather than reusing its ID.
    </FieldHelp>
    <label>
      <span>Variant key</span>
      <input
        name="variantKey"
        value={variant?.key ?? ""}
        readonly={!!variant}
        required
        pattern="[a-z0-9][a-z0-9-]{0,79}"
        maxlength="80"
        placeholder="e.g. lavender-soap-4oz-single"
      />
    </label>
  </div>
  <div class="admin-field">
    <FieldHelp label="SKU">
      Your unique stock code for this variant, such as <code>SOAP-LAV-4</code>.
      It can match a code on your packaging or spreadsheet. It is not a stock
      quantity. Suggestions fill only blank new fields for your review. Existing
      SKUs stay fixed.
    </FieldHelp>
    <label>
      <span>SKU (stock code)</span>
      <input
        name="sku"
        value={variant?.sku ?? ""}
        readonly={!!variant}
        required
        maxlength="128"
        placeholder="e.g. SOAP-LAV-4"
      />
    </label>
  </div>
  <div class="admin-field">
    <FieldHelp label="Variant name">
      The customer-facing name of this option, such as{" "}
      <code>Single 4 oz bar</code>. Describe the actual format so it can be
      distinguished from other variants.
    </FieldHelp>
    <label>
      <span>Variant name</span>
      <input
        name="label"
        value={variant?.label ?? ""}
        required
        maxlength="160"
        placeholder="e.g. Single 4 oz bar"
      />
    </label>
  </div>
  <div class="admin-field">
    <FieldHelp label="Price">
      Enter whole USD cents: 1500 means $15.00, and 450 means $4.50. Leave this
      blank while drafting. A published real product needs an active variant
      with a positive price; setting a price does not enable checkout.
    </FieldHelp>
    <label>
      <span>Price (USD cents)</span>
      <input
        name="priceMinor"
        type="text"
        inputmode="numeric"
        pattern="[0-9]+"
        maxlength="32"
        value={variant?.priceMinor ?? ""}
        placeholder="e.g. 450 ($4.50)"
      />
    </label>
  </div>
  {!variant && (
    <div class="admin-variant-suggestions">
      <button type="button" data-suggest-sku>
        Suggest blank variant key and SKU
      </button>
      <p class="admin-muted">
        First confirm the product key and actual variant name above. Suggestions
        never overwrite manual or saved identifiers. Review them before saving;
        only this form is checked for collisions until the server validates
        them. These are internal codes, not retail UPC, EAN or GS1 identifiers.
      </p>
      <p data-sku-status role="status" class="admin-muted"></p>
    </div>
  )}
  <p class="admin-muted">
    Price is optional for a draft. Stock is recorded separately.
  </p>
  <label class="admin-check">
    <input
      name="variantActive"
      type="checkbox"
      checked={variant?.active ?? false}
    />{" "}
    Active variant
  </label>
  <div class="admin-actions">
    <button type="button" class="admin-secondary" data-workbench-toggle-variant>
      {variant?.active ? "Archive variant" : "Restore variant"}
    </button>
    {variant ? (
      <button type="button" class="admin-danger" data-admin-delete-variant>
        Delete saved variant
      </button>
    ) : (
      <button
        type="button"
        class="admin-secondary"
        data-workbench-remove-variant
      >
        Remove unsaved variant
      </button>
    )}
  </div>
  <p class="admin-muted">
    Archive / Restore changes this form only. Save to apply. Referenced keys and
    SKUs stay permanent.
  </p>
</fieldset>
