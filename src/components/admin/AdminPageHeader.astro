---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="admin-page-heading">
  <div>
    <p class="admin-eyebrow">The True Hive / Private inventory</p>
    <h1>{title}</h1>
  </div>
  <div class="admin-page-actions">
    <slot />
  </div>
</header>

<style>
  .admin-page-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 1.25rem;
  }
  h1 {
    font:
      400 clamp(2rem, 4vw, 3rem)/1.08 Georgia,
      "Times New Roman",
      serif;
    letter-spacing: -0.035em;
    margin: 0;
    min-width: 0;
  }
  .admin-eyebrow {
    margin: 0 0 0.4rem;
  }
  .admin-page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .admin-page-actions:empty {
    display: none;
  }
  .admin-page-actions :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.8rem;
  }
  .admin-page-actions :global(p) {
    margin: 0;
  }
  @media (max-width: 600px) {
    .admin-page-heading {
      align-items: flex-start;
      gap: 0.5rem;
      margin-block: 1.1rem;
    }
  }
</style>
