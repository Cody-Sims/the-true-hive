---
import {
  TEST_INVENTORY_LOCATION_KEY,
  type AdminLocation,
} from "../../domain/admin.ts";
import LocationForm from "./LocationForm.astro";
import ReadState from "./ReadState.astro";
import AdminPickup from "../pickup/AdminPickup.astro";
import "../../styles/locations.css";
interface Props {
  locations: AdminLocation[] | null;
  selectedKey?: string;
}
const { locations, selectedKey = "" } = Astro.props;
---

<div class="location-workspace">
  <p class="admin-page-intro">
    Inventory storage is where you keep and count goods. Customer pickup
    locations are separate meetup points supplied from that inventory. Meetup
    points do not hold their own stock.
  </p>
  {locations === null ? (
    <ReadState unavailable />
  ) : (
    <>
      <dl class="location-overview" aria-label="Location overview">
        <div>
          <dt>Inventory storage</dt>
          <dd>
            {
              locations.filter(
                (location) => location.key !== TEST_INVENTORY_LOCATION_KEY,
              ).length
            }
          </dd>
        </div>
        <div>
          <dt>Test inventory</dt>
          <dd>
            {
              locations.filter(
                (location) => location.key === TEST_INVENTORY_LOCATION_KEY,
              ).length
            }
          </dd>
        </div>
        <div>
          <dt>Active stock records</dt>
          <dd>{locations.filter((location) => location.active).length}</dd>
        </div>
      </dl>
      <section aria-labelledby="stock-locations-title">
        <div class="location-section-heading">
          <div>
            <p class="admin-eyebrow">Stock records / Not meetup addresses</p>
            <h2 id="stock-locations-title">Inventory storage</h2>
          </div>
          <a href="#new-location">Add inventory location</a>
        </div>
        {locations.length ? (
          <div class="location-record-grid">
            {locations.map((location) => (
              <article
                class="location-record-card"
                data-location-key={location.key}
              >
                <div class="location-record-heading">
                  <h3>{location.name}</h3>
                  <span
                    class:list={[
                      "location-badge",
                      { "is-active": location.active },
                    ]}
                  >
                    {location.active ? "Active" : "Inactive"}
                  </span>
                </div>
                <p class="location-key">{location.key}</p>
                <p class="admin-muted">
                  {location.key === TEST_INVENTORY_LOCATION_KEY
                    ? "Test inventory only. Sandbox balances are not real goods."
                    : "Inventory storage. This is not a customer pickup address."}
                </p>
                <p class="location-label">
                  {location.publicLabel || "No storefront label set"}
                </p>
                <p class="admin-muted">
                  {location.pickupEnabled
                    ? "Order fulfillment enabled"
                    : "Stock storage only"}{" "}
                  &middot; revision {location.revision}
                </p>
                <div class="location-record-actions">
                  <a
                    href={`/inventory/locations/${encodeURIComponent(location.key)}`}
                  >
                    Edit inventory record
                  </a>
                  <a
                    href={`/inventory/locations?stock=${encodeURIComponent(location.key)}#pickup-points`}
                  >
                    View supplied pickup points
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="admin-panel">
            <h3>Your first location starts here.</h3>
            <p>
              Add inventory storage below. Customer meetup points are managed
              separately and can share the same stock.
            </p>
          </div>
        )}
      </section>
      <section id="pickup-points" class="location-pickup-section" tabindex="-1">
        <AdminPickup view="locations" locationKey={selectedKey} />
      </section>
      <section
        id="new-location"
        class="location-create admin-record-section"
        tabindex="-1"
        aria-labelledby="new-location-title"
      >
        <p class="admin-eyebrow">A new place</p>
        <h2 id="new-location-title">Add an inventory location</h2>
        <p class="admin-muted">
          Add a record only for a place where goods are stored. Do not create a
          separate inventory record for each pickup meetup point. Counts are
          managed in Products.
        </p>
        <LocationForm />
      </section>
    </>
  )}
</div>
