---
import type { Product } from "../domain/catalog.ts";
import {
  money,
  pricedVariants,
  projectedStock,
  stockLabel,
} from "../domain/cart.ts";
interface Props {
  product: Product;
  preferredVariantKey?: string | undefined;
  compact?: boolean;
  showPrice?: boolean;
}
const {
  product,
  preferredVariantKey,
  compact = false,
  showPrice = false,
} = Astro.props;
const variants = pricedVariants(product);
const unavailable = (variant: (typeof variants)[number]) =>
  ["out_of_stock", "not_offered"].includes(
    projectedStock(variant)?.state ?? "",
  );
const offered = variants.filter((variant) => !unavailable(variant));
const selected =
  offered.find((variant) => variant.key === preferredVariantKey) ?? offered[0];
const soldOut = variants.every(
  (variant) => projectedStock(variant)?.state === "out_of_stock",
);
const titleId = compact ? `quick-${product.key}-title` : "add-cart-title";
---

{product.kind === "active" && variants.length > 0 && (
  <section
    id={compact ? undefined : "add-to-cart"}
    class:list={[
      "cart-controls",
      { "cart-controls-compact": compact, "cart-controls-detail": showPrice },
    ]}
    aria-labelledby={titleId}
  >
    <h2 id={titleId}>
      {offered.length ? "Choose your format." : "Availability"}
    </h2>
    {offered.length ? (
      <form
        data-add-to-cart
        data-quick-add={compact ? "" : undefined}
        hidden={compact}
      >
        <fieldset class="format-options">
          <legend>Format</legend>
          {variants.map((variant) => (
            <label class="format-option">
              <input
                type="radio"
                name="variantKey"
                value={variant.key}
                data-variant-price={money(variant.priceMinor!)}
                data-variant-label={variant.label}
                data-variant-href={
                  unavailable(variant)
                    ? undefined
                    : `/goods/${encodeURIComponent(product.slug)}?variant=${encodeURIComponent(variant.key)}`
                }
                data-variant-stock-label={
                  ["available", "low_stock"].includes(
                    projectedStock(variant)?.state ?? "",
                  )
                    ? "In Stock / Local Pickup"
                    : stockLabel(variant)
                }
                checked={variant.key === selected?.key}
                disabled={unavailable(variant)}
                required
              />
              <span>
                {variant.label}
                {projectedStock(variant) &&
                  projectedStock(variant)?.state !== "available" && (
                    <small>{stockLabel(variant)}</small>
                  )}
              </span>
              <strong>{money(variant.priceMinor!)}</strong>
            </label>
          ))}
        </fieldset>
        {compact ? (
          <input type="hidden" name="quantity" value="1" />
        ) : (
          <label>
            Quantity
            <input
              name="quantity"
              type="number"
              min="1"
              max="100"
              step="1"
              value="1"
              required
            />
          </label>
        )}
        <button type="submit" class="button button-primary">
          {compact || showPrice ? (
            <>
              Add to Cart —{" "}
              <span data-selected-price>
                {selected ? money(selected.priceMinor!) : ""}
              </span>
            </>
          ) : (
            "Add to cart"
          )}
        </button>
        {compact && (
          <a
            class="button quick-ingredients"
            href={`/goods/${encodeURIComponent(product.slug)}${product.ingredients?.length ? "#ingredients" : ""}`}
          >
            {product.ingredients?.length ? "Ingredients" : "Details"}
          </a>
        )}
        <p data-add-status role="status"></p>
      </form>
    ) : (
      <>
        <p class="sold-out">{soldOut ? "Sold out" : "Currently unavailable"}</p>
      </>
    )}
    {!compact && (
      <a class="text-link" href="/cart">
        View your cart &rarr;
      </a>
    )}
    <noscript>
      Enable JavaScript to use the cart, or contact us for help.
    </noscript>
  </section>
)}

<style>
  .cart-controls {
    padding: 0;
    margin-block: 1.5rem;
    border: 0;
    overflow-wrap: anywhere;
  }
  .cart-controls form {
    display: grid;
    grid-template-columns: minmax(4.5rem, 6rem) minmax(0, 1fr);
    gap: 1rem;
    margin-block: 1rem;
  }
  .cart-controls h2 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .cart-controls label {
    display: grid;
    gap: 0.4rem;
  }
  .cart-controls input[type="number"] {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.5rem;
    font: inherit;
    color: var(--forest);
    background: var(--paper);
    border: 1px solid var(--forest);
  }
  .format-options {
    display: grid;
    grid-column: 1 / -1;
    gap: 0.6rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .format-options legend {
    margin-bottom: 0.6rem;
    font-size: 0.8rem;
  }
  .format-options .format-option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.2rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .format-option:has(input:checked) {
    border-color: var(--forest);
    background: var(--surface);
  }
  .format-option:has(input:disabled) {
    color: var(--muted);
    cursor: not-allowed;
  }
  .format-option input {
    width: 1rem;
    height: 1rem;
    min-height: 0;
    margin: 0;
    accent-color: var(--forest);
  }
  .format-option small {
    display: block;
    margin-top: 0.2rem;
  }
  .cart-controls button {
    align-self: end;
    cursor: pointer;
    white-space: normal;
  }
  .cart-controls [data-add-status] {
    grid-column: 1 / -1;
    margin: 0;
  }
  .sold-out {
    font-weight: 700;
  }
  @media (max-width: 32rem) {
    .cart-controls form {
      grid-template-columns: minmax(0, 1fr);
    }
    .cart-controls button {
      grid-column: 1 / -1;
    }
  }
  .cart-controls :focus-visible {
    outline: 3px solid var(--tomato);
    outline-offset: 3px;
  }
  .format-option:focus-within {
    outline: 3px solid var(--tomato);
    outline-offset: 3px;
  }
  .cart-controls-compact {
    margin: 0;
  }
  .cart-controls-compact h2,
  .cart-controls-detail h2,
  .cart-controls-compact legend,
  .cart-controls-compact input[type="radio"] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .cart-controls-compact form {
    grid-template-columns: minmax(0, 1fr) auto;
    margin-block: 0.75rem 0;
  }
  .cart-controls-compact form[hidden] {
    display: none;
  }
  .cart-controls-compact .format-options {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .cart-controls-compact .format-option {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    padding: 0.65rem;
    border-radius: 0.65rem;
    font-size: 0.8rem;
  }
  .quick-ingredients {
    border-color: var(--line);
    background: var(--white);
    color: var(--forest);
  }
  .cart-controls-detail .format-options {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .cart-controls-detail .format-option {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: 0.65rem;
  }
  .cart-controls-detail .format-option strong {
    grid-column: 2;
  }
</style>
