---
import { pickupLocations, pickupInstructions } from "../content/pickup.ts";
---

<section
  class="pickup-steps"
  data-pickup-steps
  aria-labelledby="pickup-steps-title"
>
  <div class="wrap">
    <div class="pickup-heading">
      <div>
        <p class="eyebrow">Local pickup / Clear before you go</p>
        <h2 id="pickup-steps-title">Easy 3-step pickup along US-411.</h2>
      </div>
      <p>
        No shipping. Choose your goods, review the meetup points, and arrange a
        confirmed pickup time.
      </p>
    </div>
    <div class="pickup-grid">
      <article>
        <span class="pill">Step 01</span>
        <h3>Pick Your Soap &amp; Format</h3>
        <p>
          Compare the published ingredients, choose your format, and check
          current prices and availability.
        </p>
      </article>
      <article>
        <span class="pill">Step 02</span>
        <h3>Review the US-411 Spots</h3>
        <p>
          {pickupLocations
            .map((location) => `${location.name} (${location.city})`)
            .join(", ")}
          . These are meetup points, not walk-in shops.
        </p>
      </article>
      <article>
        <span class="pill">Step 03</span>
        <h3>Confirm Time &amp; Meet Locally</h3>
        <p>{pickupInstructions}</p>
      </article>
    </div>
    <a class="text-link" href="/cart#pickup">
      Cart &amp; pickup details &rarr;
    </a>
  </div>
</section>

<style>
  .pickup-steps {
    padding-block: 3rem;
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .pickup-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    align-items: end;
  }
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-block: 0.4rem 0;
  }
  .pickup-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  article {
    padding: 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 1rem;
  }
  h3 {
    margin-block: 0.75rem 0.5rem;
    font-size: 1.1rem;
  }
  article p {
    margin: 0;
    font-size: 0.85rem;
  }
  .text-link {
    margin-top: 1rem;
  }
  @media (max-width: 700px) {
    .pickup-heading,
    .pickup-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
