---
import type { SiteConfig } from "../server/config.ts";
import InquiryForm from "./InquiryForm.astro";
import { INQUIRY_EMAIL } from "../client/inquiry-draft.ts";
interface Props {
  contact: SiteConfig["contact"];
  headingLevel?: "h1" | "h2";
}
const { contact, headingLevel: Heading = "h2" } = Astro.props;
const ChannelHeading = Heading === "h1" ? "h2" : "h3";
---

<section id="connect" class="wrap home-connect" aria-labelledby="connect-title">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span>Contact</span>
  </nav>
  <div class="home-connect-panel" data-contact-layout>
    <div class="home-connect-copy">
      <p class="eyebrow">Madisonville, Tennessee</p>
      <Heading id="connect-title" class="contact-heading">
        Keep it local.
        <br />
        Start a conversation.
      </Heading>
      <p>
        Questions about colony rescue, farm pollination or the collection? Give
        us a call or prepare an email draft below.
      </p>
      <aside
        class="home-connect-channels"
        aria-label="Contact channels"
        data-contact-phone
      >
        <p class="eyebrow">Direct Phone</p>
        <ChannelHeading class="contact-channels-title">
          {contact.phone || "Contact The True Hive"}
        </ChannelHeading>
        <ul class="home-connect-list">
          {contact.phoneHref && (
            <li>
              <a class="button button-primary" href={contact.phoneHref}>
                <span>Call {contact.phone}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            </li>
          )}
          {contact.facebook && (
            <li>
              <a href={contact.facebook} rel="noopener noreferrer">
                <span>Facebook</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            </li>
          )}
          {contact.instagram && (
            <li>
              <a href={contact.instagram} rel="noopener noreferrer">
                <span>Instagram</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            </li>
          )}
        </ul>
        <p class="contact-email">
          Email: <a href={`mailto:${INQUIRY_EMAIL}`}>{INQUIRY_EMAIL}</a>
        </p>
      </aside>
      <p class="contact-safety">
        <strong>Safety:</strong> Give bees space. Do not disturb a colony or
        approach it for a photograph. Leave out home addresses and sensitive
        details from web drafts.
      </p>
      <a class="text-link" href="/goods">
        Browse the soaps <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <div data-contact-draft>
      <InquiryForm compact headingLevel="h2" />
    </div>
  </div>
</section>

<style>
  .home-connect {
    padding-block: 2.5rem 4rem;
  }
  .home-connect-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
    padding: 0;
    color: var(--forest);
    background: transparent;
  }
  .contact-heading {
    margin-block: 0.75rem 1rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
  }
  .home-connect-copy > p:not(.eyebrow) {
    max-width: 28rem;
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .home-connect-copy .text-link {
    margin-top: 1.5rem;
  }
  .home-connect-copy a:focus-visible {
    outline-color: var(--highlight-ink, var(--ochre));
  }
  .home-connect-channels {
    min-width: 0;
    margin-top: 1.5rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    color: var(--forest);
    background: var(--white);
    box-shadow: var(--golden-shadow);
  }
  .home-connect-channels > .eyebrow {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }
  .contact-channels-title {
    margin-block: 1rem 1.5rem;
    font-family: var(--font-body);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .home-connect-list {
    padding: 0;
    margin: 0 0 1.25rem;
    list-style: none;
  }
  .home-connect-list li {
    margin-bottom: 0.5rem;
  }
  .home-connect-list a {
    display: flex;
    min-height: 3.5rem;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.2rem;
    font-size: 0.85rem;
  }
  .contact-email {
    font-size: 0.85rem;
  }
  .contact-safety {
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    border-left: 4px solid var(--tomato);
    border-radius: 0.65rem;
    background: var(--white);
    font-size: 0.85rem;
  }
  .home-connect-list a {
    font-weight: 700;
  }
  @media (max-width: 52rem) {
    .home-connect-panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-connect-copy > p:not(.eyebrow) {
      max-width: 35rem;
    }
  }
  @media (max-width: 36rem) {
    .home-connect {
      padding-block: 3rem;
    }
    .home-connect-panel {
      gap: 2rem;
      padding: 1.25rem;
    }
    .contact-heading {
      font-size: clamp(2rem, 9vw, 2.75rem);
    }
    .home-connect-channels {
      padding: 1.25rem;
    }
    .contact-channels-title {
      font-size: 1.65rem;
    }
  }
</style>
