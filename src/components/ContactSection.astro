---
import type { SiteConfig } from "../server/config.ts";
interface Props {
  contact: SiteConfig["contact"];
}
const { contact } = Astro.props;
const hasContact = Boolean(
  contact.phoneHref || contact.facebook || contact.instagram,
);
---

<section id="connect" class="wrap home-connect" aria-labelledby="connect-title">
  <div class="home-connect-panel">
    <div class="home-connect-copy">
      <p class="eyebrow">The next conversation</p>
      <h2 id="connect-title">
        Keep it local.
        <br />
        <em>Keep in touch.</em>
      </h2>
      <p>
        {hasContact
          ? "Questions about the collection or future beekeeping plans? Use a published channel to start a conversation."
          : "Questions about the collection or future beekeeping plans? Phone and social links will appear here once they are confirmed."}
      </p>
      <a class="text-link" href="/goods">
        Return to the collection <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <aside class="home-connect-channels" aria-label="Contact channels">
      <p class="eyebrow">The True Hive / Madisonville, Tennessee</p>
      <h3>
        {hasContact
          ? "Let's start a conversation."
          : "A place for our next hello."}
      </h3>
      <ul class="home-connect-list">
        <li>
          {contact.phoneHref ? (
            <a href={contact.phoneHref}>
              <span>Call {contact.phone}</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          ) : (
            <div>
              <span>Phone</span>
              <small>Not published yet</small>
            </div>
          )}
        </li>
        <li>
          {contact.facebook ? (
            <a href={contact.facebook} rel="noopener noreferrer">
              <span>Facebook</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          ) : (
            <div>
              <span>Facebook</span>
              <small>Profile not published yet</small>
            </div>
          )}
        </li>
        <li>
          {contact.instagram ? (
            <a href={contact.instagram} rel="noopener noreferrer">
              <span>Instagram</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          ) : (
            <div>
              <span>Instagram</span>
              <small>Profile not published yet</small>
            </div>
          )}
        </li>
      </ul>
      {!hasContact && (
        <p class="fine-print">
          Phone and profile details are not published yet.
        </p>
      )}
      <p class="fine-print">
        This page does not send messages or accept orders. Email and online
        ordering are not open yet.
      </p>
    </aside>
  </div>
</section>

<style>
  .home-connect {
    padding-block: 5rem;
  }
  .home-connect-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--paper);
    background: var(--forest);
  }
  .home-connect-copy h2 {
    margin-block: 1.25rem 1.5rem;
    font-size: clamp(2.5rem, 4.5vw, 4.25rem);
    line-height: 1.08;
  }
  .home-connect-copy h2 em {
    color: var(--ochre);
  }
  .home-connect-copy > p:not(.eyebrow) {
    max-width: 28rem;
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .home-connect-copy .text-link {
    margin-top: 1.5rem;
  }
  .home-connect-copy a:focus-visible {
    outline-color: var(--ochre);
  }
  .home-connect-channels {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--forest);
    background: var(--paper);
  }
  .home-connect-channels > .eyebrow {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }
  .home-connect-channels h3 {
    margin-block: 1rem 1.5rem;
    font-size: 1.9rem;
    line-height: 1.2;
  }
  .home-connect-list {
    padding: 0;
    margin: 0 0 1.25rem;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .home-connect-list li {
    border-bottom: 1px solid var(--line);
  }
  .home-connect-list a,
  .home-connect-list li > div {
    display: flex;
    min-height: 3.5rem;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.2rem;
    font-size: 0.85rem;
  }
  .home-connect-list a {
    font-weight: 700;
  }
  .home-connect-list small {
    font-size: 0.7rem;
  }
  .home-connect-channels .fine-print + .fine-print {
    margin-top: 0.75rem;
  }
  @media (max-width: 52rem) {
    .home-connect-panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-connect-copy > p:not(.eyebrow) {
      max-width: 35rem;
    }
  }
  @media (max-width: 36rem) {
    .home-connect {
      padding-block: 3rem;
    }
    .home-connect-panel {
      gap: 2rem;
      padding: 1.25rem;
    }
    .home-connect-copy h2 {
      font-size: clamp(2rem, 9vw, 2.75rem);
    }
    .home-connect-channels {
      padding: 1.25rem;
    }
    .home-connect-channels h3 {
      font-size: 1.65rem;
    }
  }
</style>
