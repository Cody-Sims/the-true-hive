---
interface Props {
  href: string;
  class?: string;
  arrow?: boolean;
}

const { href, class: className = "text-link", arrow = false } = Astro.props;
---

<a class={className} href={href}>
  <slot />
  {arrow && (
    <>
      {" "}
      <span aria-hidden="true">&rarr;</span>
    </>
  )}
</a>
