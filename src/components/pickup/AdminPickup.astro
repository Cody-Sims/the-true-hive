---
import "../../styles/pickup.css";
interface Props {
  view?: "locations" | "appointments";
  locationKey?: string;
  fixedLocation?: boolean;
}
const {
  view = "appointments",
  locationKey = "",
  fixedLocation = false,
} = Astro.props;
const authorized = Boolean(
  Astro.locals.admin?.uid &&
  Astro.locals.admin.actorId &&
  Astro.locals.csrfToken,
);
---

{authorized ? (
  <section
    class="pickup-app"
    data-pickup-mode="admin"
    data-pickup-authorized="true"
    data-pickup-view={view}
    data-pickup-location={locationKey}
    data-pickup-fixed-location={String(fixedLocation)}
    aria-label={
      view === "locations" ? "Pickup details and hours" : "Pickup scheduling"
    }
  >
    <header class="pickup-intro">
      <p class="pickup-eyebrow">
        {view === "locations"
          ? "Customer collection"
          : "Inventory / Pickup desk"}
      </p>
      <h2>
        {view === "locations"
          ? "Pickup details & hours"
          : "Make room for a good handoff."}
      </h2>
      <p>
        {view === "locations"
          ? "Manage customer meetup points and their collection windows. Pickup locations do not hold inventory; several meetup points can be supplied from one inventory location. Changes affecting appointments require review."
          : "Help paid orders find a time and review upcoming handoffs. Scheduling never records physical pickup, changes stock, or changes payment."}
      </p>
      <a
        href={
          view === "locations" ? "/inventory/pickups" : "/inventory/locations"
        }
      >
        {view === "locations"
          ? "View pickup appointments"
          : "Manage locations & hours"}
      </a>
    </header>
    <div class="pickup-toolbar">
      <button type="button" data-pickup-refresh>
        Refresh records
      </button>
      <button type="button" data-pickup-retry hidden>
        Retry exact request
      </button>
    </div>
    <p class="pickup-feedback" data-pickup-status role="status" tabindex="-1">
      Loading pickup records…
    </p>
    <div data-pickup-content></div>
    <noscript>
      JavaScript is required to manage pickup scheduling. Physical pickup
      remains available from orders.
    </noscript>
  </section>
) : (
  <p>A verified inventory session is required.</p>
)}
