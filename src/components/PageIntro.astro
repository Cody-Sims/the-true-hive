---
interface Props {
  eyebrow: string;
  description: string;
  headingId?: string;
  class?: string;
}

const {
  eyebrow,
  description,
  headingId,
  class: className = "page-intro wrap",
} = Astro.props;
---

<section class={className} aria-labelledby={headingId}>
  <p class="eyebrow">{eyebrow}</p>
  <h1 id={headingId}>
    <slot name="heading" />
  </h1>
  <p>{description}</p>
  <slot />
</section>
