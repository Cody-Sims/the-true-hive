---
interface Props {
  ingredients?: readonly string[];
}
const { ingredients = [] } = Astro.props;
---

{ingredients.length > 0 && (
  <section aria-label="Ingredients">
    <h2>Ingredients</h2>
    <ul>
      {ingredients.map((ingredient) => (
        <li>{ingredient}</li>
      ))}
    </ul>
  </section>
)}
