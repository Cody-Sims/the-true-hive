---
import soap from "../../prototypes/assets/soap.svg?url";
import honey from "../../prototypes/assets/honey-jar.svg?url";
import candle from "../../prototypes/assets/candle.svg?url";
import type { ProductImage, ProductPhoto } from "../domain/catalog.ts";
import { getSoapReference } from "../content/soap-references.ts";

interface Props {
  image: ProductImage;
  alt?: string;
  eager?: boolean;
  photo?: ProductPhoto | null;
  photoSrc?: string | null;
  referenceKey?: string | undefined;
  referenceVariantKey?: string | undefined;
  sizes?: string | undefined;
}
const {
  image,
  alt = "",
  eager = false,
  photo,
  photoSrc,
  referenceKey,
  referenceVariantKey,
  sizes,
} = Astro.props;
const illustrations = { soap, honey, candle };
const reference = !photo
  ? getSoapReference(referenceKey, referenceVariantKey)
  : null;
---

<img
  class:list={["product-illustration", { "product-reference": !!reference }]}
  src={
    photo
      ? (photoSrc ?? `/media/products/${photo.id}`)
      : (reference?.src ?? illustrations[image])
  }
  srcset={
    reference ? `${reference.small} 480w, ${reference.src} 960w` : undefined
  }
  sizes={reference ? (sizes ?? "(max-width: 700px) 90vw, 45vw") : undefined}
  alt={photo ? photo.alt : (reference?.alt ?? alt)}
  width={photo?.width ?? (reference ? 960 : 420)}
  height={photo?.height ?? (reference ? 960 : 360)}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
/>

<style>
  .product-illustration {
    display: block;
    width: 100%;
    height: auto;
    min-width: 0;
    max-width: 30rem;
    margin-inline: auto;
    object-fit: contain;
  }
  .product-reference {
    max-width: none;
  }
</style>
