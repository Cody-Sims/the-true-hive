---
import soap from "../../prototypes/assets/soap.svg?url";
import honey from "../../prototypes/assets/honey-jar.svg?url";
import candle from "../../prototypes/assets/candle.svg?url";
import type { ProductImage, ProductPhoto } from "../domain/catalog.ts";

interface Props {
  image: ProductImage;
  alt?: string;
  eager?: boolean;
  photo?: ProductPhoto | null;
  photoSrc?: string | null;
}
const { image, alt = "", eager = false, photo, photoSrc } = Astro.props;
const illustrations = { soap, honey, candle };
---

<img
  class="product-illustration"
  src={
    photo ? (photoSrc ?? `/media/products/${photo.id}`) : illustrations[image]
  }
  alt={photo ? photo.alt : alt}
  width={photo?.width ?? 420}
  height={photo?.height ?? 360}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
/>

<style>
  .product-illustration {
    display: block;
    width: 100%;
    height: auto;
    min-width: 0;
    max-width: 30rem;
    margin-inline: auto;
    object-fit: contain;
  }
</style>
