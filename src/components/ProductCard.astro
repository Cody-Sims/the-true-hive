---
import type { Product } from "../domain/catalog.ts";
import ProductArt from "./ProductArt.astro";
import ProductPrices from "./ProductPrices.astro";

interface Props {
  product: Product;
  testCheckoutEnabled?: boolean;
  preview?: boolean;
  photoSrc?: string | null;
}
const {
  product,
  testCheckoutEnabled = false,
  preview = false,
  photoSrc = null,
} = Astro.props;
const ArtLink = preview ? "div" : "a";
const TitleLink = preview ? "span" : "a";
const canAddToCart =
  !preview &&
  product.kind === "active" &&
  product.variants.some(
    (variant) => variant.currency === "USD" && (variant.priceMinor ?? 0) > 0,
  );
const labels = {
  soap: "The daily ritual",
  honey: "For the table",
  candles: "A slower moment",
  gifts: "For someone good",
};
const categories = {
  soap: "Soap",
  honey: "Honey",
  candles: "Candles",
  gifts: "Gifts",
};
---

<article class="shelf-product">
  <ArtLink
    class:list={["shelf-art", `${product.imageKey}-art`]}
    href={preview ? undefined : `/goods/${product.slug}`}
  >
    {!preview && <span class="card-link-label">Explore {product.title}</span>}
    <span class="shelf-ticket">{labels[product.category]}</span>
    <ProductArt
      image={product.imageKey}
      photo={product.photo ?? null}
      photoSrc={photoSrc}
      alt={`${categories[product.category]} illustration.`}
    />
    {preview && (
      <span class="art-caption">
        {product.photo ? "Product photo" : "Original illustration"}
      </span>
    )}
  </ArtLink>
  <div class="shelf-copy">
    <p class="eyebrow">{categories[product.category]}</p>
    <h3>
      <TitleLink
        href={preview ? undefined : `/goods/${product.slug}`}
        data-preview-title={preview ? "" : undefined}
      >
        {preview ? (
          <span data-preview-title-text>{product.title}</span>
        ) : (
          product.title
        )}
        <span aria-hidden="true">&nearr;</span>
      </TitleLink>
    </h3>
    {!preview && <ProductPrices product={product} compact />}
    <p class="shelf-description">{product.summary}</p>
    <div class="shelf-meta">
      {(preview || product.kind === "concept") && (
        <span class="pill">
          {product.kind === "concept"
            ? "Concept product"
            : "Product information"}
        </span>
      )}
      {canAddToCart && (
        <a class="text-link" href={`/goods/${product.slug}#add-to-cart`}>
          {testCheckoutEnabled ? "Choose for your test cart" : "Choose options"}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card-link-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .shelf-product {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border: 1px solid var(--line);
  }
  .shelf-art {
    position: relative;
    display: grid;
    min-height: 0;
    aspect-ratio: 1.25;
    grid-template-rows: auto minmax(0, 1fr);
    isolation: isolate;
    padding: 1.5rem 0.75rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 0.2rem;
    text-decoration: none;
  }
  .shelf-art::before {
    position: absolute;
    z-index: -1;
    inset: 14% 12%;
    border: 1px solid var(--forest);
    border-radius: 50%;
    opacity: 0.14;
    content: "";
  }
  .shelf-art:hover {
    border-color: var(--forest);
  }
  .shelf-art :global(.product-illustration) {
    height: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .soap-art {
    background: #e8e9dc;
  }
  .honey-art {
    background: #f3e4b7;
  }
  .candle-art {
    background: #efdfd2;
  }
  .shelf-ticket {
    z-index: 1;
    top: 1rem;
    left: 1rem;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }
  .art-caption {
    position: absolute;
    right: 1rem;
    bottom: 0.75rem;
    left: 1rem;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .shelf-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 1.4rem 1.4rem 1.5rem;
  }
  .shelf-copy > .eyebrow {
    color: var(--tomato);
  }
  .shelf-copy h3 {
    margin-block: 0.35rem 0.65rem;
    font-size: clamp(1.65rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .shelf-copy h3 a,
  .shelf-copy h3 [data-preview-title] {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .shelf-copy h3 a span,
  .shelf-copy h3 [data-preview-title] > span[aria-hidden] {
    flex-shrink: 0;
    color: var(--tomato);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.15rem;
  }
  .shelf-copy > .shelf-description {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.75;
  }
  .shelf-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .shelf-meta .pill {
    margin: 0;
    padding: 0.35rem 0.6rem;
    border-color: var(--line);
    border-radius: 0.15rem;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }
  @media (max-width: 700px) {
    .shelf-art {
      aspect-ratio: 1.2;
    }
    .shelf-copy {
      padding: 1.25rem 1.25rem 1.4rem;
    }
  }
</style>
