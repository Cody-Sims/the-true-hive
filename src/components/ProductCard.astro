---
import type { Product } from "../domain/catalog.ts";
import ProductArt from "./ProductArt.astro";
import ProductPrices from "./ProductPrices.astro";
import StockNotice from "./StockNotice.astro";
import { getSoapReference } from "../content/soap-references.ts";
import { money, pricedVariants, projectedStock } from "../domain/cart.ts";

interface Props {
  product: Product;
  preview?: boolean;
  photoSrc?: string | null;
}
const { product, preview = false, photoSrc = null } = Astro.props;
const ArtLink = preview ? "div" : "a";
const TitleLink = preview ? "span" : "a";
const variants =
  !preview && product.kind === "active" ? pricedVariants(product) : [];
const reference =
  !preview && !product.photo ? getSoapReference(product.key) : null;
const labels = {
  soap: "The daily ritual",
  honey: "For the table",
  candles: "A slower moment",
  gifts: "For someone good",
};
const categories = {
  soap: "Soap",
  honey: "Honey",
  candles: "Candles",
  gifts: "Gifts",
};
---

<article class:list={["shelf-product", { "shelf-reference": !!reference }]}>
  <ArtLink
    class:list={["shelf-art", `${product.imageKey}-art`]}
    href={preview ? undefined : `/goods/${product.slug}`}
  >
    {!preview && <span class="card-link-label">Explore {product.title}</span>}
    {preview && <span class="shelf-ticket">{labels[product.category]}</span>}
    <ProductArt
      image={product.imageKey}
      photo={product.photo ?? null}
      photoSrc={photoSrc}
      alt={`${categories[product.category]} illustration.`}
      referenceKey={preview ? undefined : product.key}
    />
    {reference && <span class="reference-caption">AI styling reference</span>}
    {preview && (
      <span class="art-caption">
        {product.photo ? "Product photo" : "Original illustration"}
      </span>
    )}
  </ArtLink>
  <div class="shelf-copy">
    <p class="eyebrow">{categories[product.category]}</p>
    <h3>
      <TitleLink
        href={preview ? undefined : `/goods/${product.slug}`}
        data-preview-title={preview ? "" : undefined}
      >
        {preview ? (
          <span data-preview-title-text>{product.title}</span>
        ) : (
          product.title
        )}
        <span aria-hidden="true">&nearr;</span>
      </TitleLink>
    </h3>
    {!preview && (
      <ProductPrices product={product} compact showStock={!variants.length} />
    )}
    {(preview || product.kind !== "active") && (
      <p class="shelf-description">{product.summary}</p>
    )}
    {(preview || product.kind === "concept") && (
      <div class="shelf-meta">
        <span class="pill">
          {product.kind === "concept"
            ? "Concept product"
            : "Product information"}
        </span>
      </div>
    )}
    {variants.length > 0 && (
      <div class="shelf-formats" aria-label={`Formats for ${product.title}`}>
        {variants.map((variant) => {
          const stock = projectedStock(variant);
          const available =
            !stock || !["out_of_stock", "not_offered"].includes(stock.state);
          const Choice = available ? "a" : "span";
          return (
            <Choice
              class:list={[
                "shelf-format",
                { "format-unavailable": !available },
              ]}
              href={
                available
                  ? `/goods/${encodeURIComponent(product.slug)}?variant=${encodeURIComponent(variant.key)}#add-to-cart`
                  : undefined
              }
            >
              <span class="format-thumb">
                <ProductArt
                  image={product.imageKey}
                  photo={product.photo ?? null}
                  referenceKey={product.key}
                  referenceVariantKey={variant.key}
                  sizes="3rem"
                />
              </span>
              <span>
                <span class="format-name">{variant.label}</span>
                {stock && stock.state !== "available" && (
                  <StockNotice variant={variant} />
                )}
              </span>
              <strong>{money(variant.priceMinor!)}</strong>
              {available && (
                <span class="format-arrow" aria-hidden="true">
                  &rarr;
                </span>
              )}
            </Choice>
          );
        })}
      </div>
    )}
  </div>
</article>

<style>
  .card-link-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .shelf-product {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border: 0;
    background: transparent;
    border-radius: 0;
  }
  .shelf-product + .shelf-product {
    border: 0;
  }
  .shelf-art {
    position: relative;
    display: grid;
    min-height: 0;
    aspect-ratio: 1.05;
    grid-template-rows: minmax(0, 1fr);
    isolation: isolate;
    padding: 1.5rem;
    border: 0;
    border-radius: 0.2rem 0.2rem 0 0;
    text-decoration: none;
  }
  .shelf-art::before {
    position: absolute;
    z-index: -1;
    inset: 14% 12%;
    border: 1px solid var(--forest);
    border-radius: 50%;
    opacity: 0.14;
    content: "";
  }
  .shelf-art:hover {
    outline: 1px solid var(--forest);
    outline-offset: -1px;
  }
  .shelf-art :global(.product-illustration) {
    height: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .shelf-reference .shelf-art {
    padding: 0;
  }
  .shelf-reference .shelf-art::before {
    display: none;
  }
  .shelf-reference .shelf-art :global(.product-illustration) {
    object-fit: cover;
    object-position: 50% 62%;
    max-width: none;
  }
  .reference-caption {
    position: absolute;
    bottom: 0.8rem;
    left: 0.8rem;
    padding: 0.25rem 0.45rem;
    background: var(--paper);
    color: var(--forest);
    font-size: 0.65rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }
  .soap-art {
    background: #e8e9dc;
  }
  .honey-art {
    background: #f3e4b7;
  }
  .candle-art {
    background: #efdfd2;
  }
  .shelf-ticket {
    z-index: 1;
    top: 1rem;
    left: 1rem;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }
  .art-caption {
    position: absolute;
    right: 1rem;
    bottom: 0.75rem;
    left: 1rem;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .shelf-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 1.2rem 0 0;
  }
  .shelf-copy > .eyebrow {
    color: var(--tomato);
  }
  .shelf-copy h3 {
    margin-block: 0.35rem 0.65rem;
    font-size: clamp(1.65rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .shelf-copy h3 a,
  .shelf-copy h3 [data-preview-title] {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .shelf-copy h3 a span,
  .shelf-copy h3 [data-preview-title] > span[aria-hidden] {
    flex-shrink: 0;
    color: var(--tomato);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.15rem;
  }
  .shelf-copy > .shelf-description {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.75;
  }
  .shelf-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .shelf-formats {
    display: grid;
    gap: 0;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .shelf-format {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto auto;
    gap: 0.5rem 0.75rem;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.8rem 0.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.85rem;
  }
  a.shelf-format:hover {
    background: var(--surface);
  }
  .format-name {
    display: block;
  }
  .format-thumb :global(img) {
    width: 3rem;
    height: 3rem;
    object-fit: cover;
  }
  .format-arrow {
    color: var(--tomato);
  }
  .format-unavailable {
    color: var(--muted);
  }
  .shelf-meta .pill {
    margin: 0;
    padding: 0.35rem 0.6rem;
    border-color: var(--line);
    border-radius: 0.15rem;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }
  @media (max-width: 700px) {
    .shelf-art {
      aspect-ratio: 1.05;
    }
    .shelf-copy {
      padding: 1rem 0 0;
    }
  }
</style>
