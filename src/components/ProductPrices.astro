---
import type { Product } from "../domain/catalog.ts";
import { money, pricedVariants, projectedStock } from "../domain/cart.ts";
import StockNotice from "./StockNotice.astro";
interface Props {
  product: Product;
  compact?: boolean;
  showStock?: boolean;
}
const { product, compact = false, showStock = true } = Astro.props;
const priced = pricedVariants(product);
const prices = priced.map((variant) => variant.priceMinor!);
const startingPrice = prices.length ? Math.min(...prices) : null;
const warnings = product.variants.filter((variant) => {
  const stock = projectedStock(variant);
  return stock && stock.state !== "available";
});
---

{product.kind === "active" && (
  <div class="product-prices" aria-label="Current variant prices">
    {compact ? (
      <>
        <p class="starting-price">
          {startingPrice === null
            ? "Price unavailable"
            : `${new Set(prices).size > 1 ? "From " : ""}${money(startingPrice)}`}
        </p>
        {showStock && warnings.length > 0 && (
          <ul>
            {warnings.map((variant) => (
              <li>
                <span>{variant.label}</span>
                <StockNotice variant={variant} />
              </li>
            ))}
          </ul>
        )}
      </>
    ) : product.variants.length ? (
      <ul>
        {product.variants.map((variant) => (
          <li>
            <span>
              {variant.label} ·{" "}
              {priced.includes(variant)
                ? money(variant.priceMinor!)
                : "Price not available"}
            </span>
            <StockNotice variant={variant} />
          </li>
        ))}
      </ul>
    ) : (
      <p>Price unavailable</p>
    )}
  </div>
)}

<style>
  .product-prices {
    margin-block: 0.75rem;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  .product-prices ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .starting-price {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
  }
</style>
