---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import NoticePanel from "../components/NoticePanel.astro";
import ServiceCards from "../components/ServiceCards.astro";
import { Image } from "astro:assets";
import hivePhoto from "../assets/honeybees-on-comb.webp";
import { getCatalog, CatalogUnavailableError } from "../server/catalog.ts";
import { readConfig } from "../server/config.ts";

const config = readConfig();
let catalog;
let unavailable = false;
try {
  catalog = await getCatalog(config);
} catch (error) {
  if (!(error instanceof CatalogUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
}
---

<SiteLayout
  title="Good things, a little closer to home"
  description="The True Hive in Madisonville, Tennessee: honeybee colony rescue, farm pollination and a collection of everyday goods."
>
  <section class="home-hero wrap" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="eyebrow">The True Hive / Madisonville, Tennessee</p>
      <h1 id="home-title">
        <span>Good things,</span> <span>a little closer</span> <em>to home.</em>
      </h1>
      <p class="home-hero-description">
        Find your everyday favorite. Explore our soaps, compare ingredients and
        choose the format that fits your routine.
      </p>
      <div class="home-actions">
        <a class="button button-primary" href="/goods">
          Shop the collection <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="text-link" href="/about">
          Our beginning <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
      <p class="fine-print home-hero-note">
        Local pickup in Madisonville, Tennessee, by arrangement.
      </p>
    </div>
    <figure class="home-scene">
      <div class="home-scene-heading" aria-hidden="true">
        <span>A little life in the hive</span>
        <span>&#10033;</span>
      </div>
      <div class="home-scene-art">
        <Image
          src={hivePhoto}
          alt="Honeybees tending golden honeycomb."
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 60rem) 90vw, 44vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        A closer look at the bees and the comb they call home.
      </figcaption>
    </figure>
  </section>
  <section id="goods" class="wrap home-goods" aria-labelledby="goods-title">
    <div class="home-section-heading">
      <div>
        <p class="eyebrow">Shop The True Hive</p>
        <h2 id="goods-title">Everyday favorites.</h2>
      </div>
      <p>
        Explore ingredients, compare formats and find your next favorite bar.
      </p>
    </div>
    {unavailable ? (
      <NoticePanel role="status">
        <h3>The collection is temporarily unavailable.</h3>
        <p>Please try again shortly, or contact us for help.</p>
      </NoticePanel>
    ) : catalog?.products.length ? (
      <div class="product-shelf">
        {catalog.products.slice(0, 3).map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <NoticePanel>
        <h3>No products available.</h3>
        <p>
          Check back soon or <a href="/contact">get in touch</a>.
        </p>
      </NoticePanel>
    )}
    <div class="home-shelf-ending">
      <a class="text-link" href="/goods">
        Shop all products <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
  <section class="home-story" aria-labelledby="home-story-title">
    <div class="wrap home-story-layout">
      <div class="home-story-heading">
        <p class="eyebrow">Our beginning</p>
        <h2 id="home-story-title">
          Rooted in Madisonville.
          <br />
          <em>Connected by bees.</em>
        </h2>
        <p class="home-story-locality">Madisonville, Tennessee</p>
      </div>
      <div class="home-story-copy">
        <span class="home-story-flower" aria-hidden="true">
          &#10033;
        </span>
        <p>
          The True Hive brings soap-making and beekeeping together in
          Madisonville, Tennessee.
        </p>
        <p>
          From everyday goods to honeybee colony rescue and farm pollination,
          our work keeps us connected to our neighbors and the places we call
          home.
        </p>
        <a class="text-link" href="/about">
          Get to know our beginning <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <section class="home-services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="home-section-heading">
        <div>
          <p class="eyebrow">Beyond the collection</p>
          <h2 id="services-title">
            For the bees.
            <br />
            And the neighbors.
          </h2>
        </div>
        <p>
          Explore no-cost colony rescue in Monroe, Blount, and Knox counties,
          and pollination support for farms and growers.
        </p>
      </div>
      <ServiceCards />
    </div>
  </section>
</SiteLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 6rem) 4rem;
  }
  .home-hero-copy h1 {
    margin-block: 1.5rem 1.75rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.85rem, 7.1vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 1.02;
  }
  .home-hero-copy h1 span,
  .home-hero-copy h1 em {
    display: block;
  }
  .home-hero-copy h1 em {
    color: var(--tomato);
    letter-spacing: inherit;
  }
  .home-hero-description {
    max-width: 29rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
  }
  .home-hero-note {
    max-width: 28rem;
    margin-top: 1.25rem;
  }
  .home-scene {
    min-width: 0;
  }
  .home-scene-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.5rem 0.85rem;
    border-bottom: 1px solid var(--forest);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .home-scene-heading > span:last-child {
    color: var(--tomato);
    font-size: 1.7rem;
    line-height: 1;
  }
  .home-scene-art {
    margin-block: 1.5rem;
    filter: drop-shadow(0 0.75rem 1rem rgb(28 59 44 / 12%));
  }
  .home-scene-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.1547;
    object-fit: cover;
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
  }
  .home-scene figcaption {
    max-width: 25rem;
    margin: 0.9rem auto 0;
    font-size: 0.7rem;
    line-height: 1.6;
  }
  .home-goods {
    padding-block: 3rem 5.5rem;
    border-top: 1px solid var(--line);
  }
  .home-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: 2rem;
  }
  .home-section-heading h2 {
    max-width: 35rem;
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1.1;
  }
  .home-section-heading > p {
    max-width: 25rem;
    font-size: 0.9rem;
    line-height: 1.85;
  }
  .home-shelf-ending {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: end;
    margin-top: 1.5rem;
  }
  .home-story {
    padding-block: clamp(3rem, 6vw, 5rem);
    color: var(--paper);
    background: var(--forest);
  }
  .home-story-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: center;
  }
  .home-story-heading h2 {
    margin-block: 1.25rem 2rem;
    font-size: clamp(2.7rem, 4.7vw, 4.6rem);
    line-height: 1.08;
  }
  .home-story-heading h2 em {
    color: var(--ochre);
  }
  .home-story-locality {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .home-story-copy {
    padding-left: 2.5rem;
    border-left: 1px solid var(--line);
  }
  .home-story-flower {
    display: block;
    margin-bottom: 1.2rem;
    color: var(--ochre);
    font-size: 3.5rem;
    line-height: 1;
  }
  .home-story-copy > p {
    max-width: 31rem;
    font-size: 0.95rem;
    line-height: 1.9;
  }
  .home-story-copy .text-link {
    margin-top: 1rem;
  }
  .home-story-copy a:focus-visible {
    outline-color: var(--ochre);
  }
  .home-services {
    padding-block: 4.5rem;
    border-block: 1px solid var(--line);
    background: #eee9dc;
  }
  @media (max-width: 60rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .home-hero-copy {
      max-width: 42rem;
    }
    .home-hero-copy h1 {
      font-size: clamp(2.85rem, 9vw, 5.5rem);
    }
    .home-scene {
      width: min(100%, 35rem);
      margin-inline: auto;
    }
    .home-story-layout {
      gap: 3rem;
    }
    .home-story-copy {
      padding-left: 1.5rem;
    }
  }
  @media (max-width: 42rem) {
    .home-hero {
      padding-block: 2.75rem 3rem;
    }
    .home-goods {
      padding-block: 3rem;
    }
    .home-story-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-story-copy {
      padding: 1.75rem 0 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
    .home-story-flower {
      font-size: 2.5rem;
    }
    .home-story-heading h2 {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }
    .home-services {
      padding-block: 3rem;
    }
  }
</style>
