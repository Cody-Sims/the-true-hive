---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import ContactSection from "../components/ContactSection.astro";
import ServiceCards from "../components/ServiceCards.astro";
import scene from "../../prototypes/assets/market-scene.svg?url";
import { getCatalog, CatalogUnavailableError } from "../server/catalog.ts";
import { readConfig } from "../server/config.ts";

const config = readConfig();
let catalog;
let unavailable = false;
try {
  catalog = await getCatalog(config);
} catch (error) {
  if (!(error instanceof CatalogUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
}
---

<SiteLayout
  title="Good things, gathered here"
  description="The True Hive is building a Madisonville-rooted collection of soaps and future hive goods, with local pickup first and thoughtful beekeeping to come."
>
  <section class="market-hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="asterisk" aria-hidden="true">
          &#10033;
        </span>{" "}
        A local collection in the making
      </p>
      <h1 id="hero-title">
        GOOD THINGS.
        <br />
        GATHERED
        <br />
        <em>HERE.</em>
      </h1>
      <p class="hero-description">
        Soap by the sink. Future honey for the table. A candle for the slow part
        of the day. Meet a little collection with a Madisonville beginning.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/goods">
          Explore the collection <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="text-link" href="#goods">
          See what's on the shelf <span aria-hidden="true">&darr;</span>
        </a>
      </div>
      <p class="fine-print hero-note">
        Local pickup is our first step. Shipping is for later.
      </p>
    </div>
    <figure class="market-scene">
      <div class="scene-ticket">
        <span>THE GOODS</span>
        <strong>
          Made for
          <br />
          the everyday.
        </strong>
      </div>
      <img
        src={scene}
        alt="Original illustration of a striped market stand with honey, soap, and candle concepts."
        width="880"
        height="640"
        fetchpriority="high"
      />
      <figcaption>
        An imagined collection, not an actual market stall or product
        photograph.
      </figcaption>
    </figure>
  </section>
  <div class="market-strip">
    <div class="wrap">
      <span>FROM HIVE TO HOME</span>
      <span aria-hidden="true">&#10033;</span>
      <span>SOAP / HONEY / CANDLES</span>
      <span aria-hidden="true">&#10033;</span>
      <span>A MADISONVILLE BEGINNING</span>
    </div>
  </div>
  <section id="goods" class="wrap section-space" aria-labelledby="goods-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Take a look around</p>
        <h2 id="goods-title">The good-goods shelf.</h2>
      </div>
      <p>
        Begin with soap. Explore future honey and candle directions. Product
        formats and illustrations remain concepts until approved real
        information is published.
      </p>
    </div>
    {unavailable ? (
      <div class="notice" role="status">
        <h3>The collection is temporarily unavailable.</h3>
        <p>
          We couldn't verify catalog information. No sample prices or stock have
          been substituted.
        </p>
      </div>
    ) : catalog?.products.length ? (
      <div class="product-shelf">
        {catalog.products.slice(0, 3).map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <div class="notice">
        <h3>Good things are taking shape.</h3>
        <p>
          No products have been published yet. Check back as the collection
          develops.
        </p>
      </div>
    )}
    <a class="text-link collection-link" href="/goods">
      Meet the whole collection <span aria-hidden="true">&rarr;</span>
    </a>
  </section>
  <section id="pickup" class="pickup-board" aria-labelledby="pickup-title">
    <div class="wrap pickup-layout">
      <div>
        <p class="eyebrow">Close to home, by arrangement</p>
        <h2 id="pickup-title">
          A local start.
          <br />A simple handoff.
        </h2>
        <p>
          Local pickup is the plan for our first online collection. The
          location, timing, and exact arrangements will be confirmed before
          purchasing opens.
        </p>
      </div>
      <ol class="pickup-steps">
        <li>
          <span aria-hidden="true">01</span>
          <div>
            <h3>Explore the goods</h3>
            <p>
              Learn about the collection while real product details are being
              prepared. Nothing is ordered or reserved here.
            </p>
          </div>
        </li>
        <li>
          <span aria-hidden="true">02</span>
          <div>
            <h3>Confirm the details</h3>
            <p>
              Actual availability, payment, and pickup instructions come before
              a purchase, not as a surprise afterward.
            </p>
          </div>
        </li>
        <li>
          <span aria-hidden="true">03</span>
          <div>
            <h3>Keep it close to home</h3>
            <p>
              Pickup comes first. Shipping, public collection hours, and a
              walk-in shop are not offered yet.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <section class="section-space wrap" aria-labelledby="services-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Beyond the market shelf</p>
        <h2 id="services-title">
          For the bees.
          <br />
          And the neighbors.
        </h2>
      </div>
      <p>
        Beekeeping belongs in the story too. These planned services need their
        own careful conversations and confirmed scope.
      </p>
    </div>
    <ServiceCards />
  </section>
  <section class="market-story section-space">
    <div class="wrap story-layout">
      <div class="story-stamp" aria-hidden="true">
        <span>THE TRUE HIVE</span>
        <strong>
          GOOD
          <br />
          NEIGHBOR
          <br />
          ENERGY.
        </strong>
        <span>MADISONVILLE, TN</span>
      </div>
      <div>
        <p class="eyebrow">People before polish</p>
        <h2>
          The hands behind
          <br />
          the hive.
        </h2>
        <p>
          Soap-making, beekeeping, and a small collection of everyday goods. The
          True Hive is taking shape around work we care about and a community
          close to home.
        </p>
        <p>
          Our real product photographs, ingredient information, and making story
          will grow here as the collection is ready.
        </p>
        <a class="text-link" href="/about">
          Meet our beginning <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <ContactSection contact={config.contact} />
</SiteLayout>
