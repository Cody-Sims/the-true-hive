---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import NoticePanel from "../components/NoticePanel.astro";
import ServiceCards from "../components/ServiceCards.astro";
import ProductArt from "../components/ProductArt.astro";
import FaqSection from "../components/FaqSection.astro";
import { Image } from "astro:assets";
import hivePhoto from "../assets/honeybees-on-comb.webp";
import { getCatalog, CatalogUnavailableError } from "../server/catalog.ts";
import { readConfig } from "../server/config.ts";
import { homeSelection } from "../domain/catalog-presentation.ts";
import { money, pricedVariants } from "../domain/cart.ts";
import { getSoapReference } from "../content/soap-references.ts";

const config = readConfig();
let catalog;
let unavailable = false;
try {
  catalog = await getCatalog(config);
} catch (error) {
  if (!(error instanceof CatalogUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
}
const selection = homeSelection(catalog?.products ?? []);
const categories = {
  soap: "Soap",
  honey: "Honey",
  candles: "Candle",
  gifts: "Gift",
};
const hasReferences = selection.hero.some(
  ({ product, variant }) =>
    !product.photo && getSoapReference(product.key, variant?.key),
);
---

<SiteLayout
  title="Small-batch soaps, a little everyday luxury"
  description="Explore The True Hive's soaps and ingredients with local pickup in Madisonville and Vonore, Tennessee. Discover no-cost honeybee rescue and farm pollination."
>
  <section class="home-hero wrap" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="eyebrow">
        Madisonville, Tennessee /{" "}
        {selection.stocked ? "In stock now" : "The collection"}
      </p>
      <h1 id="home-title">
        <span>Small-batch soaps.</span> <em>A little everyday luxury.</em>
      </h1>
      <p class="home-hero-description">
        Find your scent. Explore every ingredient, compare formats, and choose a
        bar for your everyday routine or a sculpted gift.
      </p>
      <div class="home-actions">
        <a class="button button-primary" href="/goods">
          Shop the collection <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="text-link" href="/about">
          Our beginning <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
      <p class="fine-print home-hero-note">
        Local pickup only. See your cart for meetup details and current checkout
        availability.
      </p>
    </div>
    <figure class="home-scene">
      <div class="home-scene-heading" aria-hidden="true">
        <span>
          {selection.stocked ? "Ready for local pickup" : "On the shelf"}
        </span>
        <span>&#10033;</span>
      </div>
      <div class="home-scene-art">
        {selection.hero.length ? (
          selection.hero.map(({ product, variant }, index) => (
            <a
              class="home-product-visual"
              href={`/goods/${encodeURIComponent(product.slug)}${variant && product.kind === "active" ? `?variant=${encodeURIComponent(variant.key)}` : ""}`}
            >
              <ProductArt
                image={product.imageKey}
                photo={product.photo ?? null}
                referenceKey={product.key}
                referenceVariantKey={variant?.key}
                alt={`${categories[product.category]} illustration.`}
                eager={index === 0}
                sizes="(max-width: 60rem) 90vw, 25vw"
              />
              {!product.photo &&
                getSoapReference(product.key, variant?.key) && (
                  <span class="home-reference-note">AI styling reference</span>
                )}
              <span class="home-product-caption">
                <span>{product.title}</span>
                <strong>
                  {variant &&
                  pricedVariants(product).some(
                    (entry) => entry.key === variant.key,
                  )
                    ? `${variant.label} / ${money(variant.priceMinor!)}`
                    : "Product details"}
                </strong>
              </span>
            </a>
          ))
        ) : (
          <ProductArt image="soap" alt="Soap illustration." eager />
        )}
      </div>
      <figcaption>
        {hasReferences
          ? "Images marked AI styling reference are illustrations, not actual product photographs."
          : "Explore product information, ingredients and formats."}
      </figcaption>
    </figure>
  </section>
  <section id="goods" class="wrap home-goods" aria-labelledby="goods-title">
    <div class="home-section-heading">
      <div>
        <p class="eyebrow">
          {selection.stocked
            ? "In stock / Ready for pickup"
            : "Shop The True Hive"}
        </p>
        <h2 id="goods-title">Pick your scent. Pick your shape.</h2>
      </div>
      <p>
        Compare the published ingredients and formats. Prices and availability
        come from our current catalog.
      </p>
    </div>
    {unavailable ? (
      <NoticePanel role="status">
        <h3>The collection is temporarily unavailable.</h3>
        <p>Please try again shortly, or contact us for help.</p>
      </NoticePanel>
    ) : catalog?.products.length ? (
      <div class="product-shelf">
        {selection.featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <NoticePanel>
        <h3>No products available.</h3>
        <p>
          Check back soon or <a href="/contact">get in touch</a>.
        </p>
      </NoticePanel>
    )}
    <div class="home-shelf-ending">
      <a class="text-link" href="/goods">
        Shop all products <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
  <section class="home-story" aria-labelledby="home-story-title">
    <div class="wrap home-story-layout">
      <div class="home-story-heading">
        <p class="eyebrow">Our beginning</p>
        <h2 id="home-story-title">
          Rooted in Madisonville.
          <br />
          <em>Connected by bees.</em>
        </h2>
        <p class="home-story-locality">Madisonville, Tennessee</p>
      </div>
      <div class="home-story-copy">
        <span class="home-story-flower" aria-hidden="true">
          &#10033;
        </span>
        <p>
          The True Hive brings soap-making and beekeeping together in
          Madisonville, Tennessee.
        </p>
        <p>
          From everyday goods to honeybee colony rescue and farm pollination,
          our work keeps us connected to our neighbors and the places we call
          home.
        </p>
        <a class="text-link" href="/about">
          Get to know our beginning <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <section class="home-services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="home-service-intro">
        <Image
          src={hivePhoto}
          alt="Honeybees tending golden honeycomb."
          widths={[480, 800, 1200]}
          sizes="(max-width: 60rem) 90vw, 35vw"
          loading="lazy"
        />
        <div class="home-section-heading">
          <div>
            <p class="eyebrow">Beyond the collection</p>
            <h2 id="services-title">
              For the bees.
              <br />
              And the neighbors.
            </h2>
          </div>
          <p>
            Explore no-cost colony rescue in Monroe, Blount, and Knox counties,
            and pollination support for farms and growers.
          </p>
        </div>
      </div>
      <ServiceCards />
    </div>
  </section>
  <FaqSection />
</SiteLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 6rem) 4rem;
  }
  .home-hero-copy h1 {
    margin-block: 1.5rem 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }
  .home-hero-copy h1 span,
  .home-hero-copy h1 em {
    display: block;
  }
  .home-hero-copy h1 em {
    color: var(--tomato);
    letter-spacing: inherit;
  }
  .home-hero-description {
    max-width: 29rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
  }
  .home-hero-note {
    max-width: 28rem;
    margin-top: 1.25rem;
  }
  .home-scene {
    min-width: 0;
  }
  .home-scene-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.5rem 0.85rem;
    border-bottom: 1px solid var(--forest);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .home-scene-heading > span:last-child {
    color: var(--tomato);
    font-size: 1.7rem;
    line-height: 1;
  }
  .home-scene-art {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 0.85rem;
    margin-block: 1.5rem;
  }
  .home-product-visual {
    position: relative;
    display: block;
    min-height: 180px;
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--golden-shadow);
  }
  .home-product-visual:first-child {
    grid-row: span 2;
    min-height: 374px;
  }
  .home-product-visual :global(.product-illustration) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .home-product-caption {
    position: absolute;
    inset: auto 0.6rem 0.6rem;
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.65rem;
    color: #fff;
    background: rgb(17 18 16 / 86%);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .home-product-caption strong {
    color: #ffd479;
    font-size: 0.7rem;
  }
  .home-reference-note {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.25rem 0.45rem;
    border-radius: 0.3rem;
    color: #fff;
    background: rgb(17 18 16 / 86%);
    font-size: 0.65rem;
  }
  .home-service-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .home-service-intro img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 1rem;
  }
  .home-service-intro .home-section-heading {
    margin: 0;
  }
  .home-scene figcaption {
    max-width: 25rem;
    margin: 0.9rem auto 0;
    font-size: 0.7rem;
    line-height: 1.6;
  }
  .home-goods {
    padding-block: 3rem 5.5rem;
    border-top: 1px solid var(--line);
  }
  .home-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: 2rem;
  }
  .home-section-heading h2 {
    max-width: 35rem;
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1.1;
  }
  .home-section-heading > p {
    max-width: 25rem;
    font-size: 0.9rem;
    line-height: 1.85;
  }
  .home-shelf-ending {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: end;
    margin-top: 1.5rem;
  }
  .home-story {
    padding-block: clamp(3rem, 6vw, 5rem);
    color: var(--inverse-ink, var(--paper));
    background: var(--inverse-surface, var(--forest));
  }
  .home-story-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: center;
  }
  .home-story-heading h2 {
    margin-block: 1.25rem 2rem;
    font-size: clamp(2.7rem, 4.7vw, 4.6rem);
    line-height: 1.08;
  }
  .home-story-heading h2 em {
    color: var(--highlight-ink, var(--ochre));
  }
  .home-story-locality {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .home-story-copy {
    padding-left: 2.5rem;
    border-left: 1px solid var(--line);
  }
  .home-story-flower {
    display: block;
    margin-bottom: 1.2rem;
    color: var(--highlight-ink, var(--ochre));
    font-size: 3.5rem;
    line-height: 1;
  }
  .home-story-copy > p {
    max-width: 31rem;
    font-size: 0.95rem;
    line-height: 1.9;
  }
  .home-story-copy .text-link {
    margin-top: 1rem;
  }
  .home-story-copy a:focus-visible {
    outline-color: var(--highlight-ink, var(--ochre));
  }
  .home-services {
    padding-block: 4.5rem;
    border-block: 1px solid var(--line);
    background: var(--surface);
  }
  @media (max-width: 60rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .home-hero-copy {
      max-width: 42rem;
    }
    .home-hero-copy h1 {
      font-size: clamp(2.2rem, 6vw, 3.7rem);
    }
    .home-scene {
      order: -1;
      width: min(100%, 35rem);
      margin-inline: auto;
    }
    .home-story-layout {
      gap: 3rem;
    }
    .home-service-intro {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-story-copy {
      padding-left: 1.5rem;
    }
  }
  @media (max-width: 42rem) {
    .home-scene-art {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-product-visual:first-child {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 260px;
    }
    .home-hero {
      padding-block: 2.75rem 3rem;
    }
    .home-goods {
      padding-block: 3rem;
    }
    .home-story-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-story-copy {
      padding: 1.75rem 0 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
    .home-story-flower {
      font-size: 2.5rem;
    }
    .home-story-heading h2 {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }
    .home-services {
      padding-block: 3rem;
    }
  }
</style>
