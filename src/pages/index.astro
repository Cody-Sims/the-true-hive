---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import ContactSection from "../components/ContactSection.astro";
import ServiceCards from "../components/ServiceCards.astro";
import { Image } from "astro:assets";
import hivePhoto from "../assets/honeybees-on-comb.webp";
import { getCatalog, CatalogUnavailableError } from "../server/catalog.ts";
import { readConfig } from "../server/config.ts";

const config = readConfig();
let catalog;
let unavailable = false;
try {
  catalog = await getCatalog(config);
} catch (error) {
  if (!(error instanceof CatalogUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
}
---

<SiteLayout
  title="Good things, a little closer to home"
  description="A Madisonville beginning, led by soap. Explore The True Hive's collection, future honey and candle directions, and plans for local pickup."
>
  <section class="home-hero wrap" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="eyebrow">A Madisonville, Tennessee beginning</p>
      <h1 id="home-title">
        <span>Good things,</span> <span>a little closer</span> <em>to home.</em>
      </h1>
      <p class="home-hero-description">
        Everyday goods. A local beginning. Start with soap, then discover the
        honey and candle ideas taking shape around it.
      </p>
      <div class="home-actions">
        <a class="button button-primary" href="/goods">
          Explore the collection <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="text-link" href="/about">
          Our beginning <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
      <p class="fine-print home-hero-note">
        A collection in the making. Online ordering is not open yet.
      </p>
    </div>
    <figure class="home-scene">
      <div class="home-scene-heading" aria-hidden="true">
        <span>A little life in the hive</span>
        <span>&#10033;</span>
      </div>
      <div class="home-scene-art">
        <Image
          src={hivePhoto}
          alt="Honeybees tending golden honeycomb."
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 60rem) 90vw, 44vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        A closer look at the bees and the comb they call home.
      </figcaption>
    </figure>
  </section>
  <section id="goods" class="wrap home-goods" aria-labelledby="goods-title">
    <div class="home-section-heading">
      <div>
        <p class="eyebrow">Discover the collection</p>
        <h2 id="goods-title">A place for the everyday.</h2>
      </div>
      <p>
        Soap is the starting point. Honey and candles are future directions.
        Each product page makes clear what is a concept and what has confirmed
        details.
      </p>
    </div>
    <nav class="home-collection-paths" aria-label="Explore by collection">
      <a href="/goods?category=soap">
        <span>
          <strong>Soap</strong>
          <small>The starting point</small>
        </span>
        <span aria-hidden="true">&nearr;</span>
      </a>
      <a href="/goods?category=honey">
        <span>
          <strong>Honey</strong>
          <small>A future direction</small>
        </span>
        <span aria-hidden="true">&nearr;</span>
      </a>
      <a href="/goods?category=candles">
        <span>
          <strong>Candles</strong>
          <small>A future direction</small>
        </span>
        <span aria-hidden="true">&nearr;</span>
      </a>
    </nav>
    {unavailable ? (
      <div class="notice" role="status">
        <h3>The collection is temporarily unavailable.</h3>
        <p>
          We couldn't verify catalog information. No sample prices or stock have
          been substituted.
        </p>
      </div>
    ) : catalog?.products.length ? (
      <div class="product-shelf">
        {catalog.products.slice(0, 3).map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <div class="notice">
        <h3>Good things are taking shape.</h3>
        <p>
          No products have been published yet. Check back as the collection
          develops.
        </p>
      </div>
    )}
    <div class="home-shelf-ending">
      <p class="fine-print">
        Concepts are a look ahead, not an offer of stock or a reservation.
      </p>
      <a class="text-link" href="/goods">
        See the whole collection <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
  <section class="home-story" aria-labelledby="home-story-title">
    <div class="wrap home-story-layout">
      <div class="home-story-heading">
        <p class="eyebrow">Our beginning</p>
        <h2 id="home-story-title">
          A small collection.
          <br />
          <em>An open story.</em>
        </h2>
        <p class="home-story-locality">Madisonville, Tennessee</p>
      </div>
      <div class="home-story-copy">
        <span class="home-story-flower" aria-hidden="true">
          &#10033;
        </span>
        <p>
          The True Hive begins with soap-making and beekeeping. The next chapter
          is a collection of everyday goods, with local pickup as the first
          step.
        </p>
        <p>
          There's room to grow, without getting ahead of the real details.
          Product information, photographs, and the making story will be shared
          as they are ready.
        </p>
        <a class="text-link" href="/about">
          Get to know our beginning <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
  <section id="pickup" class="wrap home-pickup" aria-labelledby="pickup-title">
    <div class="home-pickup-intro">
      <p class="eyebrow">Local pickup / The plan</p>
      <div class="home-section-heading">
        <h2 id="pickup-title">
          Close to home.
          <br />
          Clear before you go.
        </h2>
        <p>
          Pickup is the planned first step, not an invitation to a walk-in shop.
          The location, timing, and arrangements will be confirmed before
          purchasing opens.
        </p>
      </div>
    </div>
    <ol class="home-pickup-steps">
      <li>
        <span class="home-step-number" aria-hidden="true">
          01
        </span>
        <h3>Find your direction</h3>
        <p>
          Browse the collection and read the details. Looking around does not
          place an order or reserve goods.
        </p>
      </li>
      <li>
        <span class="home-step-number" aria-hidden="true">
          02
        </span>
        <h3>Know what to expect</h3>
        <p>
          Real availability, prices, payment, and pickup instructions must be
          confirmed before a purchase.
        </p>
      </li>
      <li>
        <span class="home-step-number" aria-hidden="true">
          03
        </span>
        <h3>Arrange the handoff</h3>
        <p>
          Once ordering opens, follow the confirmed pickup arrangements.
          Shipping and public shop hours are not offered yet.
        </p>
      </li>
    </ol>
  </section>
  <section class="home-services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="home-section-heading">
        <div>
          <p class="eyebrow">Beyond the collection</p>
          <h2 id="services-title">
            For the bees.
            <br />
            And the neighbors.
          </h2>
        </div>
        <p>
          Beekeeping has a place here, too. Explore two planned service paths,
          each beginning with an assessment of scope and capacity. Neither is
          bookable yet.
        </p>
      </div>
      <ServiceCards />
    </div>
  </section>
  <ContactSection contact={config.contact} />
</SiteLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 6rem) 4rem;
  }
  .home-hero-copy h1 {
    margin-block: 1.5rem 1.75rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.85rem, 7.1vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 1.02;
  }
  .home-hero-copy h1 span,
  .home-hero-copy h1 em {
    display: block;
  }
  .home-hero-copy h1 em {
    color: var(--tomato);
    letter-spacing: inherit;
  }
  .home-hero-description {
    max-width: 29rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
  }
  .home-hero-note {
    max-width: 28rem;
    margin-top: 1.25rem;
  }
  .home-scene {
    min-width: 0;
  }
  .home-scene-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.5rem 0.85rem;
    border-bottom: 1px solid var(--forest);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .home-scene-heading > span:last-child {
    color: var(--tomato);
    font-size: 1.7rem;
    line-height: 1;
  }
  .home-scene-art {
    margin-block: 1.5rem;
    filter: drop-shadow(0 0.75rem 1rem rgb(28 59 44 / 12%));
  }
  .home-scene-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.1547;
    object-fit: cover;
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
  }
  .home-scene figcaption {
    max-width: 25rem;
    margin: 0.9rem auto 0;
    font-size: 0.7rem;
    line-height: 1.6;
  }
  .home-goods {
    padding-block: 3rem 5.5rem;
    border-top: 1px solid var(--line);
  }
  .home-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: 2rem;
  }
  .home-section-heading h2 {
    max-width: 35rem;
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1.1;
  }
  .home-section-heading > p {
    max-width: 25rem;
    font-size: 0.9rem;
    line-height: 1.85;
  }
  .home-collection-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 2rem;
    border-block: 1px solid var(--line);
  }
  .home-collection-paths a {
    display: flex;
    min-width: 0;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.5rem;
    text-decoration: none;
  }
  .home-collection-paths a:first-child {
    padding-left: 0;
  }
  .home-collection-paths a:last-child {
    padding-right: 0;
  }
  .home-collection-paths a + a {
    border-left: 1px solid var(--line);
  }
  .home-collection-paths strong {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1.3;
  }
  .home-collection-paths small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.7rem;
  }
  .home-collection-paths a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-shelf-ending {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
  }
  .home-shelf-ending > p {
    max-width: 29rem;
  }
  .home-story {
    padding-block: clamp(3rem, 6vw, 5rem);
    color: var(--paper);
    background: var(--forest);
  }
  .home-story-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: center;
  }
  .home-story-heading h2 {
    margin-block: 1.25rem 2rem;
    font-size: clamp(2.7rem, 4.7vw, 4.6rem);
    line-height: 1.08;
  }
  .home-story-heading h2 em {
    color: var(--ochre);
  }
  .home-story-locality {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .home-story-copy {
    padding-left: 2.5rem;
    border-left: 1px solid var(--line);
  }
  .home-story-flower {
    display: block;
    margin-bottom: 1.2rem;
    color: var(--ochre);
    font-size: 3.5rem;
    line-height: 1;
  }
  .home-story-copy > p {
    max-width: 31rem;
    font-size: 0.95rem;
    line-height: 1.9;
  }
  .home-story-copy .text-link {
    margin-top: 1rem;
  }
  .home-story-copy a:focus-visible {
    outline-color: var(--ochre);
  }
  .home-pickup {
    padding-block: 5.5rem;
  }
  .home-pickup-intro > .eyebrow {
    color: var(--tomato);
  }
  .home-pickup-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding: 0;
    margin: 2.5rem 0 0;
    list-style: none;
  }
  .home-pickup-steps li {
    padding-top: 1.5rem;
    border-top: 1px solid var(--forest);
  }
  .home-step-number {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--forest);
    border-radius: 50%;
    background: var(--ochre);
    font-size: 0.7rem;
  }
  .home-pickup-steps h3 {
    margin-block: 1.25rem 0.8rem;
    font-size: 1.6rem;
  }
  .home-pickup-steps p {
    max-width: 24rem;
    font-size: 0.85rem;
    line-height: 1.85;
  }
  .home-services {
    padding-block: 4.5rem;
    border-block: 1px solid var(--line);
    background: #eee9dc;
  }
  @media (max-width: 60rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .home-hero-copy {
      max-width: 42rem;
    }
    .home-hero-copy h1 {
      font-size: clamp(2.85rem, 9vw, 5.5rem);
    }
    .home-scene {
      width: min(100%, 35rem);
      margin-inline: auto;
    }
    .home-story-layout {
      gap: 3rem;
    }
    .home-story-copy {
      padding-left: 1.5rem;
    }
  }
  @media (max-width: 42rem) {
    .home-hero {
      padding-block: 2.75rem 3rem;
    }
    .home-goods,
    .home-pickup {
      padding-block: 3rem;
    }
    .home-collection-paths,
    .home-pickup-steps,
    .home-story-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-collection-paths a,
    .home-collection-paths a:first-child,
    .home-collection-paths a:last-child {
      padding: 1rem 0.25rem;
    }
    .home-collection-paths a + a {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
    .home-collection-paths a > span:first-child {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem 1rem;
      align-items: baseline;
    }
    .home-collection-paths strong {
      font-size: 1.45rem;
    }
    .home-story-copy {
      padding: 1.75rem 0 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
    .home-story-flower {
      font-size: 2.5rem;
    }
    .home-story-heading h2 {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }
    .home-pickup-steps {
      gap: 1.5rem;
    }
    .home-pickup-steps h3 {
      margin-top: 1rem;
    }
    .home-services {
      padding-block: 3rem;
    }
  }
</style>
