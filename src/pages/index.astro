---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import NoticePanel from "../components/NoticePanel.astro";
import ServiceCards from "../components/ServiceCards.astro";
import ProductArt from "../components/ProductArt.astro";
import FaqSection from "../components/FaqSection.astro";
import PickupSteps from "../components/PickupSteps.astro";
import { Image } from "astro:assets";
import hivePhoto from "../assets/honeybees-on-comb.webp";
import { getCatalog, CatalogUnavailableError } from "../server/catalog.ts";
import { readConfig } from "../server/config.ts";
import { homeSelection } from "../domain/catalog-presentation.ts";
import { money, pricedVariants, projectedStock } from "../domain/cart.ts";
import { getSoapReference } from "../content/soap-references.ts";
import type { Catalog } from "../domain/catalog.ts";

const config = readConfig();
let catalog: Catalog | undefined;
let unavailable = false;
try {
  catalog = await getCatalog(config);
} catch (error) {
  if (!(error instanceof CatalogUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
}
const selection = homeSelection(catalog?.products ?? []);
const stockedSoapPrices = (catalog?.products ?? [])
  .filter((product) => product.category === "soap")
  .flatMap((product) =>
    pricedVariants(product)
      .filter((variant) =>
        ["available", "low_stock"].includes(
          projectedStock(variant)?.state ?? "",
        ),
      )
      .map((variant) => variant.priceMinor!),
  );
const fromPrice = stockedSoapPrices.length
  ? money(Math.min(...stockedSoapPrices))
  : null;
const hasSignatureSoaps = ["coconut-milk-delight", "the-true-soap"].every(
  (key) =>
    catalog?.products.some(
      (product) => product.key === key && product.kind === "active",
    ),
);
const categories = {
  soap: "Soap",
  honey: "Honey",
  candles: "Candle",
  gifts: "Gift",
};
const hasReferences = selection.hero.some(
  ({ product, variant }) =>
    !product.photo && getSoapReference(product.key, variant?.key),
);
---

<SiteLayout
  title="Small-batch soaps, a little everyday luxury"
  description="Explore The True Hive's soaps and ingredients with local pickup in Madisonville and Vonore, Tennessee. Discover no-cost honeybee rescue and farm pollination."
>
  <section class="home-hero wrap" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="eyebrow">
        Madisonville, Tennessee /{" "}
        {selection.stocked ? "In stock now" : "The collection"}
      </p>
      <h1 id="home-title">
        <span>Small-batch soaps.</span> <span>A little everyday luxury.</span>
      </h1>
      <p class="home-hero-description">
        {hasSignatureSoaps
          ? "Coconut Milk Delight or The True Soap. Find your scent, compare the lather, and choose an everyday bar or sculpted Wolf Mold - with free local pickup along US-411."
          : "Find your scent. Explore every ingredient, compare formats, and choose a bar for your everyday routine or a sculpted gift."}
      </p>
      <div class="home-actions">
        <a
          class="button button-primary"
          href={fromPrice ? "/goods?view=in-stock" : "/goods"}
        >
          {fromPrice
            ? `Shop In-Stock Soaps - From ${fromPrice}`
            : "Shop the collection"}{" "}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="button home-compare" href="#goods">
          Compare the Bars <span aria-hidden="true">&darr;</span>
        </a>
      </div>
      <div class="home-promises">
        <span>Every Ingredient Explained</span>
        <span>Free Local Pickup</span>
        <span>Bars &amp; Gift Molds</span>
      </div>
    </div>
    <figure class="home-scene">
      <div class="home-scene-art">
        {selection.hero.length ? (
          selection.hero.map(({ product, variant }, index) => (
            <a
              class="home-product-visual"
              href={`/goods/${encodeURIComponent(product.slug)}${variant && product.kind === "active" ? `?variant=${encodeURIComponent(variant.key)}` : ""}`}
            >
              <ProductArt
                image={product.imageKey}
                photo={product.photo ?? null}
                referenceKey={product.key}
                referenceVariantKey={variant?.key}
                alt={`${categories[product.category]} illustration.`}
                eager={index === 0}
                sizes="(max-width: 60rem) 90vw, 25vw"
              />
              {!product.photo &&
                getSoapReference(product.key, variant?.key) && (
                  <span class="home-reference-note">AI styling reference</span>
                )}
              <span class="home-product-caption">
                <span>{product.title}</span>
                <strong>
                  {variant &&
                  pricedVariants(product).some(
                    (entry) => entry.key === variant.key,
                  )
                    ? `${variant.label} / ${money(variant.priceMinor!)}`
                    : "Product details"}
                </strong>
              </span>
            </a>
          ))
        ) : (
          <ProductArt image="soap" alt="Soap illustration." eager />
        )}
      </div>
      <figcaption>
        {hasReferences
          ? "Images marked AI styling reference are illustrations, not actual product photographs."
          : "Explore product information, ingredients and formats."}
      </figcaption>
    </figure>
  </section>
  <section
    class="home-trust"
    data-golden-trust
    aria-label="Shopping at The True Hive"
  >
    <div class="wrap trust-grid">
      <div>
        <strong>Ingredient Transparency</strong>
        <span>Read each product's published list</span>
      </div>
      <div>
        <strong>Local Pickup, No Shipping</strong>
        <span>Madisonville and Vonore meetup points</span>
      </div>
      <div>
        <strong>Small-Batch Recipes</strong>
        <span>Compare the current soap collection</span>
      </div>
      <div>
        <strong>Everyday or Gift-Ready</strong>
        <span>Choose from the listed formats</span>
      </div>
    </div>
  </section>
  <section id="goods" class="wrap home-goods" aria-labelledby="goods-title">
    <div class="home-section-heading">
      <div>
        <p class="eyebrow">
          {selection.stocked
            ? "In stock / Ready for pickup"
            : "Shop The True Hive"}
        </p>
        <h2 id="goods-title">Pick your scent. Pick your shape.</h2>
      </div>
      <p>
        Compare the published ingredients and formats. Prices and availability
        come from our current catalog.
      </p>
    </div>
    {unavailable ? (
      <NoticePanel role="status">
        <h3>The collection is temporarily unavailable.</h3>
        <p>Please try again shortly, or contact us for help.</p>
      </NoticePanel>
    ) : catalog?.products.length ? (
      <div class="product-shelf">
        {selection.featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <NoticePanel>
        <h3>No products available.</h3>
        <p>
          Check back soon or <a href="/contact">get in touch</a>.
        </p>
      </NoticePanel>
    )}
    <div class="home-shelf-ending">
      <a class="text-link" href="/goods">
        Shop all products <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
  <PickupSteps />
  <section class="home-services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="home-service-intro">
        <figure class="home-apiary-photo">
          <Image
            src={hivePhoto}
            alt="Honeybees tending golden honeycomb."
            widths={[480, 800, 1200]}
            sizes="(max-width: 60rem) 90vw, 35vw"
            loading="lazy"
          />
          <figcaption>Our beekeeping work &middot; East Tennessee</figcaption>
        </figure>
        <div class="home-section-heading">
          <div>
            <p class="eyebrow">Beyond the collection</p>
            <h2 id="services-title">For the bees. And our neighbors.</h2>
          </div>
          <p>
            A different side of The True Hive: saving live colonies and
            supporting local growers with farm pollination across East
            Tennessee.
          </p>
        </div>
      </div>
      <ServiceCards />
    </div>
  </section>
  <FaqSection />
</SiteLayout>

<style>
  .home-promises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }
  .home-promises span {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--forest);
    font-size: 0.73rem;
    font-weight: 700;
  }
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2.5rem, 4.5vw, 4rem);
  }
  .home-hero-copy h1 {
    margin-block: 0.5rem 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.07;
  }
  .home-hero-copy h1 span {
    display: block;
  }
  .home-compare {
    color: var(--forest);
    background: var(--white);
    border-color: var(--line);
  }
  .home-trust {
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    background: var(--white);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .trust-grid strong,
  .trust-grid span {
    display: block;
  }
  .trust-grid strong {
    font-size: 0.9rem;
  }
  .trust-grid span {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }
  .home-hero-description {
    max-width: 29rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
  }
  .home-hero-note {
    max-width: 28rem;
    margin-top: 1.25rem;
  }
  .home-scene {
    min-width: 0;
  }
  .home-scene-art {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 0.85rem;
    margin-block: 0;
  }
  .home-product-visual {
    position: relative;
    display: block;
    min-height: 150px;
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--golden-shadow);
  }
  .home-product-visual:first-child {
    grid-row: span 2;
    min-height: 310px;
  }
  .home-product-visual :global(.product-illustration) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .home-product-caption {
    position: absolute;
    inset: auto 0.6rem 0.6rem;
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.65rem;
    color: #fff;
    background: rgb(17 18 16 / 86%);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .home-product-caption strong {
    color: #ffd479;
    font-size: 0.7rem;
  }
  .home-reference-note {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.25rem 0.45rem;
    border-radius: 0.3rem;
    color: #fff;
    background: rgb(17 18 16 / 86%);
    font-size: 0.65rem;
  }
  .home-service-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .home-service-intro img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 1rem;
  }
  .home-service-intro .home-section-heading {
    margin: 0;
    display: grid;
  }
  .home-apiary-photo {
    margin: 0;
  }
  .home-apiary-photo figcaption {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .home-scene figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .home-goods {
    padding-block: 3rem 5.5rem;
    border-top: 1px solid var(--line);
  }
  .home-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: 2rem;
  }
  .home-section-heading h2 {
    max-width: none;
    margin-top: 0.75rem;
    font-size: clamp(1.75rem, 3.2vw, 2.55rem);
    line-height: 1.1;
  }
  .home-section-heading > p {
    max-width: 25rem;
    font-size: 0.9rem;
    line-height: 1.85;
  }
  .home-shelf-ending {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: end;
    margin-top: 1.5rem;
  }
  .home-services {
    padding-block: 4.5rem;
    border-block: 1px solid var(--line);
    background: var(--surface);
  }
  @media (max-width: 940px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .home-hero-copy {
      max-width: 42rem;
    }
    .home-hero-copy h1 {
      font-size: clamp(2.2rem, 6vw, 3.7rem);
    }
    .home-scene {
      width: min(100%, 35rem);
      order: -1;
      margin-inline: auto;
    }
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-service-intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 42rem) {
    .home-scene-art {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-product-visual:first-child {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 260px;
    }
    .home-hero {
      padding-block: 2.75rem 3rem;
    }
    .home-goods {
      padding-block: 3rem;
    }
    .home-services {
      padding-block: 3rem;
    }
  }
</style>
