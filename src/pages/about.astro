---
import SiteLayout from "../layouts/SiteLayout.astro";
import hivePhoto from "../assets/honeybees-on-comb.webp?url";
---

<SiteLayout
  title="About The True Hive"
  description="Get to know The True Hive in Madisonville, Tennessee: colony rescue, farm pollination and everyday goods with a local connection."
>
  <section class="wrap story-page-intro" aria-labelledby="story-page-title">
    <div class="story-page-opening">
      <div>
        <p class="eyebrow">About us / Madisonville, Tennessee</p>
        <h1 id="story-page-title">
          Local roots.
          <br />
          <em>A love for bees.</em>
        </h1>
        <p class="story-page-lede">
          Bringing people, honeybees and the places we call home a little closer
          together.
        </p>
        <a class="text-link" href="/goods">
          Get to know the goods <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <figure class="story-page-illustration">
        <img
          src={hivePhoto}
          alt="Honeybees tending golden honeycomb."
          width="1600"
          height="2133"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Honeybees on the comb.</figcaption>
      </figure>
    </div>
  </section>
  <section
    class="wrap story-page-beginning"
    aria-labelledby="story-page-beginning-title"
  >
    <div class="story-page-margin">
      <p class="eyebrow">01 / Close to home</p>
      <p class="story-page-place">
        Madisonville,
        <br />
        <em>Tennessee.</em>
      </p>
    </div>
    <div class="story-page-narrative">
      <h2 id="story-page-beginning-title">
        Close to home.
        <br />
        Connected by bees.
      </h2>
      <p>
        Based in Madisonville, Tennessee, The True Hive brings soap-making and
        beekeeping together with a local connection. Our services help honeybee
        colonies find a new home and support pollination on farms.
      </p>
      <p>
        Whether you have bees on your property, crops that need pollination, or
        an interest in the goods we make, we'd love to hear from you.
      </p>
    </div>
  </section>
  <section
    class="story-page-directions"
    aria-labelledby="story-page-directions-title"
  >
    <div class="wrap">
      <div class="story-page-section-heading">
        <p class="eyebrow">02 / What we do</p>
        <h2 id="story-page-directions-title">
          Care for the bees.
          <br />
          <em>A local connection.</em>
        </h2>
      </div>
      <div class="story-page-collection">
        <article>
          <span class="story-page-index" aria-hidden="true">
            01
          </span>
          <h3>Colony Rescue</h3>
          <p>
            No-cost honeybee relocation for homes and properties in Monroe,
            Blount, and Knox counties.
          </p>
          <a class="text-link" href="/services#colony-removal">
            Explore colony rescue <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
        <article>
          <span class="story-page-index" aria-hidden="true">
            02
          </span>
          <h3>Farm Pollination</h3>
          <p>
            We bring our bees to your farm, with an assessment of your location,
            crops, hive needs and timing.
          </p>
          <a class="text-link" href="/services#farm-pollination">
            Explore pollination <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
        <article>
          <span class="story-page-index" aria-hidden="true">
            03
          </span>
          <h3>Everyday goods</h3>
          <p>
            Explore the collection and read individual product descriptions for
            details about each item.
          </p>
          <a class="text-link" href="/goods">
            See the collection <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      </div>
    </div>
  </section>
  <section class="wrap story-page-next" aria-labelledby="story-page-next-title">
    <div>
      <p class="eyebrow">03 / Get in touch</p>
      <h2 id="story-page-next-title">
        Tell us about
        <br />
        <em>your hive or farm.</em>
      </h2>
    </div>
    <div class="story-page-next-copy">
      <p>
        For a colony rescue, have the address, hive location and a good time for
        a visit ready. For pollination, tell us about the land, crops, number of
        hives and preferred inspection day.
      </p>
      <p>Start with a conversation so we can talk through what you need.</p>
      <div class="story-page-actions">
        <a class="button button-primary" href="/contact">
          Contact The True Hive <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="text-link" href="/services">
          Explore our services <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .story-page-intro {
    padding-block: clamp(3rem, 6vw, 5.5rem) 4rem;
  }
  .story-page-opening {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .story-page-opening h1 {
    margin-block: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1.08;
  }
  .story-page-opening h1 em {
    letter-spacing: inherit;
  }
  .story-page-lede {
    max-width: 29rem;
    font-size: 1.05rem;
    line-height: 1.9;
  }
  .story-page-opening .text-link {
    margin-top: 1.5rem;
  }
  .story-page-illustration {
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--forest);
  }
  .story-page-illustration img {
    width: 100%;
    height: auto;
    aspect-ratio: 1.2;
    object-fit: cover;
    border-radius: 45% 45% 0 0;
    background: var(--surface);
  }
  .story-page-illustration figcaption {
    max-width: 25rem;
    margin: 0.9rem auto 0;
    font-size: 0.7rem;
    line-height: 1.7;
  }
  .story-page-beginning,
  .story-page-next {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2rem 5rem;
    padding-block: 4.5rem 5.5rem;
    border-top: 1px solid var(--line);
  }
  .story-page-place {
    margin-top: 2rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.3;
  }
  .story-page-place em {
    color: var(--tomato);
  }
  .story-page-narrative h2,
  .story-page-next h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.2rem, 3.8vw, 3.5rem);
    line-height: 1.12;
  }
  .story-page-narrative > p,
  .story-page-next-copy > p {
    max-width: 37rem;
    font-size: 0.95rem;
    line-height: 1.95;
  }
  .story-page-directions {
    padding-block: 4.5rem;
    color: var(--forest);
    background: var(--surface);
  }
  .story-page-section-heading {
    margin-bottom: 3rem;
  }
  .story-page-section-heading h2 {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 4.7vw, 4.25rem);
    line-height: 1.1;
  }
  .story-page-section-heading h2 em {
    color: var(--tomato);
  }
  .story-page-collection {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem;
  }
  .story-page-collection article {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .story-page-index {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .story-page-collection h3 {
    margin-block: 1.5rem 1rem;
    font-size: 1.8rem;
    line-height: 1.2;
  }
  .story-page-collection p {
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
    line-height: 1.95;
  }
  .story-page-collection .text-link {
    margin-top: auto;
  }
  .story-page-collection a:focus-visible {
    outline-color: var(--forest);
  }
  .story-page-next {
    padding-top: 5rem;
    border-top: 0;
  }
  .story-page-next h2 {
    margin-top: 1rem;
  }
  .story-page-next h2 em {
    color: var(--tomato);
  }
  .story-page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
  }
  @media (max-width: 56rem) {
    .story-page-opening {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .story-page-opening > div {
      max-width: 40rem;
    }
    .story-page-illustration {
      width: min(100%, 33rem);
      margin-inline: auto;
    }
    .story-page-beginning,
    .story-page-next {
      gap: 2rem;
    }
    .story-page-collection {
      gap: 1.5rem;
    }
  }
  @media (max-width: 42rem) {
    .story-page-intro {
      padding-block: 3rem;
    }
    .story-page-opening h1 {
      font-size: clamp(2.75rem, 9.5vw, 4rem);
    }
    .story-page-beginning,
    .story-page-next,
    .story-page-collection {
      grid-template-columns: minmax(0, 1fr);
    }
    .story-page-beginning,
    .story-page-next,
    .story-page-directions {
      padding-block: 3rem;
    }
    .story-page-place {
      margin-top: 1rem;
    }
    .story-page-collection {
      gap: 2rem;
    }
    .story-page-collection h3 {
      margin-top: 1rem;
    }
    .story-page-section-heading {
      margin-bottom: 2rem;
    }
  }
</style>
