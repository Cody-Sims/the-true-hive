---
import SiteLayout from "../layouts/SiteLayout.astro";
import hivePhoto from "../assets/honeybees-on-comb.webp?url";
---

<SiteLayout
  title="About The True Hive"
  description="Get to know The True Hive in Madisonville, Tennessee: small-batch soaps, no-cost colony rescue, and farm pollination."
>
  <section
    class="wrap golden-about"
    data-golden-about
    aria-labelledby="about-title"
  >
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">About Us</span>
    </nav>
    <div class="about-grid">
      <div>
        <p class="eyebrow">Madisonville, Tennessee</p>
        <h1 id="about-title">Local roots. Real beeswax. Connected by bees.</h1>
        <p>
          Based in Madisonville, Tennessee, The True Hive brings small-batch
          soap-making and working beekeeping together, from everyday goods to
          <a href="/services#colony-removal">Colony Rescue</a> at no cost and
          <a href="/services#farm-pollination">Farm Pollination</a> across East
          Tennessee.
        </p>
        <p>
          Whether you have bees on your property, crops that need pollination,
          or an interest in the goods we make, we'd love to hear from you.
        </p>
        <div class="about-actions">
          <a class="button button-primary" href="/goods?category=soap">
            Shop the Soaps
          </a>
          <a class="button" href="/services">
            Explore Bee Services
          </a>
        </div>
      </div>
      <figure>
        <img
          src={hivePhoto}
          alt="Honeybees tending golden honeycomb."
          width="1600"
          height="2133"
          decoding="async"
        />
        <figcaption>Our beekeeping work / East Tennessee</figcaption>
      </figure>
    </div>
  </section>
</SiteLayout>

<style>
  .golden-about {
    padding-block: 2rem 4rem;
  }
  .breadcrumbs {
    margin-bottom: 1.5rem;
  }
  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: center;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.1;
    margin-block: 0.75rem 1rem;
  }
  p {
    color: var(--muted);
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.2rem;
  }
  .about-actions .button:not(.button-primary) {
    background: var(--white);
    color: var(--forest);
    border-color: var(--line);
  }
  figure {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--white);
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  figcaption {
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
