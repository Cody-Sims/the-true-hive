---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ActionLink from "../components/ActionLink.astro";
import { readConfig } from "../server/config.ts";
const { contact } = readConfig();
---

<SiteLayout
  title="Privacy and contact"
  description="How The True Hive handles website browsing, collection searches and contact links."
>
  <PageIntro
    eyebrow="Keep things clear"
    headingId="privacy-title"
    description="This page explains the information involved in browsing The True Hive, searching the collection and following our contact links."
  >
    <Fragment slot="heading">
      Privacy,
      <br />
      <em>without surprises.</em>
    </Fragment>
  </PageIntro>
  <section class="wrap prose-section">
    <h2>Browsing this site</h2>
    <p>
      This website uses no advertising pixels, embedded social feeds or
      first-party customer analytics. Our hosting provider, Render, processes
      page requests and may keep access or security logs to operate and protect
      the website.
    </p>
    <p>
      See <a href="https://render.com/privacy">Render's privacy policy</a>
      for information about the hosting provider's practices.
    </p>
    <h2>Collection search</h2>
    <p>
      Collection search uses a public GET request. Search terms and category
      filter choices are included in the URL, so they can appear in browser
      history, copied or shared links, and potentially hosting access or
      security logs.
    </p>
    <p>
      The application creates no search profile or search-history storage of its
      own. Avoid entering sensitive information in the collection search.
      Clearing the filters changes the results; it does not erase previously
      recorded URLs or request logs.
    </p>
    <h2>Email drafts and other contact options</h2>
    <p>
      The contact form prepares a plain-text email draft in your own email app.
      Nothing is sent by this website, and no inbox or email provider receives a
      website submission. The website does not save your form details to a
      database or local storage. You must review and send the draft yourself;
      your email provider's privacy practices then apply. Your browser, device
      or email app may retain draft information under its own settings.
    </p>
    <p>
      If no email app opens or the draft is too long for an email link, copy the
      displayed email address and your details into your email service. No
      booking or availability is confirmed by preparing a draft. Please avoid
      sharing home or site addresses, sensitive details or photos in an initial
      inquiry.
    </p>
    <p>
      Telephone links open your device's calling tools. Calls and any
      information you choose to share during them are handled outside this
      website, rather than through a website submission form.
    </p>
    <p>
      When you follow a link to a social platform, research publisher or other
      external website, that provider's privacy practices apply.
    </p>
    <ActionLink href={contact.phoneHref} arrow>
      Call {contact.phone}
    </ActionLink>
    <h2>Restricted inventory workspace</h2>
    <p>
      The inventory workspace is restricted to authorized administrators and
      uses separate authentication and security cookies. Its sign-in process is
      separate from public browsing.
    </p>
    <h2>Shopping</h2>
    <p>
      Your cart uses browser storage on this device for selected variant
      identifiers and quantities, not customer details or authoritative prices.
      The cart refreshes current catalog information when you review it. Browser
      storage can be unavailable or cleared by your browser.
    </p>
    <p>
      A pending test checkout may keep a request identifier and its selected
      variants and quantities in this tab's session storage so a retry can use
      the same request. This is not a payment confirmation. Clearing a cart,
      closing a tab or clearing browser storage does not cancel a server order
      or release a stock hold.
    </p>
    <p>
      When test checkout is enabled, payment details are entered on Stripe's
      hosted test page, not in a card form on this website. Use Stripe's test
      details, not a real payment card. See
      <a href="https://stripe.com/privacy">Stripe's privacy policy</a>
      for its practices.
    </p>
  </section>
</SiteLayout>
