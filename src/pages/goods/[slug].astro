---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductArt from "../../components/ProductArt.astro";
import TestCheckout from "../../components/TestCheckout.astro";
import {
  getProduct,
  getAvailability,
  CatalogUnavailableError,
} from "../../server/catalog.ts";
import { readConfig } from "../../server/config.ts";
import { getCheckoutPresentation } from "../../server/commerce/stripe.ts";
import type { Availability } from "../../domain/catalog.ts";
import { isRecordKey } from "../../server/inventory/rules.ts";

const categories = {
  soap: "Soap",
  honey: "Honey",
  candles: "Candles",
  gifts: "Gifts",
};
const config = readConfig();
const checkout =
  config.catalogSource === "database"
    ? getCheckoutPresentation()
    : { enabled: false, locationKey: null };
let product = null;
let unavailable = false;
if (isRecordKey(Astro.params["slug"])) {
  try {
    product = await getProduct(config, Astro.params["slug"]);
  } catch (error) {
    if (!(error instanceof CatalogUnavailableError)) throw error;
    unavailable = true;
  }
}
if (!product) Astro.response.status = unavailable ? 503 : 404;
const availability: Record<string, Availability["state"] | "unverified"> = {};
const testCheckoutEnabled =
  checkout.enabled &&
  !!checkout.locationKey &&
  product?.kind === "active" &&
  product.variants.some(
    (variant) => (variant.priceMinor ?? 0) > 0 && variant.currency === "USD",
  );
if (testCheckoutEnabled && product && checkout.locationKey) {
  await Promise.all(
    product.variants
      .filter(
        (variant) =>
          (variant.priceMinor ?? 0) > 0 && variant.currency === "USD",
      )
      .map(async (variant) => {
        try {
          availability[variant.key] =
            (await getAvailability(config, variant.key, checkout.locationKey!))
              ?.state ?? "unverified";
        } catch {
          availability[variant.key] = "unverified";
        }
      }),
  );
}
---

<SiteLayout
  title={
    product?.title ??
    (unavailable ? "Collection unavailable" : "Product not found")
  }
  description={
    product?.summary ??
    "Return to The True Hive collection to explore published product information."
  }
  notFound={!product}
>
  <div class="wrap product-detail">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/goods">The goods</a>
      {product && (
        <>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{product.title}</span>
        </>
      )}
    </nav>
    {product ? (
      <div class="detail-layout">
        <figure class:list={["detail-art", `${product.imageKey}-art`]}>
          <div class="detail-art-heading">
            <span class="eyebrow">{categories[product.category]}</span>
            <span class="art-flower" aria-hidden="true">
              ✳
            </span>
          </div>
          <div class="detail-illustration">
            <ProductArt
              image={product.imageKey}
              alt={`Original concept illustration for ${product.title}.`}
              eager
            />
          </div>
          <figcaption>
            Original illustration, not an approved product photograph.
          </figcaption>
        </figure>
        <section class="detail-copy" aria-labelledby="product-title">
          <div class="detail-overline">
            <p class="eyebrow">The True Hive collection</p>
            <a
              class="detail-category"
              href={`/goods?category=${product.category}`}
            >
              Explore {categories[product.category].toLowerCase()}
              <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
          <h1 id="product-title">{product.title}</h1>
          <div class="product-status">
            <span class="pill">
              {product.kind === "concept"
                ? "Concept product"
                : "Product information"}
            </span>
          </div>
          <p class="detail-summary">{product.summary}</p>
          {product.details.length > 0 && (
            <section
              class="product-notes"
              aria-labelledby="product-notes-title"
            >
              <h2 id="product-notes-title">A closer look.</h2>
              <ul>
                {product.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </section>
          )}
          {testCheckoutEnabled ? (
            <TestCheckout
              product={product}
              enabled
              availability={availability}
            />
          ) : (
            <div class="notice">
              <h2>Good things take a little care.</h2>
              <p>
                Online ordering isn't open yet. Real formats, labels,
                availability, and pickup instructions will be confirmed before
                sales begin.
              </p>
            </div>
          )}
          <div class="detail-links">
            <a class="text-link" href="/#connect">
              Find our contact channels <span aria-hidden="true">&rarr;</span>
            </a>
            <a class="text-link" href="/goods">
              Back to all goods <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
        </section>
      </div>
    ) : (
      <section class="not-found">
        <p class="eyebrow">The collection</p>
        <h1>
          {unavailable
            ? "The collection needs another moment."
            : "That good isn't on the shelf."}
        </h1>
        <p>
          {unavailable
            ? "Catalog information could not be verified. Please try again later."
            : "This product may not be published. Explore the current collection instead."}
        </p>
        <a class="button button-primary" href="/goods">
          Back to the collection <span aria-hidden="true">&rarr;</span>
        </a>
      </section>
    )}
  </div>
</SiteLayout>

<style>
  .product-detail {
    padding-block: 1.5rem 5rem;
  }
  .breadcrumbs {
    gap: 0.3rem 0.65rem;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
    font-size: 0.75rem;
  }
  .breadcrumbs > span[aria-current] {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .detail-layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .detail-art {
    min-width: 0;
    padding: clamp(1rem, 2.5vw, 2rem);
    border: 0;
    border-radius: 0.2rem;
  }
  .soap-art {
    background: #e8e9dc;
  }
  .honey-art {
    background: #f3e4b7;
  }
  .candle-art {
    background: #efdfd2;
  }
  .detail-art-heading {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .art-flower {
    font-size: 2rem;
    line-height: 1;
  }
  .detail-illustration {
    position: relative;
    isolation: isolate;
    padding-block: clamp(0.5rem, 2vw, 2rem);
  }
  .detail-illustration::before {
    position: absolute;
    z-index: -1;
    inset: 12% 6%;
    border: 1px solid var(--forest);
    border-radius: 50%;
    opacity: 0.16;
    content: "";
  }
  .detail-art figcaption {
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-color: var(--line);
    font-size: 0.7rem;
    text-align: left;
  }
  .detail-copy {
    min-width: 0;
  }
  .detail-overline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .detail-category {
    display: inline-flex;
    min-height: 2.75rem;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.75rem;
  }
  .detail-copy h1 {
    margin-top: 0.8rem;
    font-size: clamp(2.6rem, 4.5vw, 4.5rem);
    line-height: 1.04;
  }
  .product-status {
    margin-top: 1.1rem;
  }
  .product-status .pill {
    margin: 0;
    padding: 0.4rem 0.65rem;
    border-color: var(--line);
    border-radius: 0.15rem;
    font-size: 0.62rem;
  }
  .detail-copy > .detail-summary {
    margin-top: 1.5rem;
    font-size: 1.02rem;
    line-height: 1.8;
  }
  .product-notes {
    margin-top: 2rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }
  .product-notes h2 {
    font-size: 1.7rem;
    letter-spacing: -0.035em;
  }
  .product-notes ul {
    margin-block: 1rem 0;
    padding-left: 1rem;
    font-size: 0.88rem;
  }
  .product-notes li {
    padding-left: 0.3rem;
  }
  .product-notes li::marker {
    color: var(--tomato);
  }
  .detail-copy .notice {
    margin-block: 2rem 1rem;
    padding: 1.25rem 1.4rem;
    background: transparent;
  }
  .detail-copy .notice h2 {
    font-size: 1.6rem;
  }
  .detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .detail-links .text-link {
    font-size: 0.8rem;
  }
  .not-found {
    max-width: 48rem;
    padding-block: clamp(2rem, 7vw, 6rem);
  }
  .not-found h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    line-height: 1.04;
  }
  @media (max-width: 700px) {
    .product-detail {
      padding-bottom: 3.5rem;
    }
    .detail-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .detail-copy h1 {
      font-size: clamp(2.6rem, 10vw, 3.8rem);
    }
  }
</style>
