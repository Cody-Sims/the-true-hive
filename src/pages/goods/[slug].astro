---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import AddToCart from "../../components/AddToCart.astro";
import ProductPrices from "../../components/ProductPrices.astro";
import ProductIngredients from "../../components/ProductIngredients.astro";
import ProductProfile from "../../components/ProductProfile.astro";
import {
  getProduct,
  getCatalog,
  CatalogUnavailableError,
} from "../../server/catalog.ts";
import { money, pricedVariants, projectedStock } from "../../domain/cart.ts";
import ProductCard from "../../components/ProductCard.astro";
import { prioritizeProducts } from "../../domain/catalog-presentation.ts";
import { soapSensoryProfile } from "../../content/soap-sensory.ts";
import { readConfig } from "../../server/config.ts";
import { isRecordKey } from "../../server/inventory/rules.ts";

const categories = {
  soap: "Soap",
  honey: "Honey",
  candles: "Candles",
  gifts: "Gifts",
};
const config = readConfig();
let product = null;
let unavailable = false;
if (isRecordKey(Astro.params["slug"])) {
  try {
    product = await getProduct(config, Astro.params["slug"]);
  } catch (error) {
    if (!(error instanceof CatalogUnavailableError)) throw error;
    unavailable = true;
  }
}
if (!product) Astro.response.status = unavailable ? 503 : 404;
const preferredVariantKey =
  Astro.url.searchParams.getAll("variant").length === 1
    ? (Astro.url.searchParams.get("variant") ?? undefined)
    : undefined;
const offered = product
  ? pricedVariants(product).filter(
      (variant) =>
        !["out_of_stock", "not_offered"].includes(
          projectedStock(variant)?.state ?? "",
        ),
    )
  : [];
const selected =
  offered.find((variant) => variant.key === preferredVariantKey) ?? offered[0];
const sensory =
  product?.kind === "active" && product.category === "soap"
    ? soapSensoryProfile(product.key)
    : null;
let related = null;
if (product?.category === "soap") {
  try {
    related =
      prioritizeProducts((await getCatalog(config)).products).find(
        (entry) => entry.category === "soap" && entry.key !== product.key,
      ) ?? null;
  } catch (error) {
    if (!(error instanceof CatalogUnavailableError)) throw error;
  }
}
---

<SiteLayout
  title={
    product?.title ??
    (unavailable ? "Collection unavailable" : "Product not found")
  }
  description={
    product?.summary ??
    "Return to The True Hive collection to explore published product information."
  }
  notFound={!product}
>
  <div class="wrap product-detail">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/goods">Store</a>
      {product && (
        <>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{product.title}</span>
        </>
      )}
    </nav>
    {product ? (
      <div class="detail-layout" data-product-detail>
        <ProductGallery
          product={product}
          preferredVariantKey={preferredVariantKey}
        />
        <section class="detail-copy" aria-labelledby="product-title">
          <div class="detail-overline">
            <p class="eyebrow">The True Hive collection</p>
            <a
              class="detail-category"
              href={`/goods?category=${product.category}`}
            >
              Explore {categories[product.category].toLowerCase()}
              <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
          <h1 id="product-title">{product.title}</h1>
          {product.kind === "concept" && (
            <div class="product-status">
              <span class="pill">Concept product</span>
            </div>
          )}
          {selected ? (
            <p class="selected-detail-price">
              <strong data-detail-price>{money(selected.priceMinor!)}</strong>{" "}
              <span data-detail-format>{selected.label}</span>
            </p>
          ) : (
            <ProductPrices product={product} compact showStock={false} />
          )}
          <p class="detail-summary">{sensory?.story ?? product.summary}</p>
          <ProductProfile product={product} />
          <AddToCart
            product={product}
            preferredVariantKey={preferredVariantKey}
            showPrice
          />
          {product.details.length > 0 && (
            <section
              class="product-notes"
              aria-labelledby="product-notes-title"
            >
              <h2 id="product-notes-title">Product details</h2>
              <ul>
                {product.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </section>
          )}
          <div class="detail-links">
            <a class="text-link" href="/goods">
              Back to all goods <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
        </section>
      </div>
    ) : (
      <section class="not-found">
        <p class="eyebrow">The collection</p>
        <h1>
          {unavailable
            ? "Product information is unavailable."
            : "That good isn't on the shelf."}
        </h1>
        <p>
          {unavailable
            ? "Catalog information could not be verified. Please try again later."
            : "We couldn't find this product. Explore the collection instead."}
        </p>
        <a class="button button-primary" href="/goods">
          Back to the collection <span aria-hidden="true">&rarr;</span>
        </a>
      </section>
    )}
    {product && (
      <ProductIngredients
        ingredients={product.ingredients ?? []}
        grid
        productTitle={product.title}
        soapRecipe={product.category === "soap"}
      />
    )}
    {related && (
      <section class="related-soap" aria-label="Pair your pickup">
        <p class="eyebrow">Pair Your Pickup</p>
        <ProductCard product={related} />
      </section>
    )}
  </div>
</SiteLayout>

<style>
  .product-detail {
    padding-block: 1.5rem 5rem;
  }
  .breadcrumbs {
    gap: 0.3rem 0.65rem;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
    font-size: 0.75rem;
  }
  .breadcrumbs > span[aria-current] {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .detail-layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem;
  }
  .detail-copy {
    min-width: 0;
  }
  .detail-overline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .detail-category {
    display: inline-flex;
    min-height: 2.75rem;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.75rem;
  }
  .detail-copy h1 {
    margin-top: 0.8rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.04;
  }
  .product-status {
    margin-top: 1.1rem;
  }
  .selected-detail-price {
    margin-block: 0.5rem 1rem;
  }
  .selected-detail-price strong {
    font-size: 1.55rem;
    color: var(--tomato);
  }
  .selected-detail-price span {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .related-soap {
    max-width: 35rem;
    margin-top: 2.6rem;
  }
  .product-status .pill {
    margin: 0;
    padding: 0.4rem 0.65rem;
    border-color: var(--line);
    border-radius: 0.15rem;
    font-size: 0.62rem;
  }
  .detail-copy > .detail-summary {
    margin-top: 1.5rem;
    font-size: 1.02rem;
    line-height: 1.8;
  }
  .product-notes {
    margin-top: 1rem;
  }
  .product-notes h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .product-notes ul {
    margin-block: 1rem 0;
    padding-left: 1rem;
    font-size: 0.88rem;
  }
  .product-notes li {
    padding-left: 0.3rem;
  }
  .product-notes li::marker {
    color: var(--tomato);
  }
  .detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .detail-links .text-link {
    font-size: 0.8rem;
  }
  .not-found {
    max-width: 48rem;
    padding-block: clamp(2rem, 7vw, 6rem);
  }
  .not-found h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    line-height: 1.04;
  }
  @media (max-width: 700px) {
    .product-detail {
      padding-bottom: 3.5rem;
    }
    .detail-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .detail-copy h1 {
      font-size: clamp(2.6rem, 10vw, 3.8rem);
    }
  }
</style>
