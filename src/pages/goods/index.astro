---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import PickupLocation from "../../components/PickupLocation.astro";
import { getCatalog, CatalogUnavailableError } from "../../server/catalog.ts";
import { readConfig } from "../../server/config.ts";
import { getCheckoutPresentation } from "../../server/commerce/config.ts";
import { getStorefrontStatus } from "../../server/storefront.ts";
import type { Catalog, ProductCategory } from "../../domain/catalog.ts";

const collections: { value: ProductCategory | "all"; label: string }[] = [
  { value: "all", label: "All goods" },
  { value: "soap", label: "Soap" },
  { value: "honey", label: "Honey" },
  { value: "candles", label: "Candles" },
  { value: "gifts", label: "Gifts" },
];
const params = Astro.url.searchParams;
const requestedCategory = params.get("category") ?? "all";
const requestedQuery = params.get("q") ?? "";
const categoryInvalid =
  params.getAll("category").length > 1 ||
  !collections.some((collection) => collection.value === requestedCategory);
const queryTooLong = requestedQuery.length > 80;
const queryInvalid =
  params.getAll("q").length > 1 ||
  queryTooLong ||
  /[\u0000-\u001f\u007f]/u.test(requestedQuery);
const filtersInvalid = categoryInvalid || queryInvalid;
const selectedCollection = collections.find(
  (collection) => collection.value === requestedCategory,
);
const category = selectedCollection?.value ?? "all";
const query = requestedQuery
  .slice(0, 80)
  .replace(/[\u0000-\u001f\u007f]/gu, "");
const search = query.trim().toLowerCase();
const filtersActive = category !== "all" || search.length > 0;

const config = readConfig();
const storefront = await getStorefrontStatus(
  config,
  getCheckoutPresentation().enabled,
);
const testCheckoutEnabled = storefront.checkoutEnabled;
let catalog: Catalog | undefined;
let unavailable = false;
try {
  catalog = await getCatalog(config);
} catch (error) {
  if (!(error instanceof CatalogUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
}
if (filtersInvalid && !unavailable) Astro.response.status = 400;
const products = filtersInvalid
  ? []
  : (catalog?.products.filter((product) => {
      if (category !== "all" && product.category !== category) return false;
      const searchable = [
        product.title,
        product.summary,
        product.category,
        ...product.details,
      ]
        .join(" ")
        .toLowerCase();
      return !search || searchable.includes(search);
    }) ?? []);
---

<SiteLayout
  title="The good-goods collection"
  description="Explore The True Hive's collection, published variant prices and pickup information in Madisonville, Tennessee. Online purchasing is not open yet."
  storefrontStatus={storefront}
>
  <section class="page-intro collection-intro wrap">
    <div>
      <p class="eyebrow">The neighborhood product shelf</p>
      <h1>
        The good-goods
        <br />
        <em>collection.</em>
      </h1>
      <p class="collection-description">
        A little daily ritual. A future pantry favorite. A slower moment at
        home. Get to know what's taking shape.
      </p>
    </div>
    <aside class="collection-aside" aria-label="A note on the collection">
      <span class="collection-flower" aria-hidden="true">
        ✳
      </span>
      <p class="eyebrow">A closer look, at your pace</p>
      <p>
        Browse the ideas, read the details, and see what is a concept and what
        has been confirmed. Published active products show their current prices;
        concepts are not for sale.{" "}
        {storefront.state === "closed"
          ? "Purchases are paused; you can still browse prices and save selections in your cart."
          : testCheckoutEnabled
            ? "TEST MODE only — no real charge. Review saved selections in your cart."
            : "Save selections in your cart; online ordering is not open yet."}
      </p>
    </aside>
  </section>

  <div class="wrap">
    <form class="collection-filters" action="/goods" method="get" role="search">
      <div class="filter-heading">
        <p class="eyebrow">Make yourself at home</p>
        <h2>Find your kind of good.</h2>
      </div>
      <div class="filter-field">
        <label for="collection-category">Collection</label>
        <select
          id="collection-category"
          name="category"
          aria-invalid={categoryInvalid ? "true" : undefined}
          aria-describedby={categoryInvalid ? "filter-error" : undefined}
        >
          {collections.map((collection) => (
            <option
              value={collection.value}
              selected={category === collection.value}
            >
              {collection.label}
            </option>
          ))}
        </select>
      </div>
      <div class="filter-field search-field">
        <label for="collection-query">Search the collection</label>
        <input
          id="collection-query"
          type="search"
          name="q"
          value={query}
          maxlength="80"
          placeholder="Try soap or honey"
          aria-invalid={queryInvalid ? "true" : undefined}
          aria-describedby={
            queryInvalid ? "search-help filter-error" : "search-help"
          }
        />
      </div>
      <button class="button button-primary" type="submit">
        Find goods <span aria-hidden="true">&rarr;</span>
      </button>
      <p id="search-help" class="fine-print filter-help">
        Up to 80 characters. Search product names and descriptions.
      </p>
    </form>
  </div>

  <section
    class="wrap collection-section"
    aria-labelledby="collection-results-title"
  >
    <div class="collection-results-heading">
      <div>
        <p class="eyebrow">
          {filtersActive && !filtersInvalid ? "Your selection" : "Take a look"}
        </p>
        <h2 id="collection-results-title">
          {category === "all"
            ? "On the shelf."
            : `${selectedCollection?.label}.`}
        </h2>
      </div>
      {!unavailable && !filtersInvalid && !!catalog?.products.length && (
        <p class="result-count">
          {products.length} {products.length === 1 ? "product" : "products"}
          {filtersActive ? " matching your selection" : " to explore"}
        </p>
      )}
      {(filtersActive || filtersInvalid) && (
        <a class="text-link filter-reset" href="/goods">
          Clear filters
        </a>
      )}
    </div>
    {filtersInvalid && (
      <div id="filter-error" class="notice filter-error" role="status">
        <h3>Let's try those filters again.</h3>
        {categoryInvalid && (
          <p>
            Choose one collection from the list. The collection in this link
            wasn't recognized or was repeated.
          </p>
        )}
        {queryInvalid && (
          <p>
            {queryTooLong
              ? "The search is longer than 80 characters. Only the first 80 characters are shown in the field; edit and submit them to search."
              : "Use one search field with ordinary text. Repeated search values or control characters cannot be applied; review the field and submit again."}
          </p>
        )}
        <p>
          These filters have not been applied. Choose Find goods to try again,
          or use Clear filters above to start over.
        </p>
      </div>
    )}
    {unavailable ? (
      <div class="notice" role="status">
        <h2>The catalog is temporarily unavailable.</h2>
        <p>
          Product information could not be verified. Please try again later; no
          fictional stock has been substituted.
        </p>
      </div>
    ) : !catalog?.products.length ? (
      <div class="notice">
        <h3>A collection in the making.</h3>
        <p>No products have been published yet.</p>
      </div>
    ) : filtersInvalid ? null : products.length ? (
      <div class="product-shelf">
        {products.map((product) => (
          <ProductCard
            product={product}
            testCheckoutEnabled={testCheckoutEnabled}
          />
        ))}
      </div>
    ) : (
      <div class="notice no-matches" role="status">
        <p class="eyebrow">Room to look again</p>
        <h3>No matches, this time.</h3>
        <p>
          Nothing in the published collection matches
          {search ? <> “{query}”</> : " these filters"}
          {category !== "all"
            ? ` in ${selectedCollection?.label.toLowerCase()}`
            : ""}
          . Try another word or collection, or clear the filters to see all
          goods. This is a search result, not a statement about stock.
        </p>
      </div>
    )}
    <div class="collection-footnote">
      <p class="fine-print collection-note">
        {testCheckoutEnabled
          ? "Original concept illustrations, not final product photographs. Eligible real merchandise may enter a card-only test checkout. No real purchase is available."
          : "Original concept illustrations, not final product photographs. No cart, payment, reservation, or preorder is available."}
      </p>
      <a class="text-link" href="#pickup">
        Local pickup information <span aria-hidden="true">&darr;</span>
      </a>
    </div>
    <div id="pickup" tabindex="-1">
      <PickupLocation />
    </div>
  </section>
</SiteLayout>

<style>
  .collection-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding-block: clamp(3rem, 6vw, 5.5rem) 3rem;
  }
  .collection-intro h1 {
    margin-block: 1.1rem 1.5rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 1.02;
  }
  .collection-description {
    max-width: 34rem;
    font-size: 1.05rem;
  }
  .collection-aside {
    padding: 1.5rem 0 0.25rem 1.5rem;
    border-left: 1px solid var(--line);
  }
  .collection-aside > p:last-child {
    max-width: 24rem;
    margin-top: 0.8rem;
    font-size: 0.88rem;
  }
  .collection-flower {
    display: block;
    margin-bottom: 1rem;
    color: var(--tomato);
    font-size: 3.5rem;
    line-height: 1;
  }
  .collection-filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    gap: 1rem 1.5rem;
    align-items: end;
    padding-block: 1.75rem;
    border-block: 1px solid var(--line);
  }
  .filter-heading h2 {
    margin-top: 0.5rem;
    font-size: 1.65rem;
    letter-spacing: -0.035em;
  }
  .filter-field {
    min-width: 0;
  }
  .filter-field label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .filter-field input,
  .filter-field select {
    width: 100%;
    min-width: 0;
    min-height: 3.1rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--forest);
    border-radius: 0.15rem;
    color: var(--forest);
    background: var(--paper);
    font: inherit;
    font-size: 0.9rem;
  }
  .filter-field input::placeholder {
    color: #62685b;
    opacity: 1;
  }
  .collection-filters button {
    min-height: 3.1rem;
    border-radius: 0.15rem;
    font-family: inherit;
    cursor: pointer;
  }
  .collection-filters :focus-visible {
    outline: 3px solid var(--tomato);
    outline-offset: 4px;
  }
  .filter-help {
    grid-column: 2 / -1;
    margin: 0;
  }
  .collection-section {
    padding-block: 3rem 5rem;
  }
  .collection-results-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .collection-results-heading h2 {
    margin-top: 0.45rem;
    font-size: clamp(2rem, 3vw, 2.8rem);
  }
  .result-count {
    margin: 0 0 0.15rem;
    font-size: 0.8rem;
  }
  .filter-reset {
    margin-left: auto;
  }
  .filter-error {
    margin-bottom: 1.5rem;
  }
  .no-matches {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-left-width: 1px;
    background: transparent;
  }
  .no-matches h3 {
    margin-top: 0.8rem;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }
  .no-matches > p:last-child {
    max-width: 42rem;
  }
  .collection-footnote {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    align-items: start;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .collection-note {
    max-width: 37rem;
    margin: 0;
  }
  @media (max-width: 1000px) {
    .collection-filters {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) auto;
    }
    .filter-heading {
      grid-column: 1 / -1;
    }
    .filter-help {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 700px) {
    .collection-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .collection-aside {
      padding: 0 0 0 1rem;
    }
    .collection-flower {
      display: none;
    }
    .collection-filters {
      grid-template-columns: minmax(0, 1fr);
    }
    .collection-filters button {
      justify-self: start;
    }
    .collection-results-heading {
      gap: 0.75rem 1rem;
    }
    .collection-results-heading > div {
      width: 100%;
    }
    .filter-reset {
      margin-left: 0;
    }
    .collection-section {
      padding-block: 2.5rem 3.5rem;
    }
  }
</style>
