---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import NoticePanel from "../../components/NoticePanel.astro";
import { getCatalog, CatalogUnavailableError } from "../../server/catalog.ts";
import { readConfig } from "../../server/config.ts";
import type { Catalog, ProductCategory } from "../../domain/catalog.ts";
import { prioritizeProducts } from "../../domain/catalog-presentation.ts";
import { pricedVariants, projectedStock } from "../../domain/cart.ts";
import PickupSteps from "../../components/PickupSteps.astro";

const collections: { value: ProductCategory | "all"; label: string }[] = [
  { value: "all", label: "All goods" },
  { value: "soap", label: "Soap" },
  { value: "honey", label: "Honey" },
  { value: "candles", label: "Candles" },
  { value: "gifts", label: "Gifts" },
];
const params = Astro.url.searchParams;
const requestedCategory = params.get("category") ?? "all";
const requestedQuery = params.get("q") ?? "";
const view = params.get("view") ?? "all";
const viewInvalid =
  params.getAll("view").length > 1 ||
  !["all", "in-stock", "seasonal"].includes(view);
const categoryInvalid =
  params.getAll("category").length > 1 ||
  !collections.some((collection) => collection.value === requestedCategory);
const queryTooLong = requestedQuery.length > 80;
const queryInvalid =
  params.getAll("q").length > 1 ||
  queryTooLong ||
  /[\u0000-\u001f\u007f]/u.test(requestedQuery);
const filtersInvalid = categoryInvalid || queryInvalid || viewInvalid;
const selectedCollection = collections.find(
  (collection) => collection.value === requestedCategory,
);
const category = selectedCollection?.value ?? "all";
const query = requestedQuery
  .slice(0, 80)
  .replace(/[\u0000-\u001f\u007f]/gu, "");
const search = query.trim().toLowerCase();
const filtersActive = category !== "all" || search.length > 0 || view !== "all";

const config = readConfig();
let catalog: Catalog | undefined;
let unavailable = false;
try {
  catalog = await getCatalog(config);
} catch (error) {
  if (!(error instanceof CatalogUnavailableError)) throw error;
  unavailable = true;
  Astro.response.status = 503;
}
if (filtersInvalid && !unavailable) Astro.response.status = 400;
const isStockedSoap = (product: Catalog["products"][number]) =>
  product.category === "soap" &&
  pricedVariants(product).some((variant) =>
    ["available", "low_stock"].includes(projectedStock(variant)?.state ?? ""),
  );
const isRadar = (product: Catalog["products"][number]) =>
  product.category !== "soap" ||
  product.kind !== "active" ||
  !pricedVariants(product).some(
    (variant) =>
      !["out_of_stock", "not_offered"].includes(
        projectedStock(variant)?.state ?? "",
      ),
  );
const matching = filtersInvalid
  ? []
  : prioritizeProducts(catalog?.products ?? []).filter((product) => {
      if (category !== "all" && product.category !== category) return false;
      const searchable = [
        product.title,
        product.summary,
        product.category,
        ...product.details,
      ]
        .join(" ")
        .toLowerCase();
      return !search || searchable.includes(search);
    });
const products = matching.filter((product) =>
  view === "in-stock"
    ? isStockedSoap(product)
    : view === "seasonal"
      ? false
      : !isRadar(product),
);
const radar = view === "in-stock" ? [] : matching.filter(isRadar);
const collectionHref = (nextView: string) => {
  const next = new URLSearchParams();
  if (nextView !== "all") next.set("view", nextView);
  if (category !== "all") next.set("category", category);
  if (query) next.set("q", query);
  return `/goods${next.size ? `?${next}` : ""}`;
};
---

<SiteLayout
  title="Shop the collection"
  description="Explore The True Hive's soaps, ingredients and available formats. Local pickup only in Madisonville, Tennessee."
>
  <section class="page-intro collection-intro wrap">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Store</span>
      </nav>
      <p class="eyebrow">
        The True Hive Apothecary / <span>Local Pickup Only</span>
      </p>
      <h1>Small-batch soaps, ready along US-411.</h1>
      <p>
        Everyday bars and sculpted gift molds, with full ingredient transparency
        and current catalog availability.
      </p>
    </div>
    <nav class="collection-pills" aria-label="Apothecary collections">
      {[
        ["all", "All Goods", catalog?.products.length],
        [
          "in-stock",
          "In-Stock Soaps",
          catalog?.products.filter(isStockedSoap).length,
        ],
        [
          "seasonal",
          "Seasonal Radar",
          catalog?.products.filter(isRadar).length,
        ],
      ].map(([key, label, count]) => (
        <a
          class:list={["button", { "button-primary": view === key }]}
          href={collectionHref(String(key))}
          aria-current={view === key ? "page" : undefined}
        >
          {label}
          {count !== undefined ? ` (${count})` : ""}
        </a>
      ))}
    </nav>
  </section>

  <div class="wrap">
    <form class="collection-filters" action="/goods" method="get" role="search">
      {!viewInvalid && view !== "all" && (
        <input type="hidden" name="view" value={view} />
      )}
      <div class="filter-field">
        <label for="collection-category">Collection</label>
        <select
          id="collection-category"
          name="category"
          aria-invalid={categoryInvalid ? "true" : undefined}
          aria-describedby={categoryInvalid ? "filter-error" : undefined}
        >
          {collections.map((collection) => (
            <option
              value={collection.value}
              selected={category === collection.value}
            >
              {collection.label}
            </option>
          ))}
        </select>
      </div>
      <div class="filter-field search-field">
        <label for="collection-query">Search</label>
        <input
          id="collection-query"
          type="search"
          aria-label="Search the collection"
          name="q"
          value={query}
          maxlength="80"
          placeholder="Search products"
          aria-invalid={queryInvalid ? "true" : undefined}
          aria-describedby={
            queryInvalid ? "search-help filter-error" : "search-help"
          }
        />
      </div>
      <button class="button button-primary" type="submit">
        Find goods <span aria-hidden="true">&rarr;</span>
      </button>
      <p id="search-help" class="fine-print filter-help">
        Up to 80 characters. Search product names and descriptions.
      </p>
    </form>
  </div>

  <section
    class="wrap collection-section"
    aria-labelledby="collection-results-title"
  >
    <div class="collection-results-heading">
      <div>
        <h2 id="collection-results-title">
          {category === "all" ? "All goods" : `${selectedCollection?.label}.`}
        </h2>
      </div>
      {!unavailable && !filtersInvalid && !!catalog?.products.length && (
        <p class="result-count">
          {products.length + radar.length}{" "}
          {products.length + radar.length === 1 ? "product" : "products"}
          {filtersActive ? " found" : ""}
        </p>
      )}
      {(filtersActive || filtersInvalid) && (
        <a class="text-link filter-reset" href="/goods">
          Clear filters
        </a>
      )}
    </div>
    {filtersInvalid && (
      <NoticePanel id="filter-error" class="filter-error" role="status">
        <h3>Let's try those filters again.</h3>
        {viewInvalid && (
          <p>
            Choose All Goods, In-Stock Soaps, or Seasonal Radar. Repeated or
            unknown collection views cannot be applied.
          </p>
        )}
        {categoryInvalid && (
          <p>
            Choose one collection from the list. The collection in this link
            wasn't recognized or was repeated.
          </p>
        )}
        {queryInvalid && (
          <p>
            {queryTooLong
              ? "The search is longer than 80 characters. Only the first 80 characters are shown in the field; edit and submit them to search."
              : "Use one search field with ordinary text. Repeated search values or control characters cannot be applied; review the field and submit again."}
          </p>
        )}
        <p>
          These filters have not been applied. Choose Find goods to try again,
          or use Clear filters above to start over.
        </p>
      </NoticePanel>
    )}
    {unavailable ? (
      <NoticePanel role="status">
        <h2>The catalog is temporarily unavailable.</h2>
        <p>Please try again shortly.</p>
      </NoticePanel>
    ) : !catalog?.products.length ? (
      <NoticePanel>
        <h3>No products available.</h3>
        <p>Please check back soon.</p>
      </NoticePanel>
    ) : filtersInvalid ? null : products.length || radar.length ? (
      <>
        <div class="product-shelf">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
        {radar.length > 0 && (
          <section
            class="seasonal-radar"
            data-seasonal-radar
            aria-labelledby="radar-title"
          >
            <p class="eyebrow">Seasonal &amp; next-batch radar</p>
            <h2 id="radar-title">Beyond the everyday bars.</h2>
            <p>
              Read each listing for current availability. A future batch or
              restock is not guaranteed.
            </p>
            <div class="product-shelf">
              {radar.map((product) => (
                <ProductCard product={product} />
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <NoticePanel class="no-matches" role="status">
        <p class="eyebrow">Room to look again</p>
        <h3>No matches, this time.</h3>
        <p>
          Nothing in the published collection matches
          {search ? <> “{query}”</> : " these filters"}
          {category !== "all"
            ? ` in ${selectedCollection?.label.toLowerCase()}`
            : ""}
          . Try another word or collection, or clear the filters to see all
          products.
        </p>
      </NoticePanel>
    )}
  </section>
  <PickupSteps />
</SiteLayout>

<style>
  .collection-intro {
    padding-block: clamp(2rem, 4vw, 3.5rem) 1.25rem;
  }
  .collection-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .collection-pills .button:not(.button-primary) {
    background: var(--white);
    border-color: var(--line);
    color: var(--forest);
  }
  .seasonal-radar {
    margin-top: 2.5rem;
  }
  .collection-intro h1 {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }
  .collection-filters {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.5fr) auto;
    gap: 1rem 1.5rem;
    align-items: end;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .filter-field {
    min-width: 0;
  }
  .filter-field label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .filter-field input,
  .filter-field select {
    width: 100%;
    min-width: 0;
    min-height: 3.1rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--forest);
    border-radius: 0.15rem;
    color: var(--forest);
    background: var(--paper);
    font: inherit;
    font-size: 0.9rem;
  }
  .filter-field input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .collection-filters button {
    min-height: 3.1rem;
    border-radius: 0.15rem;
    font-family: inherit;
    cursor: pointer;
  }
  .collection-filters :focus-visible {
    outline: 3px solid var(--tomato);
    outline-offset: 4px;
  }
  .filter-help {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .collection-section {
    padding-block: 1.5rem 4rem;
  }
  .collection-results-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: end;
    margin-bottom: 1.25rem;
  }
  .collection-results-heading h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .result-count {
    margin: 0 0 0.15rem;
    font-size: 0.8rem;
  }
  .filter-reset {
    margin-left: auto;
  }
  .filter-error {
    margin-bottom: 1.5rem;
  }
  .no-matches {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-left-width: 1px;
    background: transparent;
  }
  .no-matches h3 {
    margin-top: 0.8rem;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }
  .no-matches > p:last-child {
    max-width: 42rem;
  }
  @media (max-width: 700px) {
    .collection-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .collection-filters button {
      grid-column: 1 / -1;
    }
    .collection-filters button {
      justify-self: start;
    }
    .collection-results-heading {
      gap: 0.75rem 1rem;
    }
    .collection-results-heading > div {
      width: 100%;
    }
    .filter-reset {
      margin-left: 0;
    }
    .collection-section {
      padding-block: 2.5rem 3.5rem;
    }
  }
</style>
