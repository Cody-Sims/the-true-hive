---
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Return to your cart"
  description="Review your cart and Stripe test checkout status."
  notFound
>
  <section class="wrap page-intro">
    <p class="eyebrow">Stripe test checkout — no real payment</p>
    <h1>Back to your cart.</h1>
    <p>
      Review your selections and check the status of your test checkout before
      trying again.
    </p>
    <a class="button button-primary" href="/cart">
      View your cart
    </a>
    <a class="text-link" href="/goods">
      Keep shopping
    </a>
  </section>
</SiteLayout>
