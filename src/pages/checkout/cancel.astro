---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ActionLink from "../../components/ActionLink.astro";
---

<SiteLayout
  title="Return to your cart"
  description="Review your cart and Stripe test checkout status."
  notFound
>
  <PageIntro
    class="wrap page-intro"
    eyebrow="Stripe test checkout — no real payment"
    description="Review your selections and check the status of your test checkout before trying again."
  >
    <Fragment slot="heading">Back to your cart.</Fragment>
    <ActionLink class="button button-primary" href="/cart">
      View your cart
    </ActionLink>
    <ActionLink href="/goods">Keep shopping</ActionLink>
  </PageIntro>
</SiteLayout>
