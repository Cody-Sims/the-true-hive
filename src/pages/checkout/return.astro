---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ActionLink from "../../components/ActionLink.astro";
---

<SiteLayout
  title="Back from test checkout"
  description="Return to your cart to check your Stripe test checkout status."
  notFound
>
  <PageIntro
    class="wrap page-intro"
    eyebrow="Stripe test checkout — no real payment"
    description="Return to your cart to check the status of your test checkout before trying again."
  >
    <Fragment slot="heading">Back from test checkout.</Fragment>
    <ActionLink class="button button-primary" href="/cart">
      View your cart
    </ActionLink>
    <ActionLink href="/goods">Keep shopping</ActionLink>
  </PageIntro>
</SiteLayout>
