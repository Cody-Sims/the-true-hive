---
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Back from test checkout"
  description="Return to your cart to check your Stripe test checkout status."
  notFound
>
  <section class="wrap page-intro">
    <p class="eyebrow">Stripe test checkout — no real payment</p>
    <h1>Back from test checkout.</h1>
    <p>
      Return to your cart to check the status of your test checkout before
      trying again.
    </p>
    <a class="button button-primary" href="/cart">
      View your cart
    </a>
    <a class="text-link" href="/goods">
      Keep shopping
    </a>
  </section>
</SiteLayout>
