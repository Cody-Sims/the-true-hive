---
import SiteLayout from "../layouts/SiteLayout.astro";
import ServiceCards from "../components/ServiceCards.astro";
import FaqSection from "../components/FaqSection.astro";
import BeeHelper from "../components/BeeHelper.astro";
import { readConfig } from "../server/config.ts";
const { contact } = readConfig();
---

<SiteLayout
  title="Beekeeping services for home and farm"
  description="No-cost honeybee colony rescue in Monroe, Blount, and Knox counties, plus research-backed farm pollination services from The True Hive."
>
  <section class="wrap services-page" aria-labelledby="services-page-title">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Beekeeping Services</span>
    </nav>
    <div class="services-heading">
      <div>
        <p class="eyebrow">Monroe, Blount &amp; Knox Counties</p>
        <h1 id="services-page-title">
          Free honeybee rescue. Research-backed farm pollination.
        </h1>
        <p>
          Call us directly or check whether it may be a honeybee below. Have
          your location and service details ready.
        </p>
      </div>
      <a class="button button-primary" href={contact.phoneHref}>
        Call {contact.phone}
      </a>
    </div>
    <section id="service-paths" aria-labelledby="services-options-title">
      <h2 id="services-options-title">Beekeeping services</h2>
      <ServiceCards detailed />
    </section>
    <p>
      Prefer email?{" "}
      <a class="text-link" href="/contact#inquiry">
        Prepare a service inquiry
      </a>{" "}
      in your own email app. Review and send the draft there.
    </p>
    <BeeHelper />
  </section>
  <FaqSection topic="services" />
</SiteLayout>

<style>
  .services-page {
    padding-block: 2rem 3rem;
  }
  #services-options-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .breadcrumbs {
    margin-bottom: 1.5rem;
  }
  .services-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .services-heading > div {
    flex: 1 1 100%;
  }
  h1 {
    margin-block: 0.5rem 0.75rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.6;
  }
</style>
