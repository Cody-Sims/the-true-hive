---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ActionLink from "../components/ActionLink.astro";
import { readConfig } from "../server/config.ts";
const { contact } = readConfig();
---

<SiteLayout
  title="Accessibility"
  description="Keyboard navigation, text zoom, reduced motion and accessibility support for The True Hive."
>
  <PageIntro
    eyebrow="Make yourself at home"
    headingId="accessibility-title"
    description="WCAG 2.2 AA is the target for this website. This guidance is not a certification or a promise of universal accessibility across every browser, device, and assistive technology."
  >
    <Fragment slot="heading">
      Accessibility,
      <br />
      <em>at your pace.</em>
    </Fragment>
  </PageIntro>
  <section class="wrap prose-section">
    <h2>Getting around with a keyboard</h2>
    <p>
      Use Tab to move forward through links and controls, and Shift + Tab to
      move back. The first link, “Skip to content,” takes you past the shared
      navigation to the main content when activated with Enter.
    </p>
    <p>
      Collection filters use native controls: choose a category with the arrow
      keys, type in the search field, then activate the “Find goods” button with
      Enter or Space. Links and buttons have visible focus styles to help you
      keep your place.
    </p>
    <h2>Browse without JavaScript</h2>
    <p>
      The public collection, category filters, search, and page navigation work
      without JavaScript. Choose a collection, optionally enter search terms,
      and select “Find goods” to load the results. Use “Clear filters” when it
      appears, or return to the collection to start again.
    </p>
    <ActionLink href="/goods" arrow>
      Browse the collection
    </ActionLink>
    <h2>Text size and reduced motion</h2>
    <p>
      Use your browser's text-size or zoom controls to make the content more
      comfortable to read. Pages are designed to reflow as the available width
      changes rather than requiring a fixed screen size.
    </p>
    <p>
      Your device's reduced-motion preference limits the site's optional
      transitions. No animation is needed to read the collection or use its
      navigation.
    </p>
    <h2>Read the words alongside the artwork</h2>
    <p>
      Product and service information is available as text alongside the
      artwork. Photos include alternative descriptions, and decorative
      illustrations are skipped by screen readers.
    </p>
    <h2>Our approach</h2>
    <p>
      We use automated checks and keyboard and layout reviews to help identify
      issues. These checks do not cover every assistive technology or individual
      need, so feedback is welcome.
    </p>
    <h2>If something gets in your way</h2>
    <p>
      Please call us if you have trouble using the website. Let us know which
      page you were using and what you were trying to do. If you're comfortable
      sharing it, your browser or assistive technology can help us understand
      the issue.
    </p>
    <ActionLink href="/contact" arrow>
      Contact channels
    </ActionLink>
    <ActionLink href={contact.phoneHref} arrow>
      Call {contact.phone}
    </ActionLink>
  </section>
</SiteLayout>
