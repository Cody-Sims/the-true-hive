---
import SiteLayout from "../layouts/SiteLayout.astro";

const nonce = Astro.locals.nonce;

interface Card {
  title: string;
  owner: "Website & office" | "Hands-on";
  summary: string;
  checklist: string[];
  handoff: string;
  done: string;
}

const columns: { id: string; title: string; empty?: string; cards: Card[] }[] =
  [
    {
      id: "ready",
      title: "Ready",
      cards: [
        {
          title: "Make shopping guidance consistent",
          owner: "Website & office",
          summary:
            "Give visitors the same next step across the shopping pages.",
          checklist: [
            "Compare the main actions on the home, collection, and product pages.",
            "Use one next step that matches current ordering availability.",
            "Walk through the pages on a phone and with a keyboard.",
          ],
          handoff:
            "Ask the hands-on lead to confirm the copy matches what customers can expect.",
          done: "All three pages describe the same next step without promising an order that cannot be placed.",
        },
        {
          title: "Verify soap format details",
          owner: "Hands-on",
          summary:
            "Match finished products with their labels before editing listings.",
          checklist: [
            "Match each finished format to its printed label.",
            "Confirm each format's net weight and flag mismatches.",
            "Put the verified format names and label references in one note.",
          ],
          handoff:
            "Send the checked facts to the website lead for Update the soap listings.",
          done: "Each selected format has verified details or is flagged for review.",
        },
        {
          title: "Check which products are ready for review",
          owner: "Hands-on",
          summary: "Separate finished products from future ideas.",
          checklist: [
            "Identify each item as a finished sample, a future concept, or not yet confirmed.",
            "Flag items that still need a label, photo, or approval.",
          ],
          handoff:
            "Share approved customer-facing product status with the website lead.",
          done: "Each reviewed item has a clear status, and unconfirmed items are not shown as available.",
        },
        {
          title: "Take real product photos",
          owner: "Hands-on",
          summary: "Prepare one cleared, labeled photo per selected format.",
          checklist: [
            "Take one clear photo per approved sample in consistent light.",
            "Name each file by format and check it for private details before sharing.",
          ],
          handoff:
            "Send the cleared photos to the website lead for Update the soap listings.",
          done: "The website lead can match each photo to the right format without guessing.",
        },
      ],
    },
    {
      id: "doing",
      title: "Doing",
      empty: "No cards are shown as started.",
      cards: [],
    },
    {
      id: "waiting",
      title: "Waiting",
      cards: [
        {
          title: "Update the soap listings",
          owner: "Website & office",
          summary: "Waiting for confirmed format facts and approved photos.",
          checklist: [
            "Use the verified weights and format names from the hands-on lead.",
            "Pair each format with the matching approved photo.",
            "Switch formats on a phone and check that all three details agree.",
          ],
          handoff:
            "Needs Verify soap format details and Take real product photos. Ask the hands-on lead to confirm the draft.",
          done: "The displayed name, weight, and photo all match the selected format.",
        },
        {
          title: "Write simple pickup instructions",
          owner: "Website & office",
          summary: "Explain when to expect confirmation and whom to contact.",
          checklist: [
            "Confirm the staffed pickup window and when a customer should expect a message.",
            "Say whom to contact if the timing changes.",
            "Keep precise directions out of public copy unless approved.",
          ],
          handoff:
            "Wait for the hands-on lead to check the arrival experience and confirm a workable schedule.",
          done: "A first-time customer knows when to wait, when to travel, and how to reschedule.",
        },
      ],
    },
    {
      id: "review",
      title: "Review",
      empty: "No cards are awaiting review.",
      cards: [],
    },
    {
      id: "done",
      title: "Done",
      empty: "No cards are marked complete in this snapshot.",
      cards: [],
    },
  ];
---

<SiteLayout
  title="Team sprint board"
  description="Read-only snapshot of The True Hive's launch preparation and team handoffs."
  noIndex
>
  <div class="wrap sprint" data-sprint>
    <header class="sprint-intro">
      <p class="eyebrow">First-week pilot</p>
      <h1>Team sprint board</h1>
      <p class="sprint-lede">
        Prepare a consistent soap shelf and a clear local pickup experience.
      </p>
      <p class="snapshot">
        Read-only snapshot. Open a card for its checklist, handoff, and
        completion criteria.
      </p>
    </header>

    <nav class="status-nav" aria-label="Sprint status">
      {columns.map(({ id, title, cards }) => (
        <a href={`#${id}`}>
          {title} <span>{cards.length}</span>
        </a>
      ))}
    </nav>

    <div class="sprint-board">
      {columns.map(({ id, title, empty, cards }) => (
        <section
          class="sprint-column"
          id={id}
          aria-labelledby={`${id}-heading`}
        >
          <div class="column-heading">
            <h2 id={`${id}-heading`}>{title}</h2>
            <span class="column-count" aria-hidden="true">
              {cards.length}
            </span>
          </div>
          {cards.length ? (
            <ul class="task-list" role="list">
              {cards.map((card) => (
                <li>
                  <details class="task-card">
                    <summary>
                      <span
                        class="task-owner"
                        data-field={card.owner === "Hands-on" ? "" : undefined}
                      >
                        {card.owner}
                      </span>
                      <span class="task-title" data-task-title>
                        {card.title}
                      </span>
                      <span class="task-summary">{card.summary}</span>
                      <span class="task-action">
                        View details <span aria-hidden="true">&rarr;</span>
                      </span>
                    </summary>
                    <div class="task-notes">
                      <p class="task-owner">
                        {card.owner} &middot; {title}
                      </p>
                      <h3>Checklist</h3>
                      <ol>
                        {card.checklist.map((step) => (
                          <li>{step}</li>
                        ))}
                      </ol>
                      <h3>Handoff</h3>
                      <p>{card.handoff}</p>
                      <div class="task-done">
                        <h3>Done when</h3>
                        <p>{card.done}</p>
                      </div>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty-note">{empty}</p>
          )}
        </section>
      ))}
    </div>

    <dialog class="task-modal" aria-labelledby="task-modal-title">
      <div class="modal-heading">
        <h2 id="task-modal-title" data-modal-title></h2>
        <form method="dialog">
          <button type="submit" class="modal-close" autofocus>
            Close
          </button>
        </form>
      </div>
      <div data-modal-content></div>
    </dialog>
  </div>
  <script is:inline nonce={nonce}>
    (() => {
      const board = document.querySelector("[data-sprint]");
      if (!board) return;
      const dialog = board.querySelector("dialog");
      if (!dialog || typeof dialog.showModal !== "function") return;
      const title = dialog.querySelector("[data-modal-title]");
      const content = dialog.querySelector("[data-modal-content]");
      if (!title || !content) return;
      let opener = document.activeElement;
      for (const summary of board.querySelectorAll(".task-card > summary")) {
        const label = summary.querySelector("[data-task-title]");
        const notes = summary.nextElementSibling;
        if (!label || !notes) continue;
        summary.setAttribute("aria-haspopup", "dialog");
        summary.addEventListener("click", (event) => {
          event.preventDefault();
          opener = summary;
          title.textContent = label.textContent;
          content.replaceChildren(notes.cloneNode(true));
          dialog.showModal();
          dialog.scrollTop = 0;
        });
      }
      dialog.addEventListener("close", () => {
        content.replaceChildren();
        if (opener instanceof HTMLElement)
          opener.focus({ preventScroll: true });
      });
    })();
  </script>
</SiteLayout>

<style>
  .sprint {
    width: min(100% - 1.5rem, 76rem);
    padding-block: clamp(1.5rem, 4vw, 3.25rem) 3.5rem;
  }
  .sprint-intro {
    max-width: 42rem;
  }
  .sprint-intro h1 {
    margin: 0.3rem 0 0.65rem;
    font: 700 clamp(2.15rem, 6vw, 4rem) / 1.08 var(--font-display);
  }
  .sprint-lede {
    font-size: 1.08rem;
  }
  .snapshot {
    margin-top: 0.6rem;
    color: var(--muted);
  }
  .status-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block: 1.35rem 1rem;
  }
  .status-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--white);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }
  .status-nav a:hover {
    text-decoration: underline;
  }
  .status-nav span,
  .column-count {
    display: inline-grid;
    min-width: 1.5rem;
    min-height: 1.5rem;
    place-items: center;
    border-radius: 50%;
    background: #e4e6d8;
    font-size: 0.77rem;
    font-weight: 700;
  }
  .sprint-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  @media (min-width: 44rem) {
    .sprint-board {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 70rem) {
    .sprint-board {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .sprint-column {
    min-width: 0;
    padding: 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--surface);
  }
  .column-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.2rem 0.25rem 0.65rem;
    border-bottom: 1px solid var(--line);
  }
  .column-heading h2 {
    font: 700 1.15rem / 1.2 var(--font-display);
  }
  .task-list {
    display: grid;
    gap: 0.55rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .task-card {
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--white);
  }
  .task-card summary {
    min-height: 2.75rem;
    padding: 0.75rem;
    border-radius: 0.45rem;
    list-style: none;
    cursor: pointer;
  }
  .task-card summary::-webkit-details-marker {
    display: none;
  }
  .task-card summary:focus-visible {
    outline-offset: -3px;
  }
  .task-title,
  .task-summary,
  .task-action {
    display: block;
    overflow-wrap: anywhere;
  }
  .task-title {
    font: 700 1.1rem / 1.25 var(--font-display);
  }
  .task-summary,
  .empty-note {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .empty-note {
    padding-inline: 0.25rem;
  }
  .task-action {
    margin-top: 0.45rem;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: underline;
  }
  .task-owner {
    margin-bottom: 0.38rem;
    color: #355747;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }
  .task-owner[data-field] {
    color: #734425;
  }
  .task-notes {
    padding: 0.8rem 1rem 1rem;
    border-top: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .task-notes h3 {
    margin-block: 0.9rem 0.35rem;
    font: 700 1.1rem / 1.2 var(--font-display);
  }
  .task-notes ol {
    margin: 0;
    padding-left: 1.3rem;
  }
  .task-notes li + li {
    margin-top: 0.28rem;
  }
  .task-done {
    margin-top: 1rem;
    padding: 0.65rem 0.8rem;
    border-left: 3px solid #aa742e;
    border-radius: 0.25rem;
    background: #f5e9cf;
  }
  .task-done h3 {
    margin-top: 0;
  }
  .task-modal {
    width: min(100% - 1.25rem, 36rem);
    max-height: calc(100vh - 1.25rem);
    max-height: calc(100dvh - 1.25rem);
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    color: var(--forest);
    background: var(--white);
  }
  .task-modal::backdrop {
    background: #172a22ad;
  }
  .modal-heading {
    position: sticky;
    z-index: 1;
    top: 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    background: var(--white);
  }
  .modal-heading h2 {
    font: 700 clamp(1.22rem, 4vw, 1.65rem) / 1.2 var(--font-display);
  }
  .modal-close {
    min-height: 2.75rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--forest);
    border-radius: 0.45rem;
    color: var(--white);
    background: var(--forest);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
</style>
