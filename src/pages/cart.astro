---
import SiteLayout from "../layouts/SiteLayout.astro";
import PickupLocation from "../components/PickupLocation.astro";
import { getCheckoutPresentation } from "../server/commerce/config.ts";
import { readConfig } from "../server/config.ts";
import { getStorefrontStatus } from "../server/storefront.ts";
const paymentReady = getCheckoutPresentation().enabled;
const storefront = await getStorefrontStatus(readConfig(), paymentReady);
---

<SiteLayout
  title="Your cart"
  description="Review your cart, update quantities and find local pickup details."
>
  <section
    class="wrap cart-page"
    data-cart-page
    data-test-enabled={String(storefront.checkoutEnabled)}
  >
    <p class="eyebrow">The True Hive collection</p>
    <h1 data-cart-heading tabindex="-1">
      Your cart.
    </h1>
    <p>Review your items and pickup details.</p>
    <p data-cart-storage role="status"></p>
    <p data-cart-status role="status">
      Loading your saved selections…
    </p>
    <div data-cart-content aria-busy="true">
      <ul class="cart-lines" data-cart-lines aria-label="Saved cart items"></ul>
      <p data-cart-empty hidden>
        Your cart is empty. <a href="/goods">Shop the collection</a> to find
        your favorite.
      </p>
      <p class="cart-subtotal">
        Subtotal: <strong data-cart-subtotal>Not yet verified</strong>
      </p>
      <div class="cart-actions">
        <button type="button" class="button" data-cart-clear disabled>
          Clear cart
        </button>
        <button type="button" class="button" data-cart-refresh>
          Refresh cart
        </button>
        <a class="text-link" href="/goods">
          Keep exploring &rarr;
        </a>
      </div>
    </div>
    <div id="pickup" tabindex="-1">
      <PickupLocation />
    </div>
    {paymentReady ? (
      <section class="cart-checkout" aria-labelledby="cart-checkout-title">
        <h2 id="cart-checkout-title">Stripe test checkout</h2>
        <p>Test mode — no real payment. Tax is not calculated in this test.</p>
        {!storefront.checkoutEnabled && (
          <p>
            Checkout is unavailable. You can still resume an existing test
            checkout.
          </p>
        )}
        <button
          class="button button-primary"
          type="button"
          data-cart-checkout
          disabled
        >
          Continue to TEST checkout
        </button>
        <button class="button" type="button" data-cart-retry hidden>
          Retry the same TEST checkout
        </button>
        <p data-cart-checkout-status role="status" tabindex="-1"></p>
      </section>
    ) : (
      <aside class="cart-checkout" aria-label="Checkout availability">
        <button type="button" class="button button-primary" disabled>
          Checkout unavailable
        </button>
      </aside>
    )}
    <noscript>
      Enable JavaScript to use your cart, or contact us for help.
    </noscript>
  </section>
</SiteLayout>

<style is:global>
  .cart-page {
    max-width: 60rem;
    padding-block: 2rem 5rem;
    overflow-wrap: anywhere;
  }
  .cart-page h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
  }
  .cart-page [hidden] {
    display: none;
  }
  .cart-page .cart-lines {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin-block: 1.5rem;
    list-style: none;
  }
  .cart-page .cart-line {
    padding: 1rem;
    border: 1px solid var(--line);
  }
  .cart-page .cart-line h2 {
    font-size: 1.35rem;
  }
  .cart-page .cart-line form,
  .cart-page .cart-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
    margin-block: 1rem;
  }
  .cart-page .cart-line label {
    display: grid;
    gap: 0.25rem;
  }
  .cart-page .cart-line input {
    width: 6rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    font: inherit;
    background: var(--paper);
    color: var(--forest);
    border: 1px solid var(--forest);
  }
  .cart-page button {
    min-height: 2.75rem;
    max-width: 100%;
    white-space: normal;
    cursor: pointer;
  }
  .cart-page button:not(.button-primary) {
    padding: 0.65rem 1rem;
    border: 1px solid var(--forest);
    border-radius: 0.15rem;
    color: var(--forest);
    background: var(--paper);
    font-weight: 600;
  }
  .cart-page button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .cart-page :focus-visible {
    outline: 3px solid var(--tomato);
    outline-offset: 3px;
  }
  .cart-page .cart-subtotal {
    font-size: 1.35rem;
  }
  .cart-page .cart-issue {
    font-weight: 700;
  }
  .cart-page .cart-checkout {
    padding: 1rem;
    margin-block: 2rem;
    border: 2px solid var(--forest);
  }
</style>
