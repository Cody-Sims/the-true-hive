---
import SiteLayout from "../layouts/SiteLayout.astro";
import PickupLocation from "../components/PickupLocation.astro";
import { getCheckoutPresentation } from "../server/commerce/config.ts";
import { readConfig } from "../server/config.ts";
import { getStorefrontStatus } from "../server/storefront.ts";
const paymentReady = getCheckoutPresentation().enabled;
const storefront = await getStorefrontStatus(readConfig(), paymentReady);
---

<SiteLayout
  title="Your cart"
  description="Review your cart, update quantities and find local pickup details."
>
  <section
    class="wrap cart-page"
    data-cart-page
    data-test-enabled={String(storefront.checkoutEnabled)}
  >
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Cart &amp; Pickup</span>
    </nav>
    <h1 data-cart-heading tabindex="-1">
      Your Cart &amp; US-411 Pickup
    </h1>
    <p>Review your items and pickup details.</p>
    <p data-cart-storage role="status"></p>
    <p data-cart-status role="status">
      Loading your saved selections…
    </p>
    <div
      data-cart-content
      data-golden-cart
      class="cart-layout"
      aria-busy="true"
    >
      <div data-cart-items-column>
        <ul
          class="cart-lines"
          data-cart-lines
          aria-label="Saved cart items"
        ></ul>
        <section data-cart-empty hidden class="cart-empty-panel">
          <h2>Your cart is empty</h2>
          <p>Find your scent and format in the current soap collection.</p>
          <a class="button button-primary" href="/goods?view=in-stock">
            Shop In-Stock Soaps &rarr;
          </a>
        </section>
        <div class="cart-actions">
          <button type="button" class="button" data-cart-clear disabled>
            Clear cart
          </button>
          <button type="button" class="button" data-cart-refresh>
            Refresh cart
          </button>
          <a class="text-link" href="/goods">
            Keep exploring &rarr;
          </a>
        </div>
      </div>
      <aside data-cart-pickup-column>
        <div id="pickup" tabindex="-1">
          <PickupLocation />
        </div>
        <p class="cart-subtotal">
          Subtotal: <strong data-cart-subtotal>Not yet verified</strong>
        </p>
        {paymentReady ? (
          <section class="cart-checkout" aria-labelledby="cart-checkout-title">
            <h2 id="cart-checkout-title">Stripe test checkout</h2>
            <p>
              Test mode — no real payment. Tax is not calculated in this test.
            </p>
            {!storefront.checkoutEnabled && (
              <p>
                Checkout is unavailable. You can still resume an existing test
                checkout.
              </p>
            )}
            <button
              class="button button-primary"
              type="button"
              data-cart-checkout
              disabled
            >
              Continue to TEST checkout
            </button>
            <button class="button" type="button" data-cart-retry hidden>
              Retry the same TEST checkout
            </button>
            <p data-cart-checkout-status role="status" tabindex="-1"></p>
          </section>
        ) : (
          <aside class="cart-checkout" aria-label="Checkout availability">
            <button type="button" class="button button-primary" disabled>
              Checkout unavailable
            </button>
          </aside>
        )}
      </aside>
    </div>
    <noscript>
      Enable JavaScript to use your cart, or contact us for help.
    </noscript>
  </section>
</SiteLayout>

<style is:global>
  .cart-page {
    padding-block: 2rem 5rem;
    overflow-wrap: anywhere;
  }
  .cart-page h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .cart-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
    margin-top: 1.5rem;
  }
  .cart-layout > * {
    min-width: 0;
  }
  [data-cart-pickup-column] {
    padding: 1.25rem;
    border: 1px solid var(--service-border-strong);
    border-radius: 1rem;
    background: var(--white);
  }
  .cart-empty-panel {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--white);
  }
  .cart-empty-panel h2 {
    font-size: 1.25rem;
    margin-bottom: 0.65rem;
  }
  .cart-empty-panel p {
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .cart-page .cart-checkout h2 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  @media (max-width: 700px) {
    .cart-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cart-page [hidden] {
    display: none;
  }
  .cart-page .cart-lines {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin-block: 1.5rem;
    list-style: none;
  }
  .cart-page .cart-lines:empty {
    display: none;
  }
  .cart-page .cart-line {
    padding: 1rem;
    border: 1px solid var(--line);
  }
  .cart-page .cart-line h2 {
    font-size: 1.35rem;
  }
  .cart-page .cart-line form,
  .cart-page .cart-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
    margin-block: 1rem;
  }
  .cart-page .cart-line label {
    display: grid;
    gap: 0.25rem;
  }
  .cart-page .cart-line input {
    width: 6rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    font: inherit;
    background: var(--paper);
    color: var(--forest);
    border: 1px solid var(--forest);
  }
  .cart-page button {
    min-height: 2.75rem;
    max-width: 100%;
    white-space: normal;
    cursor: pointer;
  }
  .cart-page button:not(.button-primary) {
    padding: 0.65rem 1rem;
    border: 1px solid var(--forest);
    border-radius: 0.15rem;
    color: var(--forest);
    background: var(--paper);
    font-weight: 600;
  }
  .cart-page button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .cart-page :focus-visible {
    outline: 3px solid var(--tomato);
    outline-offset: 3px;
  }
  .cart-page .cart-subtotal {
    font-size: 1.35rem;
  }
  .cart-page .cart-issue {
    font-weight: 700;
  }
  .cart-page .cart-checkout {
    padding: 0;
    margin-block: 1rem 0;
    border: 0;
  }
</style>
