---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import LocationWorkspace from "../../../components/admin/LocationWorkspace.astro";
import { listAdminLocations } from "../../../server/admin/catalog.ts";
import { getAdminPool } from "../../../server/admin/pool.ts";
import type { AdminLocation } from "../../../domain/admin.ts";
if (!Astro.locals.admin || !Astro.locals.csrfToken)
  return new Response(null, { status: 403 });
let locations: AdminLocation[] | null = null;
try {
  locations = await listAdminLocations(getAdminPool());
} catch {
  Astro.response.status = 503;
}
---

<AdminLayout title="Locations">
  <a href="#new-location" slot="page-actions">
    Add location
  </a>
  <a href="/inventory/pickups" slot="page-actions">
    Pickup appointments
  </a>
  <LocationWorkspace
    locations={locations}
    selectedKey={Astro.url.searchParams.get("stock") ?? ""}
  />
</AdminLayout>
<script>
  import "../../../client/pickup.ts";
</script>
