---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import LocationForm from "../../../components/admin/LocationForm.astro";
import AdminPickup from "../../../components/pickup/AdminPickup.astro";
import "../../../styles/locations.css";
import ReadState from "../../../components/admin/ReadState.astro";
import { listAdminLocations } from "../../../server/admin/catalog.ts";
import { getAdminPool } from "../../../server/admin/pool.ts";
import { isRecordKey } from "../../../server/inventory/rules.ts";
import type { AdminLocation } from "../../../domain/admin.ts";
if (!Astro.locals.admin || !Astro.locals.csrfToken)
  return new Response(null, { status: 403 });
let location: AdminLocation | null = null;
let unavailable = false;
if (isRecordKey(Astro.params.key)) {
  try {
    location =
      (await listAdminLocations(getAdminPool())).find(
        (item) => item.key === Astro.params.key,
      ) ?? null;
  } catch {
    unavailable = true;
  }
}
if (!location) Astro.response.status = unavailable ? 503 : 404;
---

<AdminLayout title={location ? `Edit ${location.name}` : "Location record"}>
  <a href="/inventory/locations" slot="page-actions">
    Back to locations
  </a>
  {location ? (
    <div class="location-workspace">
      <p class="admin-page-intro">
        This record tracks stored goods, not a customer meetup address. Related
        pickup points below are supplied from this inventory.
      </p>
      <section
        class="admin-record-section"
        aria-label="Inventory location settings"
      >
        <p class="admin-eyebrow">Inventory record</p>
        <LocationForm location={location} />
      </section>
      <section id="pickup-points" class="location-pickup-section">
        <AdminPickup
          view="locations"
          locationKey={location.key}
          fixedLocation
        />
      </section>
    </div>
  ) : (
    <ReadState unavailable={unavailable} missing={!unavailable} />
  )}
</AdminLayout>
<script>
  import "../../../client/pickup.ts";
</script>
