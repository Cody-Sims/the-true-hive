---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ReadState from "../../../components/admin/ReadState.astro";
import InventoryWorkspace from "../../../components/admin/InventoryWorkspace.astro";
import { inventoryQuery } from "../../../components/admin/inventory.ts";
import { AdminError } from "../../../server/admin/errors.ts";
import { listAdminProducts } from "../../../server/admin/catalog.ts";
import { getAdminPool } from "../../../server/admin/pool.ts";
if (!Astro.locals.admin || !Astro.locals.csrfToken)
  return new Response(null, { status: 403 });
const query = inventoryQuery(Astro.url);
let result: Awaited<ReturnType<typeof listAdminProducts>> | null = null;
let invalidFilter = false;
try {
  result = await listAdminProducts(getAdminPool(), query);
} catch (error) {
  invalidFilter = error instanceof AdminError && error.status === 400;
  Astro.response.status = invalidFilter ? 400 : 503;
}
---

<AdminLayout title="Products" compact>
  <nav
    class="admin-actions inventory-entry-actions"
    aria-label="Inventory actions"
  >
    <a href="/inventory/products/new">New product</a>
    <a href="/inventory/locations#new-location">Add location</a>
    <a href="/inventory/locations">Manage locations</a>
  </nav>
  {!result && (
    <form method="get" class="admin-form" role="search">
      <label>
        Search products or SKU (scanner)
        <input
          type="search"
          name="search"
          value={query.search}
          maxlength="160"
        />
      </label>
      <button type="submit">Search</button>
    </form>
  )}
  {invalidFilter ? (
    <p class="admin-notice">
      Choose a listed inventory location.{" "}
      <a href="/inventory/products">Reset inventory filters</a>
    </p>
  ) : !result ? (
    <ReadState unavailable />
  ) : (
    <InventoryWorkspace
      {...result}
      query={query}
      selectedKey={Astro.url.searchParams.get("variant") ?? ""}
    />
  )}
</AdminLayout>
