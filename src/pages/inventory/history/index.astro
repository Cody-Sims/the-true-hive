---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ReadState from "../../../components/admin/ReadState.astro";
import MovementHistory from "../../../components/admin/MovementHistory.astro";
import { pageQuery, pageHref } from "../../../components/admin/presentation.ts";
import { listAdminHistory } from "../../../server/admin/catalog.ts";
import { getAdminPool } from "../../../server/admin/pool.ts";
import { isRecordKey } from "../../../server/inventory/rules.ts";
import type { AdminMovement } from "../../../domain/admin.ts";
if (!Astro.locals.admin || !Astro.locals.csrfToken)
  return new Response(null, { status: 403 });
const { limit, offset } = pageQuery(Astro.url);
const variantKey = isRecordKey(Astro.url.searchParams.get("variantKey"))
  ? Astro.url.searchParams.get("variantKey")!
  : undefined;
const locationKey = isRecordKey(Astro.url.searchParams.get("locationKey"))
  ? Astro.url.searchParams.get("locationKey")!
  : undefined;
let movements: AdminMovement[] | null = null;
try {
  movements = await listAdminHistory(getAdminPool(), {
    limit,
    offset,
    variantKey,
    locationKey,
  });
} catch {
  Astro.response.status = 503;
}
function href(next: number) {
  const url = new URL(pageHref("/inventory/history", next), Astro.url);
  if (variantKey) url.searchParams.set("variantKey", variantKey);
  if (locationKey) url.searchParams.set("locationKey", locationKey);
  return `${url.pathname}${url.search}`;
}
---

<AdminLayout title="Stock history">
  <p>
    Private, append-only counted-stock history. Audit text is displayed as text,
    never rendered as HTML.
  </p>
  <form method="get" class="admin-form">
    <div class="admin-grid">
      <label>
        Variant key (optional){" "}
        <input
          name="variantKey"
          value={variantKey ?? ""}
          pattern="[a-z0-9][a-z0-9-]{0,79}"
          maxlength="80"
        />
      </label>
      <label>
        Location key (optional){" "}
        <input
          name="locationKey"
          value={locationKey ?? ""}
          pattern="[a-z0-9][a-z0-9-]{0,79}"
          maxlength="80"
        />
      </label>
    </div>
    <button type="submit">Filter history</button>
  </form>
  {!movements ? (
    <ReadState unavailable />
  ) : movements.length ? (
    <MovementHistory movements={movements} />
  ) : (
    <ReadState empty="No movements match this view." />
  )}
  <nav class="admin-pagination" aria-label="History pages">
    {offset > 0 && <a href={href(offset - limit)}>Previous page</a>}
    {movements?.length === limit && offset + limit <= 10000 && (
      <a href={href(offset + limit)}>Next page</a>
    )}
  </nav>
</AdminLayout>
