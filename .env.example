SITE_URL=https://thetruehive.com
SITE_INDEXABLE=false
CATALOG_SOURCE=showcase
ASTRO_TELEMETRY_DISABLED=1

# Supply database URLs privately. Migrations should use a schema-owner credential.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_TLS=verify-full
# Optional explicit pickup location for public stock states. No key means no stock display.
STOREFRONT_LOCATION_KEY=

# Optional phone override; blank uses the approved business contact in source.
# Social links appear only when supplied. Inquiry forms open a visitor-owned email draft;
# no SMTP account, provider key, server submission or paid email service is needed.
CONTACT_PHONE=
FACEBOOK_URL=
INSTAGRAM_URL=

# Inventory stays disabled until isolated Firebase/MFA, roles and recovery are ready.
INVENTORY_ENABLED=false
INVENTORY_ORIGIN=https://inventory.thetruehive.com
ADMIN_DATABASE_URL=
ADMIN_CSRF_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Product images: a separate private bucket/principal in the existing billed
# storage project. This can differ from the Firebase Auth project.
PRODUCT_IMAGES_ENABLED=false
PRODUCT_IMAGES_PROJECT_ID=
PRODUCT_IMAGES_BUCKET=
PRODUCT_IMAGES_SERVICE_ACCOUNT_JSON=

# Only card-based Stripe test checkout is implemented; no live keys or charges.
# Default to an isolated sandbox database. The separately owner-approved temporary
# current-site rehearsal uses a dedicated test-stock location, never ordinary stock.
# See the sandbox runbook; keep indexing off and the visible test-store label.
# Use a least-privilege rk_test_ key when possible; sk_test_ remains supported.
CHECKOUT_MODE=disabled
CHECKOUT_LOCATION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Operator-only bootstrap, never a browser environment variable or committed value.
INVENTORY_ADMIN_UID=
