SITE_URL=https://thetruehive.com
SITE_INDEXABLE=false
CATALOG_SOURCE=showcase
ASTRO_TELEMETRY_DISABLED=1

# Supply database URLs privately. Migrations should use a schema-owner credential.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_TLS=verify-full

# Empty until the owner supplies approved public contact values. Email is deferred.
CONTACT_PHONE=
FACEBOOK_URL=
INSTAGRAM_URL=

# Inventory stays disabled until isolated Firebase/MFA, roles and recovery are ready.
INVENTORY_ENABLED=false
INVENTORY_ORIGIN=https://inventory.thetruehive.com
ADMIN_DATABASE_URL=
ADMIN_CSRF_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Only card-based Stripe test checkout is implemented; no live keys or charges.
CHECKOUT_MODE=disabled
CHECKOUT_LOCATION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Operator-only bootstrap, never a browser environment variable or committed value.
INVENTORY_ADMIN_UID=
